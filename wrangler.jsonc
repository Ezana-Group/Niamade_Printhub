{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "printhub-africa",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist"
  },
  "pages_build_output_dir": "./dist",
  // Top-level settings define production
  "vars": {
    "ENVIRONMENT": "production",
    "SANITY_PROJECT_ID": "m7x6icn3",
    "SANITY_DATASET": "production",
    "PUBLIC_CLARITY_PROJECT_ID": "ziney1t17t",
    "PUBLIC_PAYSTACK_KEY": "pk_live_dc267934d2c2b11d8c613d110d6af0d20faf7446"
  },
  // The previews block defines settings used during 'wrangler preview'
  "previews": {
    "vars": {
      "ENVIRONMENT": "preview",
      "SANITY_PROJECT_ID": "m7x6icn3",
      "SANITY_DATASET": "production",
      "PUBLIC_CLARITY_PROJECT_ID": "ziney1t17t",
      "PUBLIC_PAYSTACK_KEY": "pk_live_dc267934d2c2b11d8c613d110d6af0d20faf7446"
    }
  }
}
