---
import { site, occasions } from "../data/site";
import Icon from "./Icon.astro";
---
<footer id="footer" class="on-dark bg-ink text-cream mt-20 border-t border-white/5">
  <div class="max-w-6xl mx-auto px-5 md:px-8 py-12 md:py-14 grid grid-cols-2 md:grid-cols-12 gap-8 md:gap-10 items-start">
    <!-- Brand & Socials -->
    <div class="col-span-2 md:col-span-4">
      <img src="/logo-horizontal-white.png" alt="PrintHub Africa" width="825" height="256" class="h-10 w-auto" loading="lazy" />
      <p class="mt-3.5 text-cream/70 text-sm leading-relaxed max-w-sm">
        Made-to-order 3D printing in Eldoret. Gifts, branded pieces and useful parts, delivered across Kenya.
      </p>
      <ul class="mt-4 flex gap-2" aria-label="Social media">
        {site.socials.map((s) => (
          <li>
            <a
              href={s.href}
              target="_blank"
              rel="noopener"
              aria-label={`${s.label}: ${s.handle}`}
              class="w-8 h-8 rounded-full bg-white/10 grid place-items-center transition-colors duration-150 hover:bg-white/20 active:scale-95 text-cream/80 hover:text-white"
            >
              <Icon name={s.id} size={15} />
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Shop by occasion -->
    <div class="col-span-1 md:col-span-3">
      <h2 class="font-display text-base font-semibold text-white tracking-wide">Shop by occasion</h2>
      <ul class="mt-3 space-y-1.5 text-sm text-cream/70">
        {occasions.map((o) => (
          <li><a href={`/shop/for/${o.slug}/`} class="hover:text-white transition-colors">{o.label}</a></li>
        ))}
      </ul>
    </div>

    <!-- Explore -->
    <div class="col-span-1 md:col-span-2">
      <h2 class="font-display text-base font-semibold text-white tracking-wide">Explore</h2>
      <ul class="mt-3 space-y-1.5 text-sm text-cream/70">
        <li><a href="/shop/" class="hover:text-white transition-colors">Shop</a></li>
        <li><a href="/quoteforge/" class="hover:text-white transition-colors text-brand font-medium">QuoteForge App</a></li>
        <li><a href="/quoteforge/docs/" class="hover:text-white transition-colors text-cream/70">QuoteForge Docs</a></li>
        <li><a href="/for-business/" class="hover:text-white transition-colors">For business</a></li>
        <li><a href="/custom/" class="hover:text-white transition-colors">Custom orders</a></li>
        <li><a href="/bookings/" class="hover:text-white transition-colors text-white font-medium">Bookings</a></li>
        <li><a href="/guides/" class="hover:text-white transition-colors">Helpful guides</a></li>
        <li><a href="/help/" class="hover:text-white transition-colors">Help &amp; FAQs</a></li>
        <li><a href="/about/" class="hover:text-white transition-colors">About us</a></li>
        <li><a href="/contact/" class="hover:text-white transition-colors">Contact</a></li>
      </ul>
    </div>

    <!-- Contact & Hours -->
    <div class="col-span-2 md:col-span-3">
      <h2 class="font-display text-base font-semibold text-white tracking-wide">Say hello</h2>
      <ul class="mt-3 space-y-2 text-sm text-cream/70">
        <li>
          <a href={`tel:${site.phone.replace(/\s/g, "")}`} class="hover:text-white transition-colors font-medium text-cream block">
            {site.phone}
          </a>
        </li>
        <li>
          <a href={`mailto:${site.email}`} class="hover:text-white transition-colors block">
            {site.email}
          </a>
        </li>
        <li class="pt-1 text-cream/90 font-medium">Eldoret, Kenya</li>
        <li class="space-y-0.5 text-xs text-cream/50 leading-normal">
          {site.hours.map((h: string) => <p>{h}</p>)}
        </li>
        <li class="pt-2">
          <a href="/bookings/" class="inline-flex items-center gap-1.5 text-xs text-brand hover:text-white font-semibold transition-colors underline underline-offset-4">
            Book a studio visit or consultation →
          </a>
        </li>
      </ul>
    </div>
  </div>

  <!-- Sub-footer bar -->
  <div class="border-t border-white/10">
    <div class="max-w-6xl mx-auto px-5 md:px-8 py-4 pb-24 md:pb-4 text-xs text-cream/60 flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
      <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1">
        <p>© 2026 Niamade Hub. PrintHub Africa — A Niamade Hub Company.</p>
        <span class="text-white/20 hidden sm:inline">·</span>
        <a href="/privacy/" class="hover:text-white underline underline-offset-4">Privacy Policy</a>
        <span class="text-white/20">·</span>
        <a href="/terms/" class="hover:text-white underline underline-offset-4">Terms of Service</a>
      </div>
      <p>Pay by M-Pesa · Delivery across Kenya</p>
    </div>
  </div>
</footer>
