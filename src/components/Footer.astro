---
import { site, wa, waMessages, occasions } from "../data/site";
import Icon from "./Icon.astro";
---
<footer id="footer" class="on-dark bg-ink text-cream mt-24">
  <div class="wrap pt-16 pb-10 grid gap-12 md:grid-cols-12">
    <div class="md:col-span-5">
      <img src="/logo-horizontal-white.png" alt="PrintHub Africa" width="825" height="256" class="h-14 w-auto" loading="lazy" />
      <p class="mt-5 text-cream/75 max-w-sm">Made-to-order 3D printing in Eldoret. Gifts, branded pieces and useful parts, delivered across Kenya.</p>
      <div class="mt-6 pt-5 border-t border-white/10 max-w-sm">
        <p class="font-bold text-xs uppercase tracking-[0.14em] text-cream">Niamade Hub</p>
        <p class="text-sm text-cream/75 mt-1">PrintHub Africa is a trading brand operated by Niamade Hub.</p>
      </div>
      <a href={wa(waMessages.general)} target="_blank" rel="noopener" class="btn btn-wa mt-6"><Icon name="whatsapp" size={18} />Chat on WhatsApp</a>
      <ul class="mt-7 flex gap-3" aria-label="Social media">
        {site.socials.map((s) => <li><a href={s.href} target="_blank" rel="noopener" aria-label={`${s.label}: ${s.handle}`} class="w-11 h-11 rounded-full bg-white/10 grid place-items-center transition-[background-color,transform] duration-150 hover:bg-white/20 active:scale-95"><Icon name={s.id} size={20} /></a></li>)}
      </ul>
    </div>
    <div class="md:col-span-3">
      <h2 class="font-display text-xl">Shop by occasion</h2>
      <ul class="mt-4 space-y-2.5 text-cream/75">
        {occasions.map((o) => <li><a href={`/shop/?for=${o.id}`} class="hover:text-white">{o.label}</a></li>)}
      </ul>
    </div>
    <div class="md:col-span-2">
      <h2 class="font-display text-xl">Explore</h2>
      <ul class="mt-4 space-y-2.5 text-cream/75">
        <li><a href="/shop/" class="hover:text-white">Shop</a></li>
        <li><a href="/for-business/" class="hover:text-white">For business</a></li>
        <li><a href="/custom/" class="hover:text-white">Custom orders</a></li>
        <li><a href="/help/" class="hover:text-white">Help &amp; FAQs</a></li>
        <li><a href="/about/" class="hover:text-white">About us</a></li>
        <li><a href="/contact/" class="hover:text-white">Contact</a></li>
        <li><a href="/terms/" class="hover:text-white">Terms of service</a></li>
        <li><a href="/privacy/" class="hover:text-white">Privacy policy</a></li>
      </ul>
    </div>
    <div class="md:col-span-2">
      <h2 class="font-display text-xl">Say hello</h2>
      <ul class="mt-4 space-y-2.5 text-cream/75">
        <li><a href={`tel:${site.phone.replace(/\s/g, "")}`} class="hover:text-white">{site.phone}</a></li>
        <li><a href={`mailto:${site.email}`} class="hover:text-white break-all">{site.email}</a></li>
        <li>Eldoret, Kenya</li>
        {site.hours.map((h) => <li class="text-cream/60 text-[0.95rem]">{h}</li>)}
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="wrap pt-6 pb-24 md:pb-6 text-sm text-cream/60 flex flex-wrap items-center justify-between gap-x-8 gap-y-3">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
        <p>© 2026 Niamade Hub. All rights reserved. PrintHub Africa — A Niamade Hub Company.</p>
        <span class="text-white/20 hidden sm:inline">·</span>
        <a href="/privacy/" class="hover:text-white underline underline-offset-4">Privacy Policy</a>
        <span class="text-white/20">·</span>
        <a href="/terms/" class="hover:text-white underline underline-offset-4">Terms of Service</a>
      </div>
      <p>Pay by M-Pesa · Delivery across Kenya</p>
    </div>
  </div>
</footer>
