---
/**
 * CheckoutModal.astro
 * Apple-grade interactive Checkout Sheet / Dialog for PrintHub Africa.
 * Mobile (<640px): Interactive bottom sheet with 1:1 finger tracking, rubber-banding,
 * velocity projection, and interruptible spring physics.
 * Desktop: Spatial dialog materializing from the trigger button.
 */
interface Props {
  paystackKey: string;
  mpesaTill?: string;
  mpesaPaybill?: string;
  mpesaAccount?: string;
  mpesaBusinessName?: string;
  whatsapp?: string;
}
const {
  paystackKey,
  mpesaTill = "",
  mpesaPaybill = "",
  mpesaAccount = "",
  mpesaBusinessName = "NIAMADE HUB",
  whatsapp = "254792732929",
} = Astro.props;
---

<!-- Checkout Modal Overlay -->
<div
  id="checkout-modal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="checkout-title"
  data-paystack-key={paystackKey}
  data-mpesa-till={mpesaTill}
  data-mpesa-paybill={mpesaPaybill}
  data-mpesa-account={mpesaAccount}
  data-mpesa-business={mpesaBusinessName}
  data-whatsapp={whatsapp}
  class="fixed inset-0 z-[200] flex items-end sm:items-center justify-center p-0 sm:p-4 touch-none"
  style="display:none!important"
>
  <!-- Backdrop / Scrim -->
  <div id="checkout-backdrop" class="absolute inset-0 bg-ink/50 backdrop-blur-sm transition-opacity" aria-hidden="true"></div>

  <!-- Panel -->
  <div
    id="checkout-panel"
    class="relative w-full sm:max-w-lg bg-cream rounded-t-4xl sm:rounded-5xl shadow-2xl overflow-y-auto max-h-[92dvh] sm:max-h-[90vh] will-change-transform"
  >
    <!-- Grab handle for mobile bottom sheet -->
    <div id="checkout-drag-handle" class="sm:hidden pt-3 pb-1 flex justify-center cursor-grab active:cursor-grabbing touch-none select-none">
      <span class="w-12 h-1.5 rounded-full bg-ink/20"></span>
    </div>

    <!-- Header -->
    <div class="sticky top-0 bg-cream/95 backdrop-blur-sm flex items-center justify-between px-6 py-4 border-b border-line z-10">
      <div>
        <h2 id="checkout-title" class="font-display text-xl font-semibold">Complete your order</h2>
        <p id="checkout-product-label" class="text-sm text-mute mt-0.5"></p>
      </div>
      <button
        id="checkout-close"
        type="button"
        aria-label="Close checkout"
        class="w-9 h-9 rounded-full hover:bg-sand flex items-center justify-center transition-colors text-mute"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <!-- Form -->
    <form id="checkout-form" class="px-6 py-5 space-y-4" novalidate>
      <!-- Order details (read-only summary) -->
      <div id="order-detail-block" class="rounded-3xl bg-sand/70 p-4 text-sm space-y-1.5"></div>

      <hr class="border-line" />

      <!-- Customer details -->
      <div>
        <label class="block text-sm font-bold mb-1" for="co-name">Your name <span class="text-brand">*</span></label>
        <input
          type="text"
          id="co-name"
          name="name"
          autocomplete="name"
          required
          placeholder="e.g. Amina Waweru"
          class="w-full rounded-2xl border border-line bg-white px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand"
        />
      </div>

      <div>
        <label class="block text-sm font-bold mb-1" for="co-email">Email address <span class="text-brand">*</span></label>
        <input
          type="email"
          id="co-email"
          name="email"
          autocomplete="email"
          required
          placeholder="e.g. amina@example.com"
          class="w-full rounded-2xl border border-line bg-white px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand"
        />
        <p class="mt-1 text-xs text-mute">Your Paystack receipt will be sent here.</p>
      </div>

      <div>
        <label class="block text-sm font-bold mb-1" for="co-phone">Phone number <span class="text-brand">*</span></label>
        <input
          type="tel"
          id="co-phone"
          name="phone"
          autocomplete="tel"
          required
          placeholder="e.g. 0712 345 678"
          class="w-full rounded-2xl border border-line bg-white px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand"
        />
        <p class="mt-1 text-xs text-mute">For M-Pesa STK Push — your phone will prompt you to enter your PIN.</p>
      </div>

      <div>
        <label class="block text-sm font-bold mb-1" for="co-delivery">Delivery Town / Collection</label>
        <input
          type="text"
          id="co-delivery"
          name="delivery"
          placeholder="e.g. Nairobi, Mombasa, or Free collection in Eldoret"
          class="w-full rounded-2xl border border-line bg-white px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand"
        />
        <p class="mt-1 text-xs text-mute">Courier across Kenya charged at cost, or free pickup in Eldoret.</p>
      </div>

      <div>
        <label class="block text-sm font-bold mb-1" for="co-qty">Quantity</label>
        <input
          type="number"
          id="co-qty"
          name="qty"
          min="1"
          max="50"
          value="1"
          class="w-32 rounded-2xl border border-line bg-white px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand"
        />
      </div>

      <div id="co-custom-row" style="display:none">
        <label class="block text-sm font-bold mb-1" for="co-custom">Customisation / special note</label>
        <input
          type="text"
          id="co-custom"
          name="custom"
          placeholder="e.g. Add 'Happy Birthday Mum' in script font"
          class="w-full rounded-2xl border border-line bg-white px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand"
        />
      </div>

      <!-- Total -->
      <div class="rounded-3xl bg-brand/8 border border-brand/20 p-4 flex items-center justify-between">
        <span class="font-bold text-sm">Total</span>
        <span class="font-display text-2xl font-semibold text-brand" id="co-total">—</span>
      </div>

      <!-- Payment note -->
      <p class="text-xs text-mute text-center leading-relaxed">
        Payments processed securely by <strong>Paystack</strong>. Accepts <strong>M-Pesa</strong> and credit/debit cards. PrintHub never sees your card details.
      </p>

      <!-- Error -->
      <p id="co-error" class="text-sm text-red-600 font-medium hidden"></p>

      <!-- Submit -->
      <button
        type="submit"
        id="co-submit"
        class="btn w-full !bg-brand !text-cream hover:!bg-brand/90 font-bold text-base py-3 disabled:opacity-60 disabled:cursor-not-allowed flex items-center justify-center gap-2"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
        Pay securely with Paystack
      </button>

      <!-- Manual M-Pesa fallback (shown only when till/paybill configured in Sanity) -->
      <div id="co-manual-mpesa" class="hidden">
        <div class="relative flex items-center gap-3 my-1">
          <div class="flex-1 border-t border-line"></div>
          <span class="text-xs text-mute font-medium">or pay manually</span>
          <div class="flex-1 border-t border-line"></div>
        </div>

        <!-- Collapsible trigger -->
        <button
          type="button"
          id="co-manual-toggle"
          class="w-full flex items-center justify-between px-4 py-3 rounded-2xl bg-sand border border-line text-sm font-semibold hover:bg-sand/80 transition-colors"
          aria-expanded="false"
          aria-controls="co-manual-panel"
        >
          <span class="flex items-center gap-2">
            <svg class="w-5 h-5 text-green-600 shrink-0" viewBox="0 0 24 24" fill="currentColor"><path d="M11 15H6l7-14v8h5l-7 14v-8z"/></svg>
            Pay via M-Pesa (Till / Paybill)
          </span>
          <svg id="co-manual-chevron" class="w-4 h-4 text-mute transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
        </button>

        <!-- Collapsible panel -->
        <div id="co-manual-panel" class="hidden mt-2 rounded-2xl border border-line bg-white overflow-hidden text-sm">
          <!-- Till -->
          <div id="co-till-section" class="hidden p-4 border-b border-line">
            <p class="font-bold text-ink mb-2">M-Pesa Buy Goods (Till)</p>
            <div class="space-y-1.5 text-sm">
              <div class="flex justify-between">
                <span class="text-mute">Till Number</span>
                <span class="font-mono font-bold" id="co-till-num"></span>
              </div>
              <div class="flex justify-between">
                <span class="text-mute">Business Name</span>
                <span class="font-semibold" id="co-till-name"></span>
              </div>
              <div class="flex justify-between">
                <span class="text-mute">Amount</span>
                <span class="font-bold text-brand" id="co-till-amount"></span>
              </div>
            </div>
          </div>
          <!-- Paybill -->
          <div id="co-paybill-section" class="hidden p-4 border-b border-line">
            <p class="font-bold text-ink mb-2">M-Pesa Paybill</p>
            <div class="space-y-1.5 text-sm">
              <div class="flex justify-between">
                <span class="text-mute">Paybill Number</span>
                <span class="font-mono font-bold" id="co-paybill-num"></span>
              </div>
              <div id="co-account-row" class="hidden flex justify-between">
                <span class="text-mute">Account</span>
                <span class="font-semibold" id="co-paybill-account"></span>
              </div>
              <div class="flex justify-between">
                <span class="text-mute">Amount</span>
                <span class="font-bold text-brand" id="co-paybill-amount"></span>
              </div>
            </div>
          </div>
          <!-- Instructions -->
          <div class="p-4 bg-sand/40">
            <p class="font-semibold mb-2 text-ink">After paying:</p>
            <p class="text-mute text-xs leading-relaxed">Send your M-Pesa confirmation SMS code to us on WhatsApp and we'll confirm your order manually.</p>
            <a
              id="co-manual-wa"
              href="#"
              target="_blank"
              rel="noopener"
              class="mt-3 flex items-center justify-center gap-2 w-full rounded-xl bg-green-500 hover:bg-green-600 text-white font-semibold py-2.5 px-4 transition-colors text-sm"
            >
              <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              Send receipt on WhatsApp
            </a>
          </div>
        </div>
      </div>
    </form>
  </div>
</div>

<script>
  import { initCheckoutSheet } from "../lib/sheet.js";

  // ── State ────────────────────────────────────────────────────────────────────
  let orderCtx = {
    productName: "",
    productSlug: "",
    unitPriceKes: 0,
    size: "",
    colour: "",
    hasCustom: false,
  };

  // ── Helpers ──────────────────────────────────────────────────────────────────
  function el(id: string) { return document.getElementById(id); }

  function getTotal() {
    const qtyInput = el("co-qty") as HTMLInputElement | null;
    const qty = parseInt(qtyInput?.value || "1", 10);
    return orderCtx.unitPriceKes * Math.max(1, qty);
  }

  function updateTotal() {
    const total = getTotal();
    const qtyInput = el("co-qty") as HTMLInputElement | null;
    const qty = parseInt(qtyInput?.value || "1", 10);
    const totalEl = el("co-total");
    if (totalEl) {
      totalEl.textContent = total > 0
        ? `KES ${(total).toLocaleString()}`
        : "—";
    }
    renderDetailBlock(qty);
    updateManualAmounts();
  }

  function renderDetailBlock(qty: number) {
    const ctx = orderCtx;
    const lines = [
      ["Product", ctx.productName],
      ctx.size ? ["Size", ctx.size] : null,
      ctx.colour ? ["Colour", ctx.colour] : null,
      ["Quantity", qty || 1],
      ctx.unitPriceKes ? ["Unit price", `KES ${ctx.unitPriceKes.toLocaleString()}`] : null,
    ].filter(Boolean) as [string, string | number][];

    const block = el("order-detail-block");
    if (block) {
      block.innerHTML = lines
        .map(([k, v]) => `<div class="flex justify-between gap-4"><span class="text-mute">${k}</span><span class="font-semibold">${v}</span></div>`)
        .join("");
    }
  }

  const modalEl = el("checkout-modal");
  const backdropEl = el("checkout-backdrop");
  const panelEl = el("checkout-panel");
  const dragHandleEl = el("checkout-drag-handle");
  const closeBtnEl = el("checkout-close");
  const paystackKey = modalEl?.getAttribute("data-paystack-key") || "";
  const mpesaTill     = modalEl?.getAttribute("data-mpesa-till") || "";
  const mpesaPaybill  = modalEl?.getAttribute("data-mpesa-paybill") || "";
  const mpesaAccount  = modalEl?.getAttribute("data-mpesa-account") || "";
  const mpesaBusiness = modalEl?.getAttribute("data-mpesa-business") || "NIAMADE HUB";
  const whatsappNum   = modalEl?.getAttribute("data-whatsapp") || "254792732929";

  // ── Manual M-Pesa fallback setup ─────────────────────────────────────────────
  const hasManualMpesa = mpesaTill || mpesaPaybill;
  const manualSection  = el("co-manual-mpesa");
  const toggleBtn      = el("co-manual-toggle");
  const panel          = el("co-manual-panel");
  const chevron        = el("co-manual-chevron");

  if (hasManualMpesa && manualSection) {
    manualSection.classList.remove("hidden");

    // Populate Till section
    if (mpesaTill) {
      el("co-till-section")?.classList.remove("hidden");
      const tn = el("co-till-num");   if (tn) tn.textContent = mpesaTill;
      const tb = el("co-till-name");  if (tb) tb.textContent = mpesaBusiness;
    }

    // Populate Paybill section
    if (mpesaPaybill) {
      el("co-paybill-section")?.classList.remove("hidden");
      const pn = el("co-paybill-num"); if (pn) pn.textContent = mpesaPaybill;
      if (mpesaAccount) {
        el("co-account-row")?.classList.remove("hidden");
        const pa = el("co-paybill-account"); if (pa) pa.textContent = mpesaAccount;
      }
    }

    // Toggle collapse
    toggleBtn?.addEventListener("click", () => {
      const isOpen = panel?.classList.toggle("hidden") === false;
      toggleBtn.setAttribute("aria-expanded", String(isOpen));
      chevron?.classList.toggle("rotate-180", isOpen);
      updateManualAmounts();
    });
  }

  function updateManualAmounts() {
    const kes = getTotal();
    const fmt = kes > 0 ? `KES ${kes.toLocaleString()}` : "—";
    const ta = el("co-till-amount");    if (ta) ta.textContent = fmt;
    const pa = el("co-paybill-amount"); if (pa) pa.textContent = fmt;

    // Update WhatsApp link with current order details
    const waLink = el("co-manual-wa") as HTMLAnchorElement | null;
    if (waLink) {
      const text = encodeURIComponent(
        `Hi PrintHub! I paid for my order via M-Pesa.\n\nProduct: ${orderCtx.productName}\nAmount: ${fmt}\n\n[Paste your M-Pesa confirmation SMS code here]`
      );
      waLink.href = `https://wa.me/${whatsappNum}?text=${text}`;
    }
  }

  let sheetController: ReturnType<typeof initCheckoutSheet> | null = null;
  if (modalEl && backdropEl && panelEl) {
    sheetController = initCheckoutSheet({
      modalEl,
      backdropEl,
      panelEl,
      dragHandleEl,
      closeBtnEl,
      onOpen: () => {
        const nameInput = el("co-name");
        setTimeout(() => nameInput?.focus(), 150);
      },
    });
  }

  // ── Open / close ─────────────────────────────────────────────────────────────
  function openModal(ctx: any, triggerEl: HTMLElement | null = null) {
    orderCtx = { ...orderCtx, ...ctx };
    const label = el("checkout-product-label");
    if (label) label.textContent = ctx.productName || "";
    const qtyInput = el("co-qty") as HTMLInputElement | null;
    if (qtyInput) qtyInput.value = "1";
    el("co-error")?.classList.add("hidden");
    const customRow = el("co-custom-row");
    if (customRow) customRow.style.display = ctx.hasCustom ? "block" : "none";
    // Collapse manual panel on open
    panel?.classList.add("hidden");
    chevron?.classList.remove("rotate-180");
    toggleBtn?.setAttribute("aria-expanded", "false");
    updateTotal();
    updateManualAmounts();

    if (sheetController) {
      sheetController.open(triggerEl);
    }
  }

  function closeModal() {
    if (sheetController) {
      sheetController.close();
    }
  }

  // ── Paystack popup ────────────────────────────────────────────────────────────
  function launchPaystack(formData: FormData) {
    const totalKobo = getTotal() * 100;
    const orderRef = "PH-ORD-" + Date.now() + "-" + Math.random().toString(36).substr(2, 4).toUpperCase();
    const paystackRef = "PHB-" + Date.now() + "-" + Math.random().toString(36).substr(2, 5).toUpperCase();

    const qtyInput = el("co-qty") as HTMLInputElement | null;
    const customInput = el("co-custom") as HTMLInputElement | null;
    const customerName = (formData.get("name") as string) || "";
    const customerPhone = (formData.get("phone") as string) || "";
    const deliveryVal = (formData.get("delivery") as string) || "Standard Delivery / Eldoret";
    const customNoteVal = customInput?.value || "";
    const qtyVal = qtyInput?.value || "1";

    // Top-level metadata keys are what /api/paystack webhook reads from data.metadata.*
    const metadata = {
      orderRef,
      name: customerName,
      phone: customerPhone,
      productName: orderCtx.productName,
      productSlug: orderCtx.productSlug || "",
      size: orderCtx.size || "",
      colour: orderCtx.colour || "",
      quantity: qtyVal,
      custom_note: customNoteVal,
      delivery: deliveryVal,
      // Also include pretty custom_fields for the Paystack dashboard view
      custom_fields: [
        { display_name: "Order Ref",   variable_name: "orderRef",     value: orderRef },
        { display_name: "Product",     variable_name: "product",      value: orderCtx.productName },
        { display_name: "Size",        variable_name: "size",         value: orderCtx.size || "N/A" },
        { display_name: "Colour",      variable_name: "colour",       value: orderCtx.colour || "N/A" },
        { display_name: "Quantity",    variable_name: "quantity",     value: qtyVal },
        { display_name: "Delivery",    variable_name: "delivery",     value: deliveryVal },
        { display_name: "Custom Note", variable_name: "custom_note",  value: customNoteVal || "None" },
        { display_name: "Phone",       variable_name: "phone",        value: customerPhone },
      ],
    };

    const handler = (window as any).PaystackPop.setup({
      key: paystackKey,
      email: formData.get("email"),
      amount: totalKobo,
      currency: "KES",
      ref: paystackRef,
      firstname: customerName.split(" ")[0],
      lastname: customerName.split(" ").slice(1).join(" ") || "",
      phone: customerPhone,
      metadata,
      label: `PrintHub Africa – ${orderCtx.productName}`,

      onClose: function () {
        const btn = el("co-submit") as HTMLButtonElement | null;
        if (btn) {
          btn.disabled = false;
          btn.innerHTML = `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>Pay securely with Paystack`;
        }
        const errEl = el("co-error");
        if (errEl) {
          errEl.textContent = "Payment was cancelled. Try again when you're ready.";
          errEl.classList.remove("hidden");
        }
      },

      callback: function (response: any) {
        closeModal();
        const waText = encodeURIComponent(
          `🛍️ NEW PAID ORDER — PrintHub Africa\n\nRef: ${orderRef}\nProduct: ${orderCtx.productName}\nSize: ${metadata.size || "N/A"}\nColour: ${metadata.colour || "N/A"}\nQty: ${qtyVal}\nDelivery: ${deliveryVal}\nCustom: ${customNoteVal || "None"}\n\nCustomer: ${customerName}\nEmail: ${formData.get("email")}\nPhone: ${customerPhone}\n\nAmount: KES ${(totalKobo / 100).toLocaleString()}\nPaystack Ref: ${response.reference}\nStatus: ✅ PAID (M-Pesa / Card)`
        );
        window.open(`https://wa.me/254792732929?text=${waText}`, "_blank");

        const params = new URLSearchParams({
          product: orderCtx.productName,
          ref: orderRef,
          paystackRef: response.reference,
          name: customerName,
          qty: qtyVal,
          size: metadata.size || "",
          colour: metadata.colour || "",
          delivery: deliveryVal,
          amount: (totalKobo / 100).toString(),
        });
        window.location.href = `/order-confirmed/?${params.toString()}`;
      },
    });
    handler.openIframe();
  }

  function loadPaystackScript() {
    return new Promise<void>((resolve, reject) => {
      if ((window as any).PaystackPop) { resolve(); return; }
      const s = document.createElement("script");
      s.src = "https://js.paystack.co/v1/inline.js";
      s.onload = () => resolve();
      s.onerror = reject;
      document.head.appendChild(s);
    });
  }

  // ── Form submit ───────────────────────────────────────────────────────────────
  el("checkout-form")?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const data = new FormData(form);
    const errEl = el("co-error");
    if (errEl) errEl.classList.add("hidden");

    if (!data.get("name")?.toString().trim()) {
      if (errEl) { errEl.textContent = "Please enter your name."; errEl.classList.remove("hidden"); }
      return;
    }
    if (!data.get("email")?.toString().includes("@")) {
      if (errEl) { errEl.textContent = "Please enter a valid email address."; errEl.classList.remove("hidden"); }
      return;
    }
    if (!data.get("phone")?.toString().trim()) {
      if (errEl) { errEl.textContent = "Please enter your phone number."; errEl.classList.remove("hidden"); }
      return;
    }
    if (getTotal() <= 0) {
      if (errEl) { errEl.textContent = "This product has a price that must be quoted — please use WhatsApp to order."; errEl.classList.remove("hidden"); }
      return;
    }

    const btn = el("co-submit") as HTMLButtonElement | null;

    if (!paystackKey || typeof paystackKey !== 'string' || !paystackKey.startsWith("pk_")) {
      const qtyInput = el("co-qty") as HTMLInputElement | null;
      const customInput = el("co-custom") as HTMLInputElement | null;
      const waOrderText = encodeURIComponent(
        `🛍️ NEW DIRECT ORDER — PrintHub Africa\n\nProduct: ${orderCtx.productName}\nSize: ${orderCtx.size || "Standard"}\nColour: ${orderCtx.colour || "Standard"}\nQuantity: ${qtyInput?.value || 1}\nDelivery: ${data.get("delivery") || "Standard"}\n${orderCtx.hasCustom ? `Customization: ${customInput?.value || "None"}\n` : ""}Total: KES ${getTotal().toLocaleString()}\n\nCustomer: ${data.get("name")}\nPhone: ${data.get("phone")}\nEmail: ${data.get("email")}\n\nI would like to complete this order and pay via M-Pesa.`
      );
      window.open(`https://wa.me/254792732929?text=${waOrderText}`, "_blank");
      closeModal();
      return;
    }

    if (btn) {
      btn.disabled = true;
      btn.innerHTML = `<svg class="animate-spin w-5 h-5" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg> Loading payment...`;
    }

    try {
      await loadPaystackScript();
      launchPaystack(data);
    } catch {
      if (btn) {
        btn.disabled = false;
        btn.innerHTML = `<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>Pay securely with Paystack`;
      }
      if (errEl) {
        errEl.textContent = "Could not load payment system. Please check your connection and try again, or use WhatsApp.";
        errEl.classList.remove("hidden");
      }
    }
  });

  el("co-qty")?.addEventListener("input", updateTotal);

  // Global API
  (window as any).__phbCheckout = { open: openModal, close: closeModal };
</script>
