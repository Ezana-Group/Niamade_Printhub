---
import { art, palettes } from "../data/art";
const { slug, cat, class: cls = "", reveal = false, delay = "0ms" } = Astro.props;
const pal = palettes[cat] ?? palettes["Gifts"];
const svg = art[slug] ?? "";
---
<div
  class:list={["art relative w-full aspect-square overflow-hidden", reveal && "art-printed-reveal", cls]}
  style={`--bg:${pal.bg};--a:${pal.a};--b:${pal.b};--c:${pal.c};--art-d:${delay};background:${pal.bg};aspect-ratio:1/1;`}
>
  <svg viewBox="0 0 200 200" class="absolute inset-0 w-full h-full" role="img" aria-hidden="true" focusable="false">
    <g set:html={svg} />
    <g class="tex" set:html={svg} />
  </svg>
</div>
