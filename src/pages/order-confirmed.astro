---
import Layout from "../layouts/Layout.astro";
import { site, wa } from "../data/site";
---
<Layout
  title="Order Confirmed"
  description="Your PrintHub Africa order has been placed and paid. We will begin printing soon."
  robots="noindex, nofollow"
>
  <section class="wrap pt-16 pb-24 text-center">
    <div class="mx-auto max-w-lg">
      <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-green-100 mb-6">
        <svg class="w-10 h-10 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
        </svg>
      </div>
      <h1 class="text-4xl md:text-5xl">Payment received! 🎉</h1>
      <p class="mt-4 text-xl text-mute" id="confirm-product">Your order is on its way to our print queue.</p>
      <p class="mt-3 text-mute text-sm" id="confirm-ref"></p>

      <div class="mt-10 panel p-7 text-left space-y-4" id="order-summary" style="display:none">
        <h2 class="font-display text-2xl font-semibold">Order summary</h2>
        <dl class="divide-y divide-line" id="summary-rows"></dl>
      </div>

      <div class="mt-10 rounded-3xl bg-sky p-7 text-left">
        <h2 class="font-display text-xl font-semibold">What happens next?</h2>
        <ol class="mt-4 space-y-3 text-sm text-ink/80">
          <li class="flex gap-3"><span class="flex-shrink-0 w-6 h-6 rounded-full bg-brand/10 text-brand text-xs font-bold flex items-center justify-center">1</span>We confirm payment and add your order to the print queue (usually within 1 hour).</li>
          <li class="flex gap-3"><span class="flex-shrink-0 w-6 h-6 rounded-full bg-brand/10 text-brand text-xs font-bold flex items-center justify-center">2</span>We send you a WhatsApp message with an estimated completion date and any clarifying questions.</li>
          <li class="flex gap-3"><span class="flex-shrink-0 w-6 h-6 rounded-full bg-brand/10 text-brand text-xs font-bold flex items-center justify-center">3</span>Your item is printed, quality-checked, and dispatched or made ready for collection.</li>
        </ol>
      </div>

      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={wa("Hi PrintHub, I just placed an order online. I'd like to follow up.")} target="_blank" rel="noopener" class="btn btn-wa text-sm">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          Follow up on WhatsApp
        </a>
        <a href="/shop/" class="btn btn-soft text-sm">Back to shop</a>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Read order details from URL params (set by CheckoutModal after successful payment)
  const p = new URLSearchParams(location.search);
  const product = p.get("product");
  const ref = p.get("ref");
  const name = p.get("name");
  const qty = p.get("qty");
  const size = p.get("size");
  const colour = p.get("colour");
  const delivery = p.get("delivery");
  const amount = p.get("amount");

  if (product) {
    const el = document.getElementById("confirm-product");
    if (el) el.textContent = `Your order for ${product} is on its way to our print queue.`;
  }
  if (ref) {
    const el = document.getElementById("confirm-ref");
    if (el) el.textContent = `Reference: ${ref}`;
  }

  // Personalize WhatsApp follow-up link
  const followUpBtn = document.querySelector<HTMLAnchorElement>('a[href*="wa.me"]');
  if (followUpBtn && ref) {
    const text = encodeURIComponent(`Hi PrintHub, I just placed order ${ref} for ${product || "a 3D print"}. I'd like to follow up.`);
    followUpBtn.href = `https://wa.me/254792732929?text=${text}`;
  }

  const summary = document.getElementById("order-summary");
  const rows = document.getElementById("summary-rows");
  if (summary && rows && (product || name)) {
    summary.style.display = "block";
    const items: [string, string | null][] = [
      ["Product", product],
      ["Quantity", qty],
      ["Size", size],
      ["Colour", colour],
      ["Delivery / Pickup", delivery],
      ["Amount paid", amount ? `KES ${Number(amount).toLocaleString()}` : null],
      ["Name", name],
      ["Reference", ref],
    ];
    rows.innerHTML = items
      .filter(([, v]) => v && v !== "null")
      .map(([k, v]) => `<div class="grid grid-cols-2 gap-4 py-3"><dt class="font-semibold text-sm">${k}</dt><dd class="text-sm text-mute">${v}</dd></div>`)
      .join("");
  }
</script>
