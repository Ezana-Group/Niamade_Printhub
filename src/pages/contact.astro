---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import { site, wa } from "../data/site";
import { fetchPageContentFromSanity } from "../lib/sanity";

const sanityContact = await fetchPageContentFromSanity("contact");
const heroHeading = sanityContact?.heroHeading || "Let's build something real.";
const heroSubtext = sanityContact?.heroSubtext || "WhatsApp is the fastest way to get engineering eyes on your project. Fill this in and we will open a direct thread with your specs pre-loaded.";

const ld = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: "Contact PrintHub Africa",
  description: "Contact PrintHub Africa and Niamade Hub for custom 3D printing and build quotes in Eldoret, Kenya.",
  url: `${site.url}/contact/`,
  mainEntity: {
    "@type": "LocalBusiness",
    name: site.name,
    legalName: site.businessName,
    url: site.url,
    telephone: site.phone,
    email: site.email,
    sameAs: [site.googleBusinessProfile, ...site.socials.map((s) => s.href)],
    address: {
      "@type": "PostalAddress",
      addressLocality: "Eldoret",
      addressRegion: "Uasin Gishu County",
      addressCountry: "KE"
    }
  }
};
---
<Layout title="Contact" jsonLd={ld} description="Chat with PrintHub Africa on WhatsApp, call, email or visit by appointment in Eldoret. Mon–Fri 8:00–18:00, Sat 9:00–15:00.">
  <section class="wrap pt-10 md:pt-14">
    <p class="eyebrow rise">Contact</p>
    <h1 style="--d:60ms" class="rise mt-2 text-5xl md:text-6xl">{heroHeading}</h1>
    <p style="--d:120ms" class="rise mt-4 text-xl text-mute max-w-2xl">{heroSubtext}</p>
    <div class="mt-12 grid lg:grid-cols-12 gap-8 items-start">
      <div class="lg:col-span-5 space-y-4">
        <a href={wa()} target="_blank" rel="noopener" class="press lift flex items-center gap-4 rounded-4xl bg-wa text-white p-6"><Icon name="whatsapp" size={30} /><span><span class="block font-display text-2xl">WhatsApp</span><span class="text-white/90">{site.phone}</span></span></a>
        <a href="/bookings/" class="press lift flex items-center gap-4 panel p-6 hover:border-brand transition-colors"><Icon name="calendar" size={26} class="text-brand shrink-0" /><div><span class="block font-display text-xl">Book a consultation</span><span class="text-mute">In-person studio visit or virtual call</span></div></a>
        <a href={`tel:${site.phone.replace(/\s/g, "")}`} class="press lift flex items-center gap-4 panel p-6"><Icon name="phone" size={26} class="text-brand" /><span><span class="block font-display text-xl">Call us</span><span class="text-mute">{site.phone} (same number)</span></span></a>
        <a href={`mailto:${site.email}`} class="press lift flex items-center gap-4 panel p-6"><Icon name="mail" size={26} class="text-brand" /><span><span class="block font-display text-xl">Email</span><span class="text-mute break-all">{site.email}</span></span></a>
        <a href={site.googleBusinessProfile} target="_blank" rel="noopener" class="press lift flex items-center gap-4 panel p-6 hover:border-brand transition-colors"><Icon name="pin" size={26} class="text-brand shrink-0" /><div><span class="block font-display text-xl">Google Business Profile</span><span class="text-mute">Verified on Google & Maps</span></div></a>
        <div class="panel p-6 flex gap-4"><Icon name="clock" size={26} class="text-brand shrink-0" /><div><p class="font-display text-xl">Hours</p><div class="text-mute space-y-0.5">{site.hours.map((h: string) => <p>{h}</p>)}</div><p class="text-mute mt-2 text-[0.97rem]">{site.city}. Collection by appointment.</p><a href="/bookings/" class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand hover:underline mt-2">Book a studio slot →</a></div></div>
        <div class="panel p-6">
          <p class="eyebrow">Company details</p>
          <dl class="mt-3 space-y-2.5 text-[0.97rem]">
            <div class="flex justify-between gap-4"><dt class="text-mute">Business Name</dt><dd class="font-semibold text-ink text-right">Niamade Hub</dd></div>
            <div class="flex justify-between gap-4"><dt class="text-mute">Trading Brand</dt><dd class="font-semibold text-ink text-right">PrintHub Africa</dd></div>
            <div class="flex justify-between gap-4"><dt class="text-mute">Website</dt><dd class="font-semibold text-brand text-right">printhub.africa</dd></div>
          </dl>
        </div>
        <ul class="flex gap-3 pt-1" aria-label="Social media">{site.socials.map((s) => <li><a href={s.href} target="_blank" rel="noopener" aria-label={`${s.label}: ${s.handle}`} class="w-12 h-12 rounded-full bg-sand grid place-items-center transition-[background-color,transform] duration-150 hover:bg-peach active:scale-95"><Icon name={s.id} size={22} /></a></li>)}</ul>
      </div>
      <form id="f" class="lg:col-span-7 panel p-7 md:p-9 space-y-5" novalidate>
        <h2 class="font-display text-3xl">Request a build quote</h2>
        <p class="text-mute">This packages your brief into WhatsApp so you can drop your CAD files, sketches or photos directly into the chat.</p>
        <div><label class="lbl" for="f-svc">What do you need?</label>
          <select id="f-svc" class="field" name="svc"><option>A gift or keepsake</option><option>Something for my business</option><option>I have a 3D file to print</option><option>I need a design, then printing</option><option>A part or prototype</option></select></div>
        <div><label class="lbl" for="f-name">Your name</label>
          <input id="f-name" class="field" name="name" autocomplete="name" required aria-describedby="e-name" /><p id="e-name" class="err" hidden>Please tell us your name.</p></div>
        <div class="grid grid-cols-2 gap-4">
          <div><label class="lbl" for="f-mat">Material</label>
            <select id="f-mat" class="field" name="mat"><option>Not sure (advise me)</option><option>PLA</option><option>PETG</option><option>TPU (flexible)</option></select></div>
          <div><label class="lbl" for="f-qty">Quantity</label>
            <input id="f-qty" class="field" name="qty" type="number" inputmode="numeric" min="1" value="1" /></div>
        </div>
        <div><label class="lbl" for="f-msg">Tell us about it</label>
          <textarea id="f-msg" class="field" name="msg" rows="4" placeholder="What is it, roughly how big, and when do you need it?" required aria-describedby="e-msg"></textarea><p id="e-msg" class="err" hidden>A short description helps us quote faster.</p></div>
        <button class="btn btn-wa w-full" type="submit"><Icon name="whatsapp" size={20} />Send via WhatsApp</button>
        <div id="status" role="status" aria-live="polite" class="text-base" hidden></div>
      </form>
    </div>
    <!-- INTERLINKING -->
    <div class="mt-16 border-t border-line pt-12">
      <h2 class="font-display text-2xl font-semibold">Other quick links</h2>
      <div class="mt-6 grid sm:grid-cols-3 gap-5">
        <a href="/shop/" class="press lift group rounded-3xl bg-card border border-line p-6 flex flex-col justify-between">
          <div>
            <h3 class="font-display text-lg font-semibold">3D Print Shop</h3>
            <p class="mt-2 text-sm text-mute">Gifts, décor, and useful pieces ready to order with direct M-Pesa checkout.</p>
          </div>
          <span class="mt-4 font-bold text-brand text-sm group-hover:underline">Visit shop →</span>
        </a>
        <a href="/custom/" class="press lift group rounded-3xl bg-card border border-line p-6 flex flex-col justify-between">
          <div>
            <h3 class="font-display text-lg font-semibold">Custom 3D Orders</h3>
            <p class="mt-2 text-sm text-mute">Upload a 3D model or describe an idea for custom CAD modeling &amp; printing.</p>
          </div>
          <span class="mt-4 font-bold text-brand text-sm group-hover:underline">Custom orders →</span>
        </a>
        <a href="/help/" class="press lift group rounded-3xl bg-card border border-line p-6 flex flex-col justify-between">
          <div>
            <h3 class="font-display text-lg font-semibold">Help &amp; FAQs</h3>
            <p class="mt-2 text-sm text-mute">Instant answers to pricing, courier delivery, polymers, and file types.</p>
          </div>
          <span class="mt-4 font-bold text-brand text-sm group-hover:underline">Read FAQs →</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
<script define:vars={{ waBase: wa("").split("?")[0], email: site.email }}>
  const form = document.getElementById("f"), status = document.getElementById("status");
  const check = (el, errId) => { const bad = !el.value.trim(); el.setAttribute("aria-invalid", String(bad)); document.getElementById(errId).hidden = !bad; return !bad; };
  ["name", "msg"].forEach((k) => document.getElementById("f-" + k).addEventListener("input", (e) => { if (e.target.getAttribute("aria-invalid") === "true") check(e.target, "e-" + k); }));
  form.addEventListener("submit", (e) => {
    e.preventDefault();
    const n = document.getElementById("f-name"), m = document.getElementById("f-msg");
    const ok = [check(n, "e-name"), check(m, "e-msg")];
    if (!ok.every(Boolean)) { (ok[0] ? m : n).focus(); return; }
    const d = new FormData(form);
    const text = `Hi PrintHub, I'm ${d.get("name")}.\nI need: ${d.get("svc")}\nMaterial: ${d.get("mat")}\nQuantity: ${d.get("qty")}\n${d.get("msg")}`;
    const wa = waBase + "?text=" + encodeURIComponent(text);
    const mail = "mailto:" + email + "?subject=" + encodeURIComponent("Quote request: " + d.get("svc")) + "&body=" + encodeURIComponent(text);

    // Save to Sanity & dispatch email notification in background
    try {
      fetch("/api/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          name: d.get("name"),
          service: d.get("svc"),
          material: d.get("mat"),
          quantity: d.get("qty"),
          message: d.get("msg"),
        }),
      })
      .then((res) => {
        if (!res.ok) throw new Error("Endpoint returned " + res.status);
      })
      .catch((err) => {
        console.warn("Contact API endpoint unavailable, saving directly to Sanity...", err);
        fetch("https://m7x6icn3.api.sanity.io/v2023-08-01/data/mutate/production", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Authorization: "Bearer skygOrLXyMmWLsjwtorwFxjPeKvB0GuiuVuGQzX8EVUCekz5F47hrIDfU39i4iiBdThNKYOUKsSQFID0UhsfiyHDkgoynGxZHE2YJi28RLxEBctoJ7gPynRki1QM75knT1WSbVnjigmRSTpoqR3z7yNvnMgRELuI6hFhO7LuaQgrKjNnogO9",
          },
          body: JSON.stringify({
            mutations: [{
              create: {
                _type: "contactInquiry",
                name: String(d.get("name") || "").trim(),
                phone: "",
                email: "",
                service: String(d.get("svc") || "General Quote Request").trim(),
                material: String(d.get("mat") || "Advise me").trim(),
                quantity: Number(d.get("qty")) || 1,
                message: String(d.get("msg") || "").trim(),
                status: "new",
                createdAt: new Date().toISOString(),
              }
            }]
          }),
        }).catch((e) => console.error("Direct Sanity contact save error:", e));
      });
    } catch (_) {}

    // Open WhatsApp, and always leave visible fallbacks: pop-up blockers and in-app browsers can swallow window.open.
    const w = window.open(wa, "_blank"); if (w) w.opener = null;
    status.hidden = false;
    status.className = "text-base rounded-3xl bg-sand p-5";
    status.innerHTML = '<p class="font-bold">' + (w ? "Opening WhatsApp…" : "Your browser blocked the WhatsApp window.") + '</p><p class="text-mute mt-1">If nothing opened, use one of these. Your message is already written.</p><p class="mt-4 flex flex-wrap gap-3"><a class="btn btn-wa !py-3" target="_blank" rel="noopener" href="' + wa + '">Open WhatsApp</a><a class="btn btn-soft !py-3" href="' + mail + '">Send by email instead</a></p>';
    status.scrollIntoView({ block: "nearest", behavior: "smooth" });
  });
</script>
