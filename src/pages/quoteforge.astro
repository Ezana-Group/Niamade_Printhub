---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import { site } from "../data/site";

const ld = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "QuoteForge Pro",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Windows, macOS, Linux, Docker",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
    description: "Self-hosted open source edition under AGPL v3"
  },
  description: "Accurate 3D printing quotations, live workshop printer telemetry, headless slicing, and customer invoice generation for additive manufacturing businesses.",
  publisher: {
    "@type": "Organization",
    name: "Ovid International Ltd",
    url: site.url
  }
};
---

<Layout
  title="QuoteForge Pro — 3D Printing Quotation & Workshop Engine"
  description="Accurate 3D printing quotes in seconds. Automatic material costing, multi-part plate pricing, headless slicer estimates, and printer monitoring. Self-host for free or join Cloud early access."
  jsonLd={ld}
>
  <!-- Hero Section -->
  <section class="wrap pt-10 md:pt-16 pb-12 md:pb-20 text-center">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-sand/80 border border-line text-xs md:text-sm font-semibold text-brand mb-4">
      <span class="w-2 h-2 rounded-full bg-brand animate-pulse"></span>
      <span>v1.0.0 Now Released · Open Source & Self-Hosted</span>
    </div>

    <h1 class="font-display text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold tracking-tight text-ink max-w-4xl mx-auto leading-[1.08]">
      Fast, profitable 3D printing quotes <span class="text-brand">in seconds.</span>
    </h1>

    <p class="mt-5 text-lg sm:text-xl text-mute max-w-2xl mx-auto leading-relaxed">
      No more guesswork spreadsheets. QuoteForge calculates real machine time, material density, electricity, and custom margins. Built for 3D print workshops, hubs, and makers worldwide.
    </p>

    <!-- CTAs -->
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3.5 sm:gap-4">
      <a href="#self-host" class="btn btn-primary !py-3.5 !px-6 text-base font-semibold shadow-md hover:shadow-lg transition-all flex items-center gap-2">
        <Icon name="terminal" size={18} />
        <span>Deploy Self-Hosted (Free)</span>
      </a>
      <button type="button" data-open-waitlist data-plan="Cloud Workshop" class="btn btn-soft !py-3.5 !px-6 text-base font-semibold border-brand/40 text-brand hover:border-brand hover:bg-peach/30 transition-all flex items-center gap-2">
        <Icon name="cloud" size={18} />
        <span>Try Cloud Early Access</span>
      </button>
      <a href="/quoteforge/docs/" class="btn btn-ghost !py-3.5 !px-5 text-base font-medium text-mute hover:text-ink flex items-center gap-1.5">
        <span>Documentation</span>
        <span>→</span>
      </a>
    </div>

    <!-- Quick highlights -->
    <div class="mt-10 grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4 max-w-4xl mx-auto text-left">
      <div class="panel p-4 rounded-2xl">
        <p class="text-xs uppercase font-bold text-mute tracking-wider">Engine</p>
        <p class="font-display text-base sm:text-lg font-bold text-ink mt-0.5">Dual-Slicer Support</p>
        <p class="text-xs text-mute mt-1">PrusaSlicer & OrcaSlicer headless CLI</p>
      </div>
      <div class="panel p-4 rounded-2xl">
        <p class="text-xs uppercase font-bold text-mute tracking-wider">Telemetry</p>
        <p class="font-display text-base sm:text-lg font-bold text-ink mt-0.5">Live Farm Status</p>
        <p class="text-xs text-mute mt-1">Bambu Lab, PrusaLink, Moonraker & Elegoo</p>
      </div>
      <div class="panel p-4 rounded-2xl">
        <p class="text-xs uppercase font-bold text-mute tracking-wider">Documents</p>
        <p class="font-display text-base sm:text-lg font-bold text-ink mt-0.5">Instant WhatsApp/PDF</p>
        <p class="text-xs text-mute mt-1">Pre-formatted client ladders & invoices</p>
      </div>
      <div class="panel p-4 rounded-2xl">
        <p class="text-xs uppercase font-bold text-mute tracking-wider">Privacy</p>
        <p class="font-display text-base sm:text-lg font-bold text-ink mt-0.5">Zero Telemetry</p>
        <p class="text-xs text-mute mt-1">100% data ownership under AGPL v3</p>
      </div>
    </div>
  </section>

  <!-- Interactive Terminal / Deployment Section -->
  <section id="self-host" class="wrap py-12 md:py-16 scroll-mt-24">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-8">
        <p class="eyebrow">Developer & Maker Experience</p>
        <h2 class="font-display text-3xl sm:text-4xl font-bold mt-1.5">Deploy on your own infrastructure</h2>
        <p class="text-mute text-base mt-2">Zero third-party runtime dependencies. Run locally with Docker, Docker Compose, or Node.js.</p>
      </div>

      <!-- Terminal Window -->
      <div class="rounded-3xl bg-[#14161a] border border-white/10 shadow-2xl overflow-hidden text-cream font-mono">
        <!-- Terminal Header -->
        <div class="bg-[#1e2229] px-5 py-3.5 flex items-center justify-between border-b border-white/10">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-[#ff5f56] inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-[#ffbd2e] inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-[#27c93f] inline-block"></span>
            <span class="text-xs text-cream/50 ml-2 font-sans font-medium">bash — QuoteForge v1.0.0</span>
          </div>

          <!-- Command Switcher Tabs -->
          <div class="flex items-center gap-1 bg-black/40 p-1 rounded-xl text-xs font-sans">
            <button type="button" class="term-tab px-3 py-1 rounded-lg transition-all font-semibold active-tab bg-white/15 text-white" data-target="cmd-docker">
              Docker Run
            </button>
            <button type="button" class="term-tab px-3 py-1 rounded-lg transition-all text-cream/60 hover:text-cream" data-target="cmd-compose">
              Docker Compose
            </button>
            <button type="button" class="term-tab px-3 py-1 rounded-lg transition-all text-cream/60 hover:text-cream" data-target="cmd-npm">
              Node.js CLI
            </button>
          </div>
        </div>

        <!-- Terminal Body -->
        <div class="p-6 sm:p-8 relative">
          <!-- Copy Button -->
          <button
            type="button"
            id="copy-term-btn"
            class="absolute top-4 right-4 px-3.5 py-1.5 rounded-xl bg-white/10 hover:bg-white/20 active:scale-95 transition-all text-xs font-sans font-medium flex items-center gap-1.5 text-cream border border-white/10"
            title="Copy command to clipboard"
          >
            <svg id="copy-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
            <span id="copy-text">Copy</span>
          </button>

          <!-- Snippet 1: Docker Run -->
          <div id="cmd-docker" class="term-content text-sm sm:text-[0.95rem] leading-relaxed">
            <p class="text-cream/40 mb-2"># 1. Pull and run QuoteForge container on port 8080</p>
            <p class="text-brand font-semibold select-all">docker run -d \</p>
            <p class="text-cream/90 select-all pl-4">--name quoteforge \</p>
            <p class="text-cream/90 select-all pl-4">-p 8080:8080 \</p>
            <p class="text-cream/90 select-all pl-4">-v quoteforge_data:/root/.quoteforge \</p>
            <p class="text-cream/90 select-all pl-4">--restart unless-stopped \</p>
            <p class="text-cream/90 select-all pl-4">ghcr.io/ezana-group/quoteforge:v1.0.0</p>
            <p class="text-cream/40 mt-4"># 2. Open in your browser: <span class="text-accent underline">http://localhost:8080</span></p>
          </div>

          <!-- Snippet 2: Compose -->
          <div id="cmd-compose" class="term-content text-sm sm:text-[0.95rem] leading-relaxed hidden">
            <p class="text-cream/40 mb-2"># docker-compose.yml</p>
            <pre class="text-cream/90 overflow-x-auto select-all"><code>services:
  quoteforge:
    image: ghcr.io/ezana-group/quoteforge:v1.0.0
    container_name: quoteforge
    restart: unless-stopped
    ports:
      - "8080:8080"
    volumes:
      - ./data:/root/.quoteforge
    environment:
      - PORT=8080
      - HOST=0.0.0.0</code></pre>
          </div>

          <!-- Snippet 3: Node -->
          <div id="cmd-npm" class="term-content text-sm sm:text-[0.95rem] leading-relaxed hidden">
            <p class="text-cream/40 mb-2"># Run via Git & standard Node.js (v18+)</p>
            <p class="text-brand font-semibold select-all">git clone https://github.com/niamade/quoteforge.git</p>
            <p class="text-brand font-semibold select-all">cd quoteforge && npm install --omit=dev</p>
            <p class="text-brand font-semibold select-all">npm start</p>
            <p class="text-cream/40 mt-3"># Zero dependencies required. Native Node standard library only.</p>
          </div>
        </div>
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-between text-xs text-mute px-2 gap-2">
        <p>Need reverse proxy, SSL, and backup guides? Check our complete manual.</p>
        <div class="flex items-center gap-4">
          <a href="/quoteforge/docs/" class="font-semibold text-brand hover:underline inline-flex items-center gap-1">
            <span>Documentation Manual</span>
            <span>→</span>
          </a>
          <a href="https://github.com/niamade/quoteforge/releases" target="_blank" rel="noopener" class="font-semibold text-mute hover:text-ink inline-flex items-center gap-1">
            <span>GitHub Releases (v1.0.0)</span>
            <span>→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Product UI & Feature Tour -->
  <section class="wrap py-12 md:py-20">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <p class="eyebrow">Feature Showcase</p>
      <h2 class="font-display text-3xl sm:text-5xl font-bold mt-2">Engineered for real workshop workflows</h2>
      <p class="text-mute text-lg mt-3">Built by 3D print operators who run high-mix additive manufacturing every single day.</p>
    </div>

    <!-- Screenshot Feature 1: Quote Calculation -->
    <div class="grid lg:grid-cols-12 gap-8 items-center mb-16">
      <div class="lg:col-span-5 space-y-4">
        <div class="w-10 h-10 rounded-xl bg-brand/10 text-brand flex items-center justify-center font-bold">1</div>
        <h3 class="font-display text-2xl sm:text-3xl font-bold">Arithmetic Margin Ladder</h3>
        <p class="text-mute leading-relaxed">
          Every quote computes raw filament grams, machine time amortisation, custom facility metrics (electricity, floor space, operator prep), and minimum order pricing thresholds in your configured currency (KES, USD, EUR, GBP).
        </p>
        <ul class="space-y-2 text-sm text-ink/80 pt-2 font-medium">
          <li class="flex items-center gap-2">✓ Automatic bulk quantity discounts</li>
          <li class="flex items-center gap-2">✓ Configurable tax labels (Sales Tax, VAT, GST)</li>
          <li class="flex items-center gap-2">✓ Multi-part build plate breakdown</li>
        </ul>
      </div>
      <div class="lg:col-span-7">
        <div class="panel rounded-3xl overflow-hidden p-2 sm:p-3 border border-line shadow-xl bg-sand/30">
          <img src="/images/quoteforge/quote.png" alt="QuoteForge calculation ladder" width="1024" height="581" class="rounded-2xl w-full h-auto" loading="lazy" />
        </div>
      </div>
    </div>

    <!-- Screenshot Feature 2: Job History & Tracking -->
    <div class="grid lg:grid-cols-12 gap-8 items-center mb-16">
      <div class="lg:col-span-7 order-2 lg:order-1">
        <div class="panel rounded-3xl overflow-hidden p-2 sm:p-3 border border-line shadow-xl bg-sand/30">
          <img src="/images/quoteforge/jobs.png" alt="QuoteForge job tracking table and pipeline" width="1024" height="686" class="rounded-2xl w-full h-auto" loading="lazy" />
        </div>
      </div>
      <div class="lg:col-span-5 order-1 lg:order-2 space-y-4">
        <div class="w-10 h-10 rounded-xl bg-brand/10 text-brand flex items-center justify-center font-bold">2</div>
        <h3 class="font-display text-2xl sm:text-3xl font-bold">Production Pipeline & History</h3>
        <p class="text-mute leading-relaxed">
          Track parts through Quoted, Printing, Invoiced, and Completed stages. Filter by customer, view filament usage per job, and export audit trails instantly.
        </p>
        <ul class="space-y-2 text-sm text-ink/80 pt-2 font-medium">
          <li class="flex items-center gap-2">✓ Paid vs. Pending invoice indicators</li>
          <li class="flex items-center gap-2">✓ Direct re-quote from previous job history</li>
          <li class="flex items-center gap-2">✓ Customer contact details auto-attached</li>
        </ul>
      </div>
    </div>

    <!-- Screenshot Feature 3: Reports & Analytics -->
    <div class="grid lg:grid-cols-12 gap-8 items-center">
      <div class="lg:col-span-5 space-y-4">
        <div class="w-10 h-10 rounded-xl bg-brand/10 text-brand flex items-center justify-center font-bold">3</div>
        <h3 class="font-display text-2xl sm:text-3xl font-bold">Workshop Margin Analytics</h3>
        <p class="text-mute leading-relaxed">
          Understand which materials and printers generate your strongest gross profit. Monitor filament consumption, average job value, and uncollected revenue.
        </p>
        <ul class="space-y-2 text-sm text-ink/80 pt-2 font-medium">
          <li class="flex items-center gap-2">✓ Real-time profit vs. target margin check</li>
          <li class="flex items-center gap-2">✓ Total filament kilograms consumed by brand</li>
          <li class="flex items-center gap-2">✓ Full CSV & JSON data portability</li>
        </ul>
      </div>
      <div class="lg:col-span-7">
        <div class="panel rounded-3xl overflow-hidden p-2 sm:p-3 border border-line shadow-xl bg-sand/30">
          <img src="/images/quoteforge/reports.png" alt="QuoteForge reports and analytics" width="948" height="1024" class="rounded-2xl w-full h-auto" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- Complete Interactive Pricing & Plans Section -->
  <section id="pricing" class="wrap py-12 md:py-24 border-t border-line scroll-mt-24">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <p class="eyebrow">Plans &amp; Deployment Options</p>
      <h2 class="font-display text-3xl sm:text-5xl font-bold mt-2">Transparent pricing for every workshop</h2>
      <p class="text-mute text-lg mt-3">Start with our free self-hosted edition or scale with hosted cloud infrastructure.</p>

      <!-- Billing Cycle Toggle -->
      <div class="mt-8 inline-flex items-center p-1.5 rounded-2xl bg-sand border border-line">
        <button type="button" id="toggle-monthly" class="billing-toggle-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all bg-white text-ink shadow-sm">
          Monthly Billing
        </button>
        <button type="button" id="toggle-annual" class="billing-toggle-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all text-mute hover:text-ink flex items-center gap-1.5">
          <span>Annual Billing</span>
          <span class="px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600 text-[0.65rem] font-bold">Save 20%</span>
        </button>
      </div>
    </div>

    <!-- 4-Tier Pricing Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-7xl mx-auto">
      <!-- Tier 1: Community (Self-Hosted) -->
      <div class="panel rounded-3xl p-6 sm:p-7 border border-line flex flex-col justify-between hover:border-brand/40 transition-colors">
        <div>
          <span class="text-xs uppercase font-bold tracking-wider px-3 py-1 rounded-full bg-sand text-ink">Open Source</span>
          <h3 class="font-display text-2xl font-bold mt-3">Community</h3>
          <p class="text-mute text-xs sm:text-sm mt-1">For independent makers, hackerspaces, and solo workshops.</p>

          <div class="mt-5">
            <span class="font-display text-4xl sm:text-5xl font-bold text-ink">$0</span>
            <span class="text-mute text-xs sm:text-sm">/ forever</span>
            <p class="text-[0.7rem] text-mute mt-1">AGPL-3.0 License · Zero Cloud Fees</p>
          </div>

          <div class="mt-6 pt-6 border-t border-line space-y-2.5 text-xs sm:text-sm">
            <div class="flex items-center gap-2">
              <span class="text-brand font-bold">✓</span>
              <span>1 Local Workshop Instance</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-brand font-bold">✓</span>
              <span>Unlimited quotes & jobs</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-brand font-bold">✓</span>
              <span>Local SQLite & JSON storage</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-brand font-bold">✓</span>
              <span>LAN printer discovery</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-brand font-bold">✓</span>
              <span>100% offline functionality</span>
            </div>
          </div>
        </div>

        <div class="mt-8 pt-6 border-t border-line">
          <a href="#self-host" class="btn btn-soft w-full text-center text-xs sm:text-sm">Install Free</a>
        </div>
      </div>

      <!-- Tier 2: Cloud Solo -->
      <div class="panel rounded-3xl p-6 sm:p-7 border border-line flex flex-col justify-between hover:border-brand/40 transition-colors">
        <div>
          <span class="text-xs uppercase font-bold tracking-wider px-3 py-1 rounded-full bg-sand text-ink">Cloud Starter</span>
          <h3 class="font-display text-2xl font-bold mt-3">Cloud Solo</h3>
          <p class="text-mute text-xs sm:text-sm mt-1">For growing print businesses wanting remote web access.</p>

          <div class="mt-5">
            <div class="flex items-baseline gap-1">
              <span class="font-display text-4xl sm:text-5xl font-bold text-ink price-solo">$19</span>
              <span class="text-mute text-xs sm:text-sm">/ month</span>
            </div>
            <p class="text-[0.7rem] text-mute mt-1 price-solo-sub">Billed monthly ($228/yr)</p>
          </div>

          <div class="mt-6 pt-6 border-t border-line space-y-2.5 text-xs sm:text-sm">
            <div class="flex items-center gap-2">
              <span class="text-brand font-bold">✓</span>
              <span>1 Estimator Seat</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-brand font-bold">✓</span>
              <span>Up to 5 Connected 3D Printers</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-brand font-bold">✓</span>
              <span>500 Quotes / month</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-brand font-bold">✓</span>
              <span>50 GB Cloudflare R2 CAD Storage</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-brand font-bold">✓</span>
              <span>Managed Postgres & Backups</span>
            </div>
          </div>
        </div>

        <div class="mt-8 pt-6 border-t border-line">
          <button type="button" data-open-waitlist data-plan="Cloud Solo" class="btn btn-soft w-full text-center text-xs sm:text-sm">Request Early Access</button>
        </div>
      </div>

      <!-- Tier 3: Cloud Workshop (Popular) -->
      <div class="panel rounded-3xl p-6 sm:p-7 border-2 border-brand bg-peach/10 flex flex-col justify-between relative shadow-xl">
        <div class="absolute -top-3.5 right-6 px-3 py-1 rounded-full bg-brand text-white text-[0.65rem] font-bold tracking-wider uppercase">
          Most Popular
        </div>

        <div>
          <span class="text-xs uppercase font-bold tracking-wider px-3 py-1 rounded-full bg-brand/20 text-brand">Team Hub</span>
          <h3 class="font-display text-2xl font-bold mt-3">Cloud Workshop</h3>
          <p class="text-mute text-xs sm:text-sm mt-1">For production bureaus, print farms, and distributed teams.</p>

          <div class="mt-5">
            <div class="flex items-baseline gap-1">
              <span class="font-display text-4xl sm:text-5xl font-bold text-ink price-workshop">$49</span>
              <span class="text-mute text-xs sm:text-sm">/ month</span>
            </div>
            <p class="text-[0.7rem] text-brand font-semibold mt-1 price-workshop-sub">Billed monthly ($588/yr)</p>
          </div>

          <div class="mt-6 pt-6 border-t border-line space-y-2.5 text-xs sm:text-sm">
            <div class="flex items-center gap-2 font-semibold text-ink">
              <span class="text-brand font-bold">✓</span>
              <span>Unlimited Estimators & Staff</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-brand font-bold">✓</span>
              <span>Up to 25 Connected 3D Printers</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-brand font-bold">✓</span>
              <span>Hardware Bridge Farm Telemetry</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-brand font-bold">✓</span>
              <span>Accounting Export (QuickBooks & Xero CSV)</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-brand font-bold">✓</span>
              <span>Outbound Webhooks (Zapier & Make Automation)</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-brand font-bold">✓</span>
              <span>250 GB Cloudflare R2 CAD Storage</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-brand font-bold">✓</span>
              <span>Team RBAC Roles (Owner, Staff)</span>
            </div>
          </div>
        </div>

        <div class="mt-8 pt-6 border-t border-line">
          <button type="button" data-open-waitlist data-plan="Cloud Workshop" class="btn btn-primary w-full text-center text-xs sm:text-sm">Request Early Access</button>
        </div>
      </div>

      <!-- Tier 4: Enterprise / Bureau -->
      <div class="panel rounded-3xl p-6 sm:p-7 border border-line flex flex-col justify-between hover:border-brand/40 transition-colors">
        <div>
          <span class="text-xs uppercase font-bold tracking-wider px-3 py-1 rounded-full bg-sand text-ink">Scale & API</span>
          <h3 class="font-display text-2xl font-bold mt-3">Enterprise</h3>
          <p class="text-mute text-xs sm:text-sm mt-1">For universities, industrial manufacturers, and high-volume bureaus.</p>

          <div class="mt-5">
            <div class="flex items-baseline gap-1">
              <span class="font-display text-4xl sm:text-5xl font-bold text-ink price-enterprise">$149</span>
              <span class="text-mute text-xs sm:text-sm">/ month</span>
            </div>
            <p class="text-[0.7rem] text-mute mt-1 price-enterprise-sub">Billed monthly ($1,788/yr)</p>
          </div>

          <div class="mt-6 pt-6 border-t border-line space-y-2.5 text-xs sm:text-sm">
            <div class="flex items-center gap-2">
              <span class="text-brand font-bold">✓</span>
              <span>Dedicated Isolated PostgreSQL</span>
            </div>
