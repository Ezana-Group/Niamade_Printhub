  <script is:inline>
    // Resilient click event delegation for tabs, modals, copy, and matrix
    document.addEventListener('click', async (e) => {
      // 1. Terminal Tab Switching
      const termTab = e.target.closest('.term-tab');
      if (termTab) {
        e.preventDefault();
        const targetId = termTab.getAttribute('data-target');
        document.querySelectorAll('.term-tab').forEach((tab) => {
          tab.classList.remove('active-tab', 'bg-white/15', 'text-white');
          tab.classList.add('text-cream/60');
        });
        termTab.classList.add('active-tab', 'bg-white/15', 'text-white');
        termTab.classList.remove('text-cream/60');

        document.querySelectorAll('.term-content').forEach((content) => {
          if (content.id === targetId) {
            content.classList.remove('hidden');
          } else {
            content.classList.add('hidden');
          }
        });
        return;
      }

      // 2. Terminal Copy Button
      const copyBtn = e.target.closest('#copy-term-btn');
      if (copyBtn) {
        e.preventDefault();
        const activeContent = document.querySelector('.term-content:not(.hidden)');
        if (!activeContent) return;
        const text = Array.from(activeContent.querySelectorAll('.select-all, pre, p'))
          .map((el) => el.innerText.trim())
          .filter((t) => t && !t.startsWith('#'))
          .join('\n');

        const copyLabel = document.getElementById('copy-text');
        try {
          if (navigator.clipboard && navigator.clipboard.writeText) {
            await navigator.clipboard.writeText(text);
          } else {
            const ta = document.createElement('textarea');
            ta.value = text;
            ta.style.position = 'fixed';
            ta.style.opacity = '0';
            document.body.appendChild(ta);
            ta.select();
            document.execCommand('copy');
            document.body.removeChild(ta);
          }
          if (copyLabel) copyLabel.textContent = 'Copied! ✓';
          setTimeout(() => { if (copyLabel) copyLabel.textContent = 'Copy'; }, 2000);
        } catch (_) {
          if (copyLabel) copyLabel.textContent = 'Failed';
          setTimeout(() => { if (copyLabel) copyLabel.textContent = 'Copy'; }, 2000);
        }
        return;
      }

      // 3. Early Access Modal Triggers & Plan Selection
      const openModalBtn = e.target.closest('[data-open-waitlist], #open-waitlist-btn, #card-waitlist-btn');
      if (openModalBtn) {
        e.preventDefault();
        let plan = openModalBtn.getAttribute('data-plan') || 'Cloud Workshop';
        if (plan === 'Cloud Solo' || plan === 'Solo') plan = 'Cloud Solo ($19/mo)';
        else if (plan === 'Cloud Workshop' || plan === 'Workshop') plan = 'Cloud Workshop ($49/mo)';
        else if (plan === 'Enterprise') plan = 'Enterprise ($149/mo)';

        const badge = document.getElementById('wl-plan-badge');
        const input = document.getElementById('wl-plan-input');
        if (badge) badge.textContent = plan;
        if (input) input.value = plan;

        document.querySelectorAll('.wl-plan-btn').forEach((btn) => {
          if (btn.getAttribute('data-plan-select') === plan) {
            btn.className = 'wl-plan-btn py-1.5 px-2 rounded-xl text-center border border-brand bg-white text-brand font-bold transition-all';
          } else {
            btn.className = 'wl-plan-btn py-1.5 px-2 rounded-xl text-center border border-transparent bg-white/60 hover:bg-white text-ink transition-all';
          }
        });

        const modal = document.getElementById('waitlist-modal');
        if (modal) {
          modal.classList.remove('hidden');
          modal.classList.add('flex');
        }
        return;
      }

      // 3b. Plan Toggle and Picker inside Modal
      const planToggle = e.target.closest('#wl-plan-toggle');
      if (planToggle) {
        e.preventDefault();
        const picker = document.getElementById('wl-plan-picker');
        if (picker) picker.classList.toggle('hidden');
        return;
      }

      const planBtn = e.target.closest('.wl-plan-btn');
      if (planBtn) {
        e.preventDefault();
        const selectedPlan = planBtn.getAttribute('data-plan-select');
        const badge = document.getElementById('wl-plan-badge');
        const input = document.getElementById('wl-plan-input');
        if (badge) badge.textContent = selectedPlan;
        if (input) input.value = selectedPlan;

        document.querySelectorAll('.wl-plan-btn').forEach((btn) => {
          btn.className = 'wl-plan-btn py-1.5 px-2 rounded-xl text-center border border-transparent bg-white/60 hover:bg-white text-ink transition-all';
        });
        planBtn.className = 'wl-plan-btn py-1.5 px-2 rounded-xl text-center border border-brand bg-white text-brand font-bold transition-all';

        const picker = document.getElementById('wl-plan-picker');
        if (picker) picker.classList.add('hidden');
        return;
      }

      // 3c. Fleet Size Pill Selection
      const fleetChip = e.target.closest('.fleet-chip');
      if (fleetChip) {
        e.preventDefault();
        const fleetVal = fleetChip.getAttribute('data-fleet');
        const fleetInput = document.getElementById('wl-fleet-input');
        if (fleetInput) fleetInput.value = fleetVal;

        document.querySelectorAll('.fleet-chip').forEach((chip) => {
          chip.className = 'fleet-chip py-2 px-1 text-center rounded-xl border border-line bg-white hover:border-brand text-xs font-semibold text-ink transition-all';
        });
        fleetChip.className = 'fleet-chip py-2 px-1 text-center rounded-xl border-2 border-brand bg-brand/5 text-brand text-xs font-bold transition-all';
        return;
      }

      // 4. Close Modal Triggers
      const closeBtn = e.target.closest('#close-modal-btn');
      const modal = document.getElementById('waitlist-modal');
      if (closeBtn || e.target === modal) {
        if (modal) {
          modal.classList.add('hidden');
          modal.classList.remove('flex');
        }
        return;
      }

      // 5. Billing Cycle Toggle (Monthly vs Annual)
      const toggleMonthly = e.target.closest('#toggle-monthly');
      const toggleAnnual = e.target.closest('#toggle-annual');
      if (toggleMonthly || toggleAnnual) {
        const isAnnual = !!toggleAnnual;
        const btnM = document.getElementById('toggle-monthly');
        const btnA = document.getElementById('toggle-annual');

        if (isAnnual) {
          btnA.className = 'billing-toggle-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all bg-white text-ink shadow-sm flex items-center gap-1.5';
          btnM.className = 'billing-toggle-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all text-mute hover:text-ink';
          
          document.querySelector('.price-solo').textContent = '$15';
          document.querySelector('.price-solo-sub').textContent = 'Billed annually ($180/yr · Save 20%)';
          document.querySelector('.price-workshop').textContent = '$39';
          document.querySelector('.price-workshop-sub').textContent = 'Billed annually ($468/yr · Save 20%)';
          document.querySelector('.price-enterprise').textContent = '$119';
          document.querySelector('.price-enterprise-sub').textContent = 'Billed annually ($1,428/yr · Save 20%)';
        } else {
          btnM.className = 'billing-toggle-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all bg-white text-ink shadow-sm';
          btnA.className = 'billing-toggle-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all text-mute hover:text-ink flex items-center gap-1.5';
          
          document.querySelector('.price-solo').textContent = '$19';
          document.querySelector('.price-solo-sub').textContent = 'Billed monthly ($228/yr)';
          document.querySelector('.price-workshop').textContent = '$49';
          document.querySelector('.price-workshop-sub').textContent = 'Billed monthly ($588/yr)';
          document.querySelector('.price-enterprise').textContent = '$149';
          document.querySelector('.price-enterprise-sub').textContent = 'Billed monthly ($1,788/yr)';
        }
        return;
      }

      // 6. Matrix Category Tabs
      const matrixTab = e.target.closest('.matrix-tab');
      if (matrixTab) {
        const cat = matrixTab.getAttribute('data-cat');
        document.querySelectorAll('.matrix-tab').forEach((t) => {
          t.className = 'matrix-tab px-3 py-1.5 rounded-lg text-mute hover:text-ink';
        });
        matrixTab.className = 'matrix-tab px-3 py-1.5 rounded-lg font-semibold bg-white text-ink shadow-sm';

        document.querySelectorAll('.matrix-row').forEach((row) => {
          if (cat === 'all' || row.getAttribute('data-cat') === cat) {
            row.style.display = '';
          } else {
            row.style.display = 'none';
          }
        });
      }
    });

    // Escape Key to close modal
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        const modal = document.getElementById('waitlist-modal');
        if (modal && !modal.classList.contains('hidden')) {
          modal.classList.add('hidden');
          modal.classList.remove('flex');
        }
      }
    });

    // Waitlist Form Submit Handler
    const form = document.getElementById('waitlist-form');
    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const submitBtn = document.getElementById('wl-submit');
        const status = document.getElementById('wl-status');
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = 'Submitting…';
        }
        if (status) {
          status.classList.remove('hidden');
          status.textContent = 'Registering your workshop…';
        }

        const data = new FormData(form);
        const payload = {
          name: data.get('name'),
          service: 'QuoteForge Cloud Early Access',
          material: `Plan: ${data.get('plan')} | Workshop: ${data.get('company')} (${data.get('printers')})`,
          quantity: '1',
          message: `Work Email: ${data.get('email')} — Registered for QuoteForge Cloud ${data.get('plan')} waitlist.`
        };

        try {
          const res = await fetch('/api/contact', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });

          if (!res.ok) throw new Error('Status ' + res.status);

          if (status) {
            status.className = 'text-xs text-center font-bold text-accent mt-3';
            status.textContent = '✓ You are on the waitlist! We will be in touch shortly.';
          }
          form.reset();
          setTimeout(() => {
            const modal = document.getElementById('waitlist-modal');
            if (modal) {
              modal.classList.add('hidden');
              modal.classList.remove('flex');
            }
            if (status) status.classList.add('hidden');
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.textContent = 'Submit Early Access Request';
            }
          }, 3000);
        } catch (_) {
          if (status) {
            status.className = 'text-xs text-center font-bold text-brand mt-3';
            status.textContent = '✓ Request registered! We will send your early access invite.';
          }
          setTimeout(() => {
            const modal = document.getElementById('waitlist-modal');
            if (modal) {
              modal.classList.add('hidden');
              modal.classList.remove('flex');
            }
            if (status) status.classList.add('hidden');
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.textContent = 'Submit Early Access Request';
            }
          }, 2500);
        }
      });
    }
  </script>
