---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import { site } from "../data/site";

const ld = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "QuoteForge Pro",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Windows, macOS, Linux, Docker",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
    description: "Self-hosted open source edition under AGPL v3"
  },
  description: "Accurate 3D printing quotations, live workshop printer telemetry, headless slicing, and customer invoice generation for additive manufacturing businesses.",
  publisher: {
    "@type": "Organization",
    name: "Ovid International Ltd",
    url: site.url
  }
};
---

<Layout
  title="QuoteForge Pro — 3D Printing Quotation & Workshop Engine"
  description="Accurate 3D printing quotes in seconds. Automatic material costing, multi-part plate pricing, headless slicer estimates, and printer monitoring. Self-host for free or join Cloud early access."
  jsonLd={ld}
>
  <!-- Hero Section -->
  <section class="wrap pt-10 md:pt-16 pb-12 md:pb-20 text-center">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-sand/80 border border-line text-xs md:text-sm font-semibold text-brand mb-4">
      <span class="w-2 h-2 rounded-full bg-brand animate-pulse"></span>
      <span>v1.0.0 Now Released · Open Source & Self-Hosted</span>
    </div>

    <h1 class="font-display text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold tracking-tight text-ink max-w-4xl mx-auto leading-[1.08]">
      Fast, profitable 3D printing quotes <span class="text-brand">in seconds.</span>
    </h1>

    <p class="mt-5 text-lg sm:text-xl text-mute max-w-2xl mx-auto leading-relaxed">
      No more guesswork spreadsheets. QuoteForge calculates real machine time, material density, electricity, and custom margins. Built for 3D print workshops, hubs, and makers.
    </p>

    <!-- CTAs -->
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3.5 sm:gap-4">
      <a href="#self-host" class="btn btn-primary !py-3.5 !px-6 text-base font-semibold shadow-md hover:shadow-lg transition-all flex items-center gap-2">
        <Icon name="terminal" size={18} />
        <span>Deploy Self-Hosted (Free)</span>
      </a>
      <button type="button" id="open-waitlist-btn" class="btn btn-soft !py-3.5 !px-6 text-base font-semibold border-brand/40 text-brand hover:border-brand hover:bg-peach/30 transition-all flex items-center gap-2">
        <Icon name="cloud" size={18} />
        <span>Try Cloud Early Access</span>
      </button>
    </div>

    <!-- Quick highlights -->
    <div class="mt-10 grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4 max-w-4xl mx-auto text-left">
      <div class="panel p-4 rounded-2xl">
        <p class="text-xs uppercase font-bold text-mute tracking-wider">Engine</p>
        <p class="font-display text-base sm:text-lg font-bold text-ink mt-0.5">Dual-Slicer Support</p>
        <p class="text-xs text-mute mt-1">PrusaSlicer & OrcaSlicer headless CLI</p>
      </div>
      <div class="panel p-4 rounded-2xl">
        <p class="text-xs uppercase font-bold text-mute tracking-wider">Telemetry</p>
        <p class="font-display text-base sm:text-lg font-bold text-ink mt-0.5">Live Farm Status</p>
        <p class="text-xs text-mute mt-1">Bambu Lab, PrusaLink, Moonraker & Elegoo</p>
      </div>
      <div class="panel p-4 rounded-2xl">
        <p class="text-xs uppercase font-bold text-mute tracking-wider">Documents</p>
        <p class="font-display text-base sm:text-lg font-bold text-ink mt-0.5">Instant WhatsApp/PDF</p>
        <p class="text-xs text-mute mt-1">Pre-formatted client ladders & invoices</p>
      </div>
      <div class="panel p-4 rounded-2xl">
        <p class="text-xs uppercase font-bold text-mute tracking-wider">Privacy</p>
        <p class="font-display text-base sm:text-lg font-bold text-ink mt-0.5">Zero Telemetry</p>
        <p class="text-xs text-mute mt-1">100% data ownership under AGPL v3</p>
      </div>
    </div>
  </section>

  <!-- Interactive Terminal / Deployment Section -->
  <section id="self-host" class="wrap py-12 md:py-16 scroll-mt-24">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-8">
        <p class="eyebrow">Developer & Maker Experience</p>
        <h2 class="font-display text-3xl sm:text-4xl font-bold mt-1.5">Deploy on your own infrastructure</h2>
        <p class="text-mute text-base mt-2">Zero third-party runtime dependencies. Run locally with Docker, Docker Compose, or Node.js.</p>
      </div>

      <!-- Terminal Window -->
      <div class="rounded-3xl bg-[#14161a] border border-white/10 shadow-2xl overflow-hidden text-cream font-mono">
        <!-- Terminal Header -->
        <div class="bg-[#1e2229] px-5 py-3.5 flex items-center justify-between border-b border-white/10">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-[#ff5f56] inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-[#ffbd2e] inline-block"></span>
            <span class="w-3 h-3 rounded-full bg-[#27c93f] inline-block"></span>
            <span class="text-xs text-cream/50 ml-2 font-sans font-medium">bash — QuoteForge v1.0.0</span>
          </div>

          <!-- Command Switcher Tabs -->
          <div class="flex items-center gap-1 bg-black/40 p-1 rounded-xl text-xs font-sans">
            <button type="button" class="term-tab px-3 py-1 rounded-lg transition-all font-semibold active-tab" data-target="cmd-docker">
              Docker Run
            </button>
            <button type="button" class="term-tab px-3 py-1 rounded-lg transition-all text-cream/60 hover:text-cream" data-target="cmd-compose">
              Docker Compose
            </button>
            <button type="button" class="term-tab px-3 py-1 rounded-lg transition-all text-cream/60 hover:text-cream" data-target="cmd-npm">
              Node.js CLI
            </button>
          </div>
        </div>

        <!-- Terminal Body -->
        <div class="p-6 sm:p-8 relative">
          <!-- Copy Button -->
          <button
            type="button"
            id="copy-term-btn"
            class="absolute top-4 right-4 px-3.5 py-1.5 rounded-xl bg-white/10 hover:bg-white/20 active:scale-95 transition-all text-xs font-sans font-medium flex items-center gap-1.5 text-cream border border-white/10"
            title="Copy command to clipboard"
          >
            <svg id="copy-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
            <span id="copy-text">Copy</span>
          </button>

          <!-- Snippet 1: Docker Run -->
          <div id="cmd-docker" class="term-content text-sm sm:text-[0.95rem] leading-relaxed">
            <p class="text-cream/40 mb-2"># 1. Pull and run QuoteForge container on port 8080</p>
            <p class="text-brand font-semibold select-all">docker run -d \</p>
            <p class="text-cream/90 select-all pl-4">--name quoteforge \</p>
            <p class="text-cream/90 select-all pl-4">-p 8080:8080 \</p>
            <p class="text-cream/90 select-all pl-4">-v quoteforge_data:/root/.quoteforge \</p>
            <p class="text-cream/90 select-all pl-4">--restart unless-stopped \</p>
            <p class="text-cream/90 select-all pl-4">ghcr.io/niamade/quoteforge:v1.0.0</p>
            <p class="text-cream/40 mt-4"># 2. Open in your browser: <span class="text-accent underline">http://localhost:8080</span></p>
          </div>

          <!-- Snippet 2: Compose -->
          <div id="cmd-compose" class="term-content text-sm sm:text-[0.95rem] leading-relaxed hidden">
            <p class="text-cream/40 mb-2"># docker-compose.yml</p>
            <pre class="text-cream/90 overflow-x-auto select-all"><code>services:
  quoteforge:
    image: ghcr.io/niamade/quoteforge:v1.0.0
    container_name: quoteforge
    restart: unless-stopped
    ports:
      - "8080:8080"
    volumes:
      - ./data:/root/.quoteforge
    environment:
      - PORT=8080
      - HOST=0.0.0.0</code></pre>
          </div>

          <!-- Snippet 3: Node -->
          <div id="cmd-npm" class="term-content text-sm sm:text-[0.95rem] leading-relaxed hidden">
            <p class="text-cream/40 mb-2"># Run via Git & standard Node.js (v18+)</p>
            <p class="text-brand font-semibold select-all">git clone https://github.com/niamade/quoteforge.git</p>
            <p class="text-brand font-semibold select-all">cd quoteforge && npm install --omit=dev</p>
            <p class="text-brand font-semibold select-all">npm start</p>
            <p class="text-cream/40 mt-3"># Zero dependencies required. Native Node standard library only.</p>
          </div>
        </div>
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-between text-xs text-mute px-2 gap-2">
        <p>Looking for a standalone zip folder? Download the pre-packaged zip archive for Mac and Windows.</p>
        <a href="https://github.com/niamade/quoteforge/releases" target="_blank" rel="noopener" class="font-semibold text-brand hover:underline inline-flex items-center gap-1">
          <span>GitHub Releases (v1.0.0)</span>
          <span>→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Product UI & Feature Tour -->
  <section class="wrap py-12 md:py-20">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <p class="eyebrow">Feature Showcase</p>
      <h2 class="font-display text-3xl sm:text-5xl font-bold mt-2">Engineered for real workshop workflows</h2>
      <p class="text-mute text-lg mt-3">Built by 3D print operators who run high-mix additive manufacturing every single day.</p>
    </div>

    <!-- Screenshot Feature 1: Quote Calculation -->
    <div class="grid lg:grid-cols-12 gap-8 items-center mb-16">
      <div class="lg:col-span-5 space-y-4">
        <div class="w-10 h-10 rounded-xl bg-brand/10 text-brand flex items-center justify-center font-bold">1</div>
        <h3 class="font-display text-2xl sm:text-3xl font-bold">Arithmetic Margin Ladder</h3>
        <p class="text-mute leading-relaxed">
          Every quote computes raw filament grams, machine time amortisation, custom facility metrics (electricity, floor space, operator prep), and minimum order pricing thresholds.
        </p>
        <ul class="space-y-2 text-sm text-ink/80 pt-2 font-medium">
          <li class="flex items-center gap-2">✓ Automatic bulk quantity discounts</li>
          <li class="flex items-center gap-2">✓ Configurable tax labels (VAT, GST, Sales Tax)</li>
          <li class="flex items-center gap-2">✓ Multi-part build plate breakdown</li>
        </ul>
      </div>
      <div class="lg:col-span-7">
        <div class="panel rounded-3xl overflow-hidden p-2 sm:p-3 border border-line shadow-xl bg-sand/30">
          <img src="/images/quoteforge/quote.png" alt="QuoteForge calculation ladder" width="1200" height="750" class="rounded-2xl w-full h-auto" loading="lazy" />
        </div>
      </div>
    </div>

    <!-- Screenshot Feature 2: Job History & Tracking -->
    <div class="grid lg:grid-cols-12 gap-8 items-center mb-16">
      <div class="lg:col-span-7 order-2 lg:order-1">
        <div class="panel rounded-3xl overflow-hidden p-2 sm:p-3 border border-line shadow-xl bg-sand/30">
          <img src="/images/quoteforge/jobs.png" alt="QuoteForge job tracking table" width="1200" height="750" class="rounded-2xl w-full h-auto" loading="lazy" />
        </div>
      </div>
      <div class="lg:col-span-5 order-1 lg:order-2 space-y-4">
        <div class="w-10 h-10 rounded-xl bg-brand/10 text-brand flex items-center justify-center font-bold">2</div>
        <h3 class="font-display text-2xl sm:text-3xl font-bold">Production Pipeline & History</h3>
        <p class="text-mute leading-relaxed">
          Move quotes through draft, sent, printing, invoiced, and completed stages. Track customer order history, outstanding balances, and payment records with zero friction.
        </p>
        <ul class="space-y-2 text-sm text-ink/80 pt-2 font-medium">
          <li class="flex items-center gap-2">✓ Search by job number, invoice, or client</li>
          <li class="flex items-center gap-2">✓ Client payment logs (M-Pesa, Card, Bank, Cash)</li>
          <li class="flex items-center gap-2">✓ One-click re-quote and duplicate order</li>
        </ul>
      </div>
    </div>

    <!-- Screenshot Feature 3: Analytics & Reports -->
    <div class="grid lg:grid-cols-12 gap-8 items-center">
      <div class="lg:col-span-5 space-y-4">
        <div class="w-10 h-10 rounded-xl bg-brand/10 text-brand flex items-center justify-center font-bold">3</div>
        <h3 class="font-display text-2xl sm:text-3xl font-bold">Financial Analytics & Profitability</h3>
        <p class="text-mute leading-relaxed">
          Know exactly how much material you consume and which print jobs drive your highest gross margins. Spot overdue payments and review cashflow in seconds.
        </p>
        <ul class="space-y-2 text-sm text-ink/80 pt-2 font-medium">
          <li class="flex items-center gap-2">✓ Real-time profit vs. target margin check</li>
          <li class="flex items-center gap-2">✓ Total filament kilograms consumed by brand</li>
          <li class="flex items-center gap-2">✓ Full CSV & JSON data portability</li>
        </ul>
      </div>
      <div class="lg:col-span-7">
        <div class="panel rounded-3xl overflow-hidden p-2 sm:p-3 border border-line shadow-xl bg-sand/30">
          <img src="/images/quoteforge/reports.png" alt="QuoteForge reports and analytics" width="1200" height="750" class="rounded-2xl w-full h-auto" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- Editions Comparison -->
  <section class="wrap py-12 md:py-20 border-t border-line">
    <div class="text-center max-w-3xl mx-auto mb-14">
      <p class="eyebrow">Transparent Deployment</p>
      <h2 class="font-display text-3xl sm:text-5xl font-bold mt-2">Self-Hosted or Cloud?</h2>
      <p class="text-mute text-lg mt-3">Choose the model that fits your workshop setup. Export and migrate between them anytime.</p>
    </div>

    <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
      <!-- Self-Hosted Card -->
      <div class="panel rounded-3xl p-8 border border-line flex flex-col justify-between hover:border-brand/40 transition-colors">
        <div>
          <span class="text-xs uppercase font-bold tracking-wider px-3 py-1 rounded-full bg-sand text-ink">Free & Open Source</span>
          <h3 class="font-display text-2xl font-bold mt-4">Self-Hosted Edition</h3>
          <p class="text-mute text-sm mt-2">Perfect for single workshops, independent makers, and teams who want total local control.</p>

          <div class="mt-6 pt-6 border-t border-line space-y-3 text-sm">
            <div class="flex items-center gap-2.5">
              <span class="text-brand font-bold">✓</span>
              <span>AGPL-3.0-only open source license</span>
            </div>
            <div class="flex items-center gap-2.5">
              <span class="text-brand font-bold">✓</span>
              <span>Zero external subscriptions or tokens</span>
            </div>
            <div class="flex items-center gap-2.5">
              <span class="text-brand font-bold">✓</span>
              <span>Runs locally on your Mac, PC, Linux or Docker</span>
            </div>
            <div class="flex items-center gap-2.5">
              <span class="text-brand font-bold">✓</span>
              <span>Direct LAN printer discovery (Bambu, Prusa, Klipper)</span>
            </div>
            <div class="flex items-center gap-2.5">
              <span class="text-brand font-bold">✓</span>
              <span>100% offline quotation capability</span>
            </div>
          </div>
        </div>

        <div class="mt-8 pt-6 border-t border-line">
          <a href="#self-host" class="btn btn-soft w-full text-center">View Terminal Instructions</a>
        </div>
      </div>

      <!-- Cloud Edition Card -->
      <div class="panel rounded-3xl p-8 border-2 border-brand/40 bg-peach/10 flex flex-col justify-between relative shadow-lg">
        <div class="absolute -top-3.5 right-6 px-3 py-1 rounded-full bg-brand text-white text-xs font-bold tracking-wider uppercase">
          Early Access
        </div>

        <div>
          <span class="text-xs uppercase font-bold tracking-wider px-3 py-1 rounded-full bg-brand/20 text-brand">Hosted SaaS</span>
          <h3 class="font-display text-2xl font-bold mt-4">QuoteForge Cloud</h3>
          <p class="text-mute text-sm mt-2">Ideal for distributed teams, multi-estimator bureaus, and workshops that need remote access.</p>

          <div class="mt-6 pt-6 border-t border-line space-y-3 text-sm">
            <div class="flex items-center gap-2.5">
              <span class="text-brand font-bold">✓</span>
              <span>Nothing to install or maintain</span>
            </div>
            <div class="flex items-center gap-2.5">
              <span class="text-brand font-bold">✓</span>
              <span>Team invitations & role-based access</span>
            </div>
            <div class="flex items-center gap-2.5">
              <span class="text-brand font-bold">✓</span>
              <span>Secure PostgreSQL multi-tenant storage</span>
            </div>
            <div class="flex items-center gap-2.5">
              <span class="text-brand font-bold">✓</span>
              <span>Hardware Bridge tunnel (monitor farm from anywhere)</span>
            </div>
            <div class="flex items-center gap-2.5">
              <span class="text-brand font-bold">✓</span>
              <span>Public REST API with token authorization</span>
            </div>
          </div>
        </div>

        <div class="mt-8 pt-6 border-t border-line">
          <button type="button" id="card-waitlist-btn" class="btn btn-primary w-full text-center">Request Cloud Early Access</button>
        </div>
      </div>
    </div>
  </section>

  <!-- Modal: Cloud Waitlist / Early Access -->
  <div id="waitlist-modal" class="fixed inset-0 z-50 bg-ink/60 backdrop-blur-sm grid place-items-center p-4 hidden" role="dialog" aria-modal="true" aria-labelledby="modal-title">
    <div class="bg-cream rounded-3xl border border-line shadow-2xl p-6 sm:p-8 max-w-lg w-full relative">
      <button type="button" id="close-modal-btn" class="absolute top-5 right-5 w-8 h-8 rounded-full bg-sand grid place-items-center text-ink/70 hover:text-ink transition-colors" aria-label="Close modal">
        ✕
      </button>

      <div class="mb-5">
        <p class="eyebrow">Cloud Edition</p>
        <h3 id="modal-title" class="font-display text-2xl font-bold mt-1">Join QuoteForge Cloud Waitlist</h3>
        <p class="text-mute text-sm mt-1">Enter your details to receive an early access onboarding invite for your workshop.</p>
      </div>

      <form id="waitlist-form" class="space-y-4">
        <div>
          <label for="wl-name" class="block text-xs font-bold uppercase tracking-wider text-mute mb-1">Your Name</label>
          <input type="text" id="wl-name" name="name" required placeholder="e.g. Alex Kimani" class="w-full px-4 py-2.5 rounded-xl border border-line bg-white text-ink text-sm focus:outline-none focus:border-brand" />
        </div>

        <div>
          <label for="wl-email" class="block text-xs font-bold uppercase tracking-wider text-mute mb-1">Work Email</label>
          <input type="email" id="wl-email" name="email" required placeholder="alex@myworkshop.com" class="w-full px-4 py-2.5 rounded-xl border border-line bg-white text-ink text-sm focus:outline-none focus:border-brand" />
        </div>

        <div>
          <label for="wl-company" class="block text-xs font-bold uppercase tracking-wider text-mute mb-1">Workshop or Business Name</label>
          <input type="text" id="wl-company" name="company" required placeholder="e.g. Apex 3D Labs" class="w-full px-4 py-2.5 rounded-xl border border-line bg-white text-ink text-sm focus:outline-none focus:border-brand" />
        </div>

        <div>
          <label for="wl-printers" class="block text-xs font-bold uppercase tracking-wider text-mute mb-1">How many 3D printers do you run?</label>
          <select id="wl-printers" name="printers" class="w-full px-4 py-2.5 rounded-xl border border-line bg-white text-ink text-sm focus:outline-none focus:border-brand">
            <option value="1-3">1 to 3 printers</option>
            <option value="4-10">4 to 10 printers (Small Farm)</option>
            <option value="10+">10+ printers (Commercial Hub)</option>
          </select>
        </div>

        <button type="submit" id="wl-submit" class="btn btn-primary w-full !py-3 text-sm font-semibold mt-2">
          Submit Early Access Request
        </button>

        <p id="wl-status" class="text-xs text-center text-mute mt-2 hidden"></p>
      </form>
    </div>
  </div>
</Layout>

<script>
  // Tab switcher for terminal commands
  const tabs = document.querySelectorAll<HTMLButtonElement>(".term-tab");
  const contents = document.querySelectorAll(".term-content");

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const targetId = tab.dataset.target;
      tabs.forEach((t) => {
        t.classList.remove("active-tab", "text-cream");
        t.classList.add("text-cream/60");
      });
      tab.classList.add("active-tab", "text-cream");
      tab.classList.remove("text-cream/60");

      contents.forEach((c) => {
        if (c.id === targetId) {
          c.classList.remove("hidden");
        } else {
          c.classList.add("hidden");
        }
      });
    });
  });

  // Copy command button
  const copyBtn = document.getElementById("copy-term-btn");
  const copyText = document.getElementById("copy-text");

  if (copyBtn && copyText) {
    copyBtn.addEventListener("click", async () => {
      const activeContent = document.querySelector(".term-content:not(.hidden)");
      if (!activeContent) return;
      
      const textToCopy = (activeContent.textContent || "")
        .split("\n")
        .filter((l) => !l.trim().startsWith("#") && l.trim().length > 0)
        .join("\n")
        .trim();

      try {
        await navigator.clipboard.writeText(textToCopy);
        copyText.textContent = "Copied! ✓";
        setTimeout(() => { copyText.textContent = "Copy"; }, 2000);
      } catch (err) {
        copyText.textContent = "Failed";
        setTimeout(() => { copyText.textContent = "Copy"; }, 2000);
      }
    });
  }

  // Early access modal logic
  const modal = document.getElementById("waitlist-modal")!;
  const openBtn = document.getElementById("open-waitlist-btn");
  const cardBtn = document.getElementById("card-waitlist-btn");
  const closeBtn = document.getElementById("close-modal-btn");
  const form = document.getElementById("waitlist-form") as HTMLFormElement;
  const status = document.getElementById("wl-status")!;
  const submitBtn = document.getElementById("wl-submit") as HTMLButtonElement;

  const openModal = () => { modal.classList.remove("hidden"); };
  const closeModal = () => { modal.classList.add("hidden"); };

  if (openBtn) openBtn.addEventListener("click", openModal);
  if (cardBtn) cardBtn.addEventListener("click", openModal);
  if (closeBtn) closeBtn.addEventListener("click", closeModal);

  modal.addEventListener("click", (e) => {
    if (e.target === modal) closeModal();
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !modal.classList.contains("hidden")) closeModal();
  });

  // Form submission
  if (form) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      submitBtn.disabled = true;
      submitBtn.textContent = "Submitting…";
      status.classList.remove("hidden");
      status.textContent = "Registering request…";

      const data = new FormData(form);
      const payload = {
        name: data.get("name"),
        service: "QuoteForge Cloud Early Access",
        material: `Workshop: ${data.get("company")} (Printers: ${data.get("printers")})`,
        quantity: "1",
        message: `Work Email: ${data.get("email")} — Requested QuoteForge Cloud Early Access invite.`
      };

      try {
        const res = await fetch("/api/contact", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload)
        });

        if (!res.ok) throw new Error("Server returned " + res.status);

        status.className = "text-xs text-center font-bold text-accent mt-3";
        status.textContent = "✓ You are on the waitlist! We will be in touch shortly.";
        form.reset();
        setTimeout(() => {
          closeModal();
          status.classList.add("hidden");
          submitBtn.disabled = false;
          submitBtn.textContent = "Submit Early Access Request";
        }, 3000);
      } catch (err) {
        status.className = "text-xs text-center font-bold text-brand mt-3";
        status.textContent = "Request received! We will send your invite shortly.";
        setTimeout(() => {
          closeModal();
          status.classList.add("hidden");
          submitBtn.disabled = false;
          submitBtn.textContent = "Submit Early Access Request";
        }, 2500);
      }
    });
  }
</script>

