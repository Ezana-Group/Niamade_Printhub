  <!-- Modal: Cloud Waitlist / Early Access -->
  <div id="waitlist-modal" class="fixed inset-0 z-50 bg-ink/70 backdrop-blur-sm hidden items-center justify-center p-4" role="dialog" aria-modal="true" aria-labelledby="modal-title">
