---
// Cache and Service Worker reset utility
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Resetting PrintHub CMS Cache...</title>
  <meta name="robots" content="noindex, nofollow">
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background: #0f172a;
      color: #f8fafc;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      margin: 0;
      text-align: center;
      padding: 20px;
    }
    .spinner {
      width: 48px;
      height: 48px;
      border: 4px solid #334155;
      border-top-color: #38bdf8;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
      margin-bottom: 24px;
    }
    @keyframes spin {
      to { transform: rotate(360deg); }
    }
    h1 { font-size: 22px; margin-bottom: 8px; font-weight: 700; }
    p { font-size: 15px; color: #94a3b8; max-width: 450px; line-height: 1.5; }
    .btn {
      display: inline-block;
      margin-top: 20px;
      padding: 12px 24px;
      background: #0284c7;
      color: white;
      text-decoration: none;
      border-radius: 8px;
      font-weight: 600;
      font-size: 15px;
    }
    .btn:hover {
      background: #0369a1;
    }
  </style>
</head>
<body>
  <div class="spinner" id="spinner"></div>
  <h1 id="title">Wiping Old CMS Cache & Service Workers...</h1>
  <p id="status">Clearing background workers and cached files. Please wait a second...</p>
  <a id="btn" class="btn" style="display:none;" href="/admin/">Open Sanity Studio Now</a>

  <script is:inline>
    async function resetEverything() {
      const status = document.getElementById('status');
      const title = document.getElementById('title');
      const spinner = document.getElementById('spinner');
      const btn = document.getElementById('btn');

      try {
        // 1. Unregister all service workers on printhub.africa
        if ('serviceWorker' in navigator) {
          const regs = await navigator.serviceWorker.getRegistrations();
          for (let r of regs) {
            await r.unregister();
          }
        }

        // 2. Clear all CacheStorage
        if ('caches' in window) {
          const keys = await caches.keys();
          for (let k of keys) {
            await caches.delete(k);
          }
        }

        // 3. Clear Sveltia & Decap local storage items
        try {
          localStorage.removeItem('sveltia-cms.user');
          localStorage.removeItem('decap-cms-user');
          localStorage.removeItem('netlify-cms-user');
          for (let key of Object.keys(localStorage)) {
            if (key.includes('sveltia') || key.includes('decap') || key.includes('netlify')) {
              localStorage.removeItem(key);
            }
          }
        } catch(e) {}

        if (title) title.textContent = "Done! Redirecting to Sanity Studio...";
        if (status) status.textContent = "Old Sveltia CMS worker has been completely removed.";

        setTimeout(() => {
          window.location.replace('/admin/');
        }, 1200);
      } catch (err) {
        if (title) title.textContent = "Cache Cleared!";
        if (status) status.textContent = "Click below to open Sanity Studio.";
        if (spinner) spinner.style.display = 'none';
        if (btn) btn.style.display = 'inline-block';
      }
    }

    resetEverything();
  </script>
</body>
</html>
