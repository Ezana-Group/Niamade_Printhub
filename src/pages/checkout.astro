---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import { site, products, price, wa } from "../data/site";

// Prepare products dictionary for client hydration
const productsData = products.map((p: any) => ({
  slug: p.slug,
  name: p.name,
  priceStr: p.price,
  priceNum: price(p.price) || 0,
  photo: p.photos && p.photos.length ? p.photos[0] : null,
  cat: p.cat || "",
  sizes: p.sizes || [],
  colours: p.colours || [],
  customPrompt: p.customizationPrompt || "",
}));

const deliveryRates = site.deliveryRates || [];
const courierRates = deliveryRates.filter((r: any) => !r.isPickup);
const pickupRate = deliveryRates.find((r: any) => r.isPickup) || { city: "Eldoret Studio Pickup (Free)", fee: 0, estimatedDays: "Ready in 24–48h" };

const hasManualMpesa = Boolean(site.mpesaTillNumber || site.mpesaPaybillNumber);
---
<Layout
  title="Checkout | PrintHub Africa"
  description="Secure checkout for your PrintHub Africa 3D printed piece. Instant M-Pesa STK Push or card payment, hand-printed in Eldoret."
  robots="noindex, nofollow"
>
  <div class="wrap pt-8 pb-24 max-w-6xl mx-auto">
    <!-- Breadcrumb & Trust Banner -->
    <div class="flex flex-wrap items-center justify-between gap-4 mb-8">
      <nav aria-label="Breadcrumb" class="text-sm sm:text-base text-mute flex items-center gap-2">
        <a href="/" class="hover:text-brand transition-colors font-medium">Home</a>
        <span aria-hidden="true" class="text-line">/</span>
        <a href="/shop/" class="hover:text-brand transition-colors font-medium">Shop</a>
        <span aria-hidden="true" class="text-line">/</span>
        <span class="text-ink font-bold">Checkout</span>
      </nav>
      <div class="flex items-center gap-2 text-xs sm:text-sm text-ink/80 bg-sand/60 px-4 py-2 rounded-full border border-line">
        <span class="inline-block w-2.5 h-2.5 rounded-full bg-emerald-500 shrink-0"></span>
        <span class="font-medium">Secure 256-Bit Encrypted Checkout</span>
      </div>
    </div>

    <!-- Header -->
    <div class="mb-8 sm:mb-10">
      <p class="eyebrow text-brand font-bold uppercase tracking-wider text-xs sm:text-sm">Quick & Secure Checkout</p>
      <h1 class="font-display text-3xl sm:text-4xl md:text-5xl mt-1.5 font-bold text-ink">
        Complete your order
      </h1>
      <p class="text-mute mt-2.5 text-base sm:text-lg max-w-2xl leading-relaxed">
        Follow the steps below to enter your delivery address and pay securely via M-Pesa or Card.
      </p>
    </div>

    <!-- Main Two-Column Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">
      
      <!-- LEFT: Accordion Steps (7 cols) -->
      <div class="lg:col-span-7 space-y-6">
        
        <form id="checkout-page-form" novalidate class="space-y-6">
          
          <!-- STEP 1: Contact Information -->
          <div id="step-card-1" class="step-card panel p-6 sm:p-8 bg-card border-2 border-brand rounded-3xl shadow-sm transition-all">
            <!-- Header (Always visible) -->
            <div class="flex items-center justify-between gap-4">
              <div class="flex items-center gap-3.5">
                <span id="badge-step-1" class="w-9 h-9 rounded-full bg-brand text-cream font-bold text-base flex items-center justify-center shrink-0 shadow-xs">
                  1
                </span>
                <div>
                  <h2 class="font-display text-xl sm:text-2xl font-bold text-ink">Your Contact Information</h2>
                  <p id="summary-step-1" class="text-sm sm:text-base text-mute mt-0.5 hidden font-medium"></p>
                </div>
              </div>
              <button
                type="button"
                id="edit-step-1"
                class="hidden text-sm sm:text-base font-bold text-brand hover:underline px-3 py-1.5 rounded-xl hover:bg-sand/60 transition-colors"
              >
                Change
              </button>
            </div>

            <!-- Body (Collapsible) -->
            <div id="body-step-1" class="mt-6 pt-5 border-t border-line/70 space-y-5">
              <div>
                <label for="cust-name" class="block text-base font-bold text-ink mb-1.5">
                  Full Name <span class="text-brand">*</span>
                </label>
                <input
                  type="text"
                  id="cust-name"
                  name="name"
                  required
                  placeholder="e.g. Amina Waweru"
                  class="w-full rounded-2xl border border-line bg-white px-4 py-3.5 text-base text-ink placeholder:text-mute/70 focus:outline-none focus:ring-2 focus:ring-brand shadow-xs"
                />
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                  <label for="cust-email" class="block text-base font-bold text-ink mb-1.5">
                    Email Address <span class="text-brand">*</span>
                  </label>
                  <input
                    type="email"
                    id="cust-email"
                    name="email"
                    required
                    placeholder="e.g. amina@example.com"
                    class="w-full rounded-2xl border border-line bg-white px-4 py-3.5 text-base text-ink placeholder:text-mute/70 focus:outline-none focus:ring-2 focus:ring-brand shadow-xs"
                  />
                  <p class="mt-1.5 text-xs sm:text-sm text-mute">Receipt and printing updates will be sent here.</p>
                </div>

                <div>
                  <label for="cust-phone" class="block text-base font-bold text-ink mb-1.5">
                    Phone / M-Pesa Number <span class="text-brand">*</span>
                  </label>
                  <input
                    type="tel"
                    id="cust-phone"
                    name="phone"
                    required
                    placeholder="e.g. 0712 345 678"
                    class="w-full rounded-2xl border border-line bg-white px-4 py-3.5 text-base text-ink placeholder:text-mute/70 focus:outline-none focus:ring-2 focus:ring-brand shadow-xs"
                  />
                  <p class="mt-1.5 text-xs sm:text-sm text-mute">Your phone will receive the M-Pesa PIN prompt.</p>
                </div>
              </div>

              <!-- Step 1 Button -->
              <div class="pt-3">
                <button
                  type="button"
                  id="btn-goto-step-2"
                  class="btn !bg-brand !text-cream hover:!bg-brand/90 font-bold text-base px-6 py-3.5 rounded-2xl flex items-center justify-center gap-2 shadow-sm"
                >
                  <span>Continue to Delivery Details</span>
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                </button>
              </div>
            </div>
          </div>

          <!-- STEP 2: Delivery & Address -->
          <div id="step-card-2" class="step-card panel p-6 sm:p-8 bg-card border border-line rounded-3xl shadow-xs transition-all opacity-90">
            <!-- Header (Always visible) -->
            <div class="flex items-center justify-between gap-4">
              <div class="flex items-center gap-3.5">
                <span id="badge-step-2" class="w-9 h-9 rounded-full bg-sand text-ink font-bold text-base flex items-center justify-center shrink-0">
                  2
                </span>
                <div>
                  <h2 class="font-display text-xl sm:text-2xl font-bold text-ink">Delivery Address & Pricing</h2>
                  <p id="summary-step-2" class="text-sm sm:text-base text-mute mt-0.5 hidden font-medium"></p>
                </div>
              </div>
              <button
                type="button"
                id="edit-step-2"
                class="hidden text-sm sm:text-base font-bold text-brand hover:underline px-3 py-1.5 rounded-xl hover:bg-sand/60 transition-colors"
              >
                Change
              </button>
            </div>

            <!-- Body (Collapsible) -->
            <div id="body-step-2" class="hidden mt-6 pt-5 border-t border-line/70 space-y-6">
              
              <!-- Delivery Type Selector -->
              <div>
                <label class="block text-base font-bold text-ink mb-2.5">
                  How would you like to receive your item?
                </label>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                  <label class="delivery-option-card relative flex items-start gap-3 p-4 rounded-2xl border-2 border-brand bg-brand/5 cursor-pointer transition-all">
                    <input type="radio" name="delivery_type" value="courier" checked class="mt-1 accent-brand w-4 h-4" />
                    <div>
                      <p class="font-bold text-ink text-base">Courier Delivery</p>
                      <p class="text-xs sm:text-sm text-mute mt-0.5">Delivered to your doorstep or pickup point across Kenya.</p>
                    </div>
                  </label>

                  <label class="delivery-option-card relative flex items-start gap-3 p-4 rounded-2xl border border-line bg-white hover:bg-sand/30 cursor-pointer transition-all">
                    <input type="radio" name="delivery_type" value="pickup" class="mt-1 accent-brand w-4 h-4" />
                    <div>
                      <p class="font-bold text-ink text-base">Free Eldoret Studio Pickup</p>
                      <p class="text-xs sm:text-sm text-mute mt-0.5">Collect directly from our Eldoret studio at zero cost.</p>
                    </div>
                  </label>
                </div>
              </div>

              <!-- Address Fields (Shown for Courier) -->
              <div id="courier-fields-wrap" class="space-y-4 pt-1">
                
                <!-- City / Regional Shipping Zone (Managed in Sanity) -->
                <div>
                  <label for="del-zone-select" class="block text-base font-bold text-ink mb-1.5">
                    Select Your Delivery City / Region <span class="text-brand">*</span>
                  </label>
                  <select
                    id="del-zone-select"
                    name="delivery_zone"
                    class="w-full rounded-2xl border border-line bg-white px-4 py-3.5 text-base text-ink focus:outline-none focus:ring-2 focus:ring-brand shadow-xs"
                  >
                    {courierRates.map((r: any) => (
                      <option value={r.city} data-fee={r.fee} data-days={r.estimatedDays || ""}>
                        {r.city} — KES {r.fee.toLocaleString()} {r.estimatedDays ? `(${r.estimatedDays})` : ""}
                      </option>
                    ))}
                  </select>
                  <p class="mt-1.5 text-xs sm:text-sm text-mute">Delivery rates are configured per city & county.</p>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <div>
                    <label for="del-town" class="block text-base font-bold text-ink mb-1.5">
                      Specific Town / Sub-County <span class="text-brand">*</span>
                    </label>
                    <input
                      type="text"
                      id="del-town"
                      name="delivery_town"
                      placeholder="e.g. Westlands, Nyali, Milimani"
                      class="w-full rounded-2xl border border-line bg-white px-4 py-3.5 text-base text-ink placeholder:text-mute/70 focus:outline-none focus:ring-2 focus:ring-brand shadow-xs"
                    />
                  </div>

                  <div>
                    <label for="del-area" class="block text-base font-bold text-ink mb-1.5">
                      Estate / Street / Road <span class="text-brand">*</span>
                    </label>
                    <input
                      type="text"
                      id="del-area"
                      name="delivery_area"
                      placeholder="e.g. Mpaka Rd, Kilimani Ring Rd"
                      class="w-full rounded-2xl border border-line bg-white px-4 py-3.5 text-base text-ink placeholder:text-mute/70 focus:outline-none focus:ring-2 focus:ring-brand shadow-xs"
                    />
                  </div>
                </div>

                <div>
                  <label for="del-address" class="block text-base font-bold text-ink mb-1.5">
                    Building, Apartment, Floor or Gate Details <span class="text-brand">*</span>
                  </label>
                  <input
                    type="text"
                    id="del-address"
                    name="delivery_address"
                    placeholder="e.g. Woodvale Place, 3rd Floor, Suite 4B (or House #7)"
                    class="w-full rounded-2xl border border-line bg-white px-4 py-3.5 text-base text-ink placeholder:text-mute/70 focus:outline-none focus:ring-2 focus:ring-brand shadow-xs"
                  />
                </div>

                <div>
                  <label for="del-landmark" class="block text-base font-bold text-ink mb-1.5">
                    Nearby Landmark or Delivery Instructions (Optional)
                  </label>
                  <input
                    type="text"
                    id="del-landmark"
                    name="delivery_landmark"
                    placeholder="e.g. Opposite Shell Petrol Station, call upon arrival"
                    class="w-full rounded-2xl border border-line bg-white px-4 py-3.5 text-base text-ink placeholder:text-mute/70 focus:outline-none focus:ring-2 focus:ring-brand shadow-xs"
                  />
                </div>
              </div>

              <!-- Pickup info note (Shown for Studio Pickup) -->
              <div id="pickup-info-wrap" class="hidden p-4 rounded-2xl bg-sand/60 border border-line text-sm text-ink space-y-1">
                <p class="font-bold text-base text-brand">📍 PrintHub Africa Studio Pickup — KES 0 (FREE)</p>
                <p class="text-ink/80 text-sm">Niamade Hub, Eldoret, Uasin Gishu County, Kenya.</p>
                <p class="text-mute text-xs">Hours: Mon–Fri 8:00 AM – 6:00 PM · Sat 9:00 AM – 3:00 PM · {pickupRate.estimatedDays || "Ready in 24–48h"}</p>
              </div>

              <!-- Customisation / 3D Print Request Note -->
              <div class="pt-2">
                <label for="cust-custom" class="block text-base font-bold text-ink mb-1.5">
                  Personalisation / Custom Note (Optional)
                </label>
                <input
                  type="text"
                  id="cust-custom"
                  name="custom"
                  placeholder="e.g. Engrave name 'Kiprono', or preference for matte finish"
                  class="w-full rounded-2xl border border-line bg-white px-4 py-3.5 text-base text-ink placeholder:text-mute/70 focus:outline-none focus:ring-2 focus:ring-brand shadow-xs"
                />
                <p class="mt-1.5 text-xs sm:text-sm text-mute">Any special printing instructions, text engravings, or colour preferences.</p>
              </div>

              <!-- Step 2 Button -->
              <div class="pt-3">
                <button
                  type="button"
                  id="btn-goto-step-3"
                  class="btn !bg-brand !text-cream hover:!bg-brand/90 font-bold text-base px-6 py-3.5 rounded-2xl flex items-center justify-center gap-2 shadow-sm"
                >
                  <span>Continue to Payment Method</span>
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                </button>
              </div>
            </div>
          </div>

          <!-- STEP 3: Payment Method -->
          <div id="step-card-3" class="step-card panel p-6 sm:p-8 bg-card border border-line rounded-3xl shadow-xs transition-all opacity-90">
            <!-- Header (Always visible) -->
            <div class="flex items-center justify-between gap-4">
              <div class="flex items-center gap-3.5">
                <span id="badge-step-3" class="w-9 h-9 rounded-full bg-sand text-ink font-bold text-base flex items-center justify-center shrink-0">
                  3
                </span>
                <div>
                  <h2 class="font-display text-xl sm:text-2xl font-bold text-ink">Choose Payment Method</h2>
                  <p id="summary-step-3" class="text-sm sm:text-base text-mute mt-0.5 hidden font-medium"></p>
                </div>
              </div>
            </div>

            <!-- Body (Collapsible) -->
            <div id="body-step-3" class="hidden mt-6 pt-5 border-t border-line/70 space-y-6">
              
              <!-- Payment Options -->
              <div class="space-y-4">
                
                <!-- Option A: Paystack Instant STK Push & Card (Default) -->
                <label class="payment-card relative block p-5 rounded-2xl border-2 border-brand bg-brand/5 cursor-pointer transition-all shadow-xs">
                  <div class="flex items-start justify-between gap-3">
                    <div class="flex items-start gap-3.5">
                      <input
                        type="radio"
                        name="payment_choice"
                        value="paystack"
                        checked
                        class="mt-1.5 accent-brand w-5 h-5"
                      />
                      <div>
                        <p class="font-bold text-ink text-base sm:text-lg flex items-center gap-2">
                          Instant M-Pesa STK Push & Card
                          <span class="text-xs bg-emerald-600 text-white font-bold px-2.5 py-0.5 rounded-full uppercase tracking-wider">Fastest</span>
                        </p>
                        <p class="text-sm text-ink/75 mt-1 leading-relaxed">
                          Enter your PIN on your phone to complete payment immediately. Also accepts Visa, Mastercard, and Apple Pay.
                        </p>
                      </div>
                    </div>
                  </div>
                </label>

                <!-- Option B: Manual M-Pesa Till / Paybill (If configured in Sanity) -->
                {hasManualMpesa && (
                  <label class="payment-card relative block p-5 rounded-2xl border border-line bg-white hover:bg-sand/30 cursor-pointer transition-all shadow-xs">
                    <div class="flex items-start justify-between gap-3">
                      <div class="flex items-start gap-3.5">
                        <input
                          type="radio"
                          name="payment_choice"
                          value="manual"
                          class="mt-1.5 accent-brand w-5 h-5"
                        />
                        <div>
                          <p class="font-bold text-ink text-base sm:text-lg">
                            Pay Manually via M-Pesa Till / Paybill
                          </p>
                          <p class="text-sm text-ink/75 mt-1 leading-relaxed">
                            Send payment directly from your M-Pesa menu and confirm with our team on WhatsApp.
                          </p>
                        </div>
                      </div>
                    </div>

                    <!-- Collapsed Manual Details -->
                    <div id="manual-details-box" class="hidden mt-4 pt-4 border-t border-line space-y-3">
                      {site.mpesaTillNumber && (
                        <div class="bg-sand/70 p-4 rounded-xl text-sm space-y-1.5">
                          <div class="flex justify-between items-center">
                            <span class="text-mute font-medium">Buy Goods Till:</span>
                            <span class="font-mono font-bold text-ink text-lg">{site.mpesaTillNumber}</span>
                          </div>
                          <div class="flex justify-between items-center">
                            <span class="text-mute font-medium">Business Name:</span>
                            <span class="font-semibold text-ink">{site.mpesaBusinessName || "NIAMADE HUB"}</span>
                          </div>
                        </div>
                      )}

                      {site.mpesaPaybillNumber && (
                        <div class="bg-sand/70 p-4 rounded-xl text-sm space-y-1.5">
                          <div class="flex justify-between items-center">
                            <span class="text-mute font-medium">Paybill Number:</span>
                            <span class="font-mono font-bold text-ink text-lg">{site.mpesaPaybillNumber}</span>
                          </div>
                          {site.mpesaAccountName && (
                            <div class="flex justify-between items-center">
                              <span class="text-mute font-medium">Account Name:</span>
                              <span class="font-semibold text-ink">{site.mpesaAccountName}</span>
                            </div>
                          )}
                        </div>
                      )}

                      <p class="text-xs sm:text-sm text-mute leading-relaxed">
                        After sending, click the button below to open WhatsApp with your order details pre-filled and paste your M-Pesa confirmation SMS.
                      </p>
                    </div>
                  </label>
                )}
              </div>

              <!-- Error Alert -->
              <div id="checkout-error" class="hidden p-4 rounded-2xl bg-red-50 border border-red-200 text-red-700 text-sm font-semibold"></div>

              <!-- Final Submit Button -->
              <div class="pt-4">
                <button
                  type="submit"
                  id="checkout-submit-btn"
                  class="btn w-full !bg-brand !text-cream hover:!bg-brand/90 font-bold text-lg sm:text-xl py-4 sm:py-5 rounded-2xl flex items-center justify-center gap-3 shadow-md hover:shadow-lg transition-all"
                >
                  <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                  </svg>
                  <span id="submit-btn-text">Pay with M-Pesa / Card</span>
                </button>
                <p class="text-center text-xs sm:text-sm text-mute mt-3.5 flex items-center justify-center gap-1.5">
                  <span>🔒 Handled securely by Paystack. PrintHub never stores your M-Pesa PIN or card details.</span>
                </p>
              </div>

            </div>
          </div>

        </form>
      </div>

      <!-- RIGHT: Sticky Order Summary Sidebar (5 cols) -->
      <div class="lg:col-span-5">
        <aside class="panel p-6 sm:p-8 bg-sand/40 border border-line rounded-3xl sticky top-24 space-y-6">
          <h2 class="font-display text-2xl font-bold text-ink pb-3 border-b border-line/70">
            Order Summary
          </h2>

          <!-- Selected Product Card -->
          <div class="flex items-start gap-4">
            <div id="summary-img-wrap" class="w-24 h-24 rounded-2xl bg-card border border-line overflow-hidden shrink-0 grid place-items-center shadow-xs">
              <img id="summary-img" src="" alt="Product" class="w-full h-full object-cover hidden" />
              <div id="summary-img-fallback" class="text-3xl text-brand font-bold">📦</div>
            </div>
            <div class="flex-1 min-w-0">
              <h3 id="summary-title" class="font-display text-lg sm:text-xl font-bold text-ink leading-snug truncate">
                Select a product
              </h3>
              <p id="summary-variant-line" class="text-sm text-mute mt-1 truncate font-medium">
                Standard specifications
              </p>
              <div class="flex items-center gap-3 mt-3">
                <span class="text-sm font-medium text-mute">Quantity:</span>
                <div class="inline-flex items-center rounded-xl border border-line bg-white shadow-xs">
                  <button type="button" id="qty-minus" class="w-8 h-8 flex items-center justify-center text-ink hover:bg-sand rounded-l-xl transition-colors font-bold text-base">−</button>
                  <span id="qty-val" class="w-9 text-center text-base font-bold text-ink">1</span>
                  <button type="button" id="qty-plus" class="w-8 h-8 flex items-center justify-center text-ink hover:bg-sand rounded-r-xl transition-colors font-bold text-base">+</button>
                </div>
              </div>
            </div>
          </div>

          <!-- Price Breakdown Table -->
          <div class="space-y-3.5 pt-4 border-t border-line/70 text-base">
            <div class="flex justify-between items-center text-ink/80">
              <span class="font-medium">Items Subtotal</span>
              <span id="summary-subtotal" class="font-bold text-ink text-base">KES 0</span>
            </div>
            <div class="flex justify-between items-center text-ink/80">
              <span class="font-medium">Delivery Fee</span>
              <span id="summary-delivery-note" class="text-sm font-bold text-ink">
                Free Studio Pickup
              </span>
            </div>
            <div class="pt-4 border-t border-line flex justify-between items-baseline">
              <span class="font-bold text-lg text-ink">Total to Pay</span>
              <span id="summary-total" class="font-display text-3xl sm:text-4xl font-bold text-brand">
                KES 0
              </span>
            </div>
          </div>

          <!-- Trust & Service Guarantees -->
          <div class="pt-4 border-t border-line/70 space-y-3 text-sm text-ink/85">
            <div class="flex items-center gap-3">
              <span class="w-5 h-5 rounded-full bg-brand/10 text-brand font-bold text-xs flex items-center justify-center shrink-0">✓</span>
              <span><strong>Quality inspected:</strong> Calibrated & tested in Eldoret studio</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="w-5 h-5 rounded-full bg-brand/10 text-brand font-bold text-xs flex items-center justify-center shrink-0">✓</span>
              <span><strong>Direct maker updates:</strong> Real-time progress via WhatsApp</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="w-5 h-5 rounded-full bg-brand/10 text-brand font-bold text-xs flex items-center justify-center shrink-0">✓</span>
              <span><strong>Fast turnaround:</strong> Printed and boxed within 24–48 hours</span>
            </div>
          </div>

          <!-- Need Help? -->
          <div class="pt-2 text-center border-t border-line/60">
            <a
              id="summary-wa-help"
              href={wa("Hi PrintHub, I have a question about placing an order on checkout.")}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2 text-sm text-mute hover:text-brand transition-colors font-medium"
            >
              <Icon name="whatsapp" size={16} />
              <span>Need help? Chat with an engineer on WhatsApp</span>
            </a>
          </div>
        </aside>
      </div>

    </div>
  </div>

  <!-- Hidden Paystack & Delivery Configuration Storage -->
  <div
    id="checkout-config"
    data-paystack-key={site.paystackPublicKey || ""}
    data-products={JSON.stringify(productsData)}
    data-delivery-rates={JSON.stringify(deliveryRates)}
    data-whatsapp={site.whatsapp || "254792732929"}
    data-till={site.mpesaTillNumber || ""}
    data-paybill={site.mpesaPaybillNumber || ""}
    data-account={site.mpesaAccountName || ""}
    data-business={site.mpesaBusinessName || "NIAMADE HUB"}
    class="hidden"
  ></div>
</Layout>

<script>
  // ── Load Paystack Inline JS on demand ──────────────────────────────────────────
  function loadPaystackScript(): Promise<void> {
    return new Promise((resolve, reject) => {
      if ((window as any).PaystackPop) { resolve(); return; }
      const s = document.createElement("script");
      s.src = "https://js.paystack.co/v1/inline.js";
      s.onload = () => resolve();
      s.onerror = reject;
      document.head.appendChild(s);
    });
  }

  // ── Client Configuration ───────────────────────────────────────────────────────
  const cfg = document.getElementById("checkout-config");
  const paystackKey = cfg?.dataset.paystackKey || "";
  const whatsappNum = cfg?.dataset.whatsapp || "254792732929";
  
  let productsList: any[] = [];
  let deliveryRatesList: any[] = [];
  try {
    productsList = JSON.parse(cfg?.dataset.products || "[]");
    deliveryRatesList = JSON.parse(cfg?.dataset.deliveryRates || "[]");
  } catch (e) {
    productsList = [];
    deliveryRatesList = [];
  }

  // Parse URL Parameters
  const params = new URLSearchParams(window.location.search);
  const targetSlug = params.get("slug") || "";
  const paramProduct = params.get("product") || "";
  const paramPrice = parseInt(params.get("price") || "0", 10);
  const paramSize = params.get("size") || "";
  const paramColour = params.get("colour") || "";
  const paramCustom = params.get("custom") || "";
  let currentQty = Math.max(1, parseInt(params.get("qty") || "1", 10));

  // Match Product
  const matchedProduct = productsList.find((p) => p.slug === targetSlug);
  const productName = matchedProduct?.name || paramProduct || (targetSlug ? targetSlug.replace(/-/g, " ") : "3D Print Custom Order");
  const unitPrice = matchedProduct?.priceNum || paramPrice || 1000;
  const productPhoto = matchedProduct?.photo || null;

  // Elements
  const elTitle = document.getElementById("summary-title");
  const elVariant = document.getElementById("summary-variant-line");
  const elImg = document.getElementById("summary-img") as HTMLImageElement | null;
  const elImgFallback = document.getElementById("summary-img-fallback");
  const elSubtotal = document.getElementById("summary-subtotal");
  const elDeliveryNote = document.getElementById("summary-delivery-note");
  const elTotal = document.getElementById("summary-total");
  const elQtyVal = document.getElementById("qty-val");
  const btnQtyMinus = document.getElementById("qty-minus");
  const btnQtyPlus = document.getElementById("qty-plus");
  const inputCustom = document.getElementById("cust-custom") as HTMLInputElement | null;
  const form = document.getElementById("checkout-page-form") as HTMLFormElement | null;
  const errorBox = document.getElementById("checkout-error");
  const submitBtn = document.getElementById("checkout-submit-btn") as HTMLButtonElement | null;
  const submitBtnText = document.getElementById("submit-btn-text");

  // Step Cards
  const card1 = document.getElementById("step-card-1");
  const card2 = document.getElementById("step-card-2");
  const card3 = document.getElementById("step-card-3");

  const body1 = document.getElementById("body-step-1");
  const body2 = document.getElementById("body-step-2");
  const body3 = document.getElementById("body-step-3");

  const badge1 = document.getElementById("badge-step-1");
  const badge2 = document.getElementById("badge-step-2");
  const badge3 = document.getElementById("badge-step-3");

  const summary1 = document.getElementById("summary-step-1");
  const summary2 = document.getElementById("summary-step-2");

  const edit1 = document.getElementById("edit-step-1");
  const edit2 = document.getElementById("edit-step-2");

  const btnGoto2 = document.getElementById("btn-goto-step-2");
  const btnGoto3 = document.getElementById("btn-goto-step-3");

  const zoneSelect = document.getElementById("del-zone-select") as HTMLSelectElement | null;

  // Current Delivery Fee Calculation
  function getCurrentDeliveryFee(): { fee: number; city: string } {
    const delType = (document.querySelector('input[name="delivery_type"]:checked') as HTMLInputElement)?.value;
    if (delType === "pickup") {
      return { fee: 0, city: "Eldoret Studio Pickup (Free)" };
    }
    if (zoneSelect && zoneSelect.selectedOptions.length > 0) {
      const opt = zoneSelect.selectedOptions[0];
      const fee = parseInt(opt.dataset.fee || "350", 10);
      return { fee, city: opt.value };
    }
    return { fee: 350, city: "Kenya Courier" };
  }

  // Hydrate Initial Summary
  if (elTitle) elTitle.textContent = productName;
  if (elVariant) {
    const parts = [paramSize ? `Size: ${paramSize}` : "", paramColour ? `Colour: ${paramColour}` : ""].filter(Boolean);
    elVariant.textContent = parts.length ? parts.join(" · ") : "Standard Made-to-Order";
  }
  if (productPhoto && elImg && elImgFallback) {
    elImg.src = productPhoto;
    elImg.classList.remove("hidden");
    elImgFallback.classList.add("hidden");
  }
  if (paramCustom && inputCustom) {
    inputCustom.value = paramCustom;
  }

  function updateTotal() {
    const subtotal = unitPrice * currentQty;
    const { fee: delFee, city: delCity } = getCurrentDeliveryFee();
    const total = subtotal + delFee;

    if (elQtyVal) elQtyVal.textContent = String(currentQty);
    if (elSubtotal) elSubtotal.textContent = `KES ${subtotal.toLocaleString()}`;
    if (elDeliveryNote) {
      elDeliveryNote.textContent = delFee === 0 ? "FREE (Studio Pickup)" : `+ KES ${delFee.toLocaleString()} (${delCity})`;
    }
    if (elTotal) elTotal.textContent = `KES ${total.toLocaleString()}`;

    const methodChoice = (document.querySelector('input[name="payment_choice"]:checked') as HTMLInputElement)?.value;
    if (submitBtnText) {
      if (methodChoice === "manual") {
        submitBtnText.textContent = `Complete Order (KES ${total.toLocaleString()})`;
      } else {
        submitBtnText.textContent = `Pay KES ${total.toLocaleString()} with M-Pesa / Card`;
      }
    }
  }

  btnQtyMinus?.addEventListener("click", () => {
    if (currentQty > 1) { currentQty--; updateTotal(); }
  });
  btnQtyPlus?.addEventListener("click", () => {
    if (currentQty < 50) { currentQty++; updateTotal(); }
  });

  // ── Delivery Option Switching (Courier vs Studio Pickup) ──────────────────────
  const delRadios = document.querySelectorAll<HTMLInputElement>('input[name="delivery_type"]');
  const courierWrap = document.getElementById("courier-fields-wrap");
  const pickupWrap = document.getElementById("pickup-info-wrap");

  delRadios.forEach((r) => {
    r.addEventListener("change", () => {
      document.querySelectorAll(".delivery-option-card").forEach((c) => {
        c.classList.remove("border-2", "border-brand", "bg-brand/5");
        c.classList.add("border", "border-line", "bg-white");
      });
      const parent = r.closest(".delivery-option-card");
      if (parent) {
        parent.classList.remove("border", "border-line", "bg-white");
        parent.classList.add("border-2", "border-brand", "bg-brand/5");
      }

      if (r.value === "pickup") {
        courierWrap?.classList.add("hidden");
        pickupWrap?.classList.remove("hidden");
      } else {
        courierWrap?.classList.remove("hidden");
        pickupWrap?.classList.add("hidden");
      }
      updateTotal();
    });
  });

  // When city zone changes, update delivery fee & total
  zoneSelect?.addEventListener("change", () => {
    updateTotal();
  });

  // ── Rebuild Zone Select dynamically from live Sanity rates ──────────────────
  function rebuildZoneSelect(rates: any[]) {
    if (!zoneSelect) return;
    const courierOnly = rates.filter((r) => !r.isPickup);
    if (courierOnly.length === 0) return;

    zoneSelect.innerHTML = courierOnly
      .map(
        (r) =>
          `<option value="${r.city}" data-fee="${r.fee}" data-days="${r.estimatedDays || ''}">
            ${r.city} — KES ${Number(r.fee).toLocaleString()} ${r.estimatedDays ? `(${r.estimatedDays})` : ''}
          </option>`
      )
      .join('');
  }

  // ── Fetch Live Delivery Rates directly from Sanity Studio API ────────────────
  async function loadLiveDeliveryRates() {
    try {
      const res = await fetch(
        "https://m7x6icn3.api.sanity.io/v2023-08-01/data/query/production?query=*[_type%20==%20%22siteSettings%22][0]{deliveryRates}"
      );
      if (!res.ok) return;
      const { result } = await res.json();
      if (result && Array.isArray(result.deliveryRates) && result.deliveryRates.length > 0) {
        deliveryRatesList = result.deliveryRates;
        rebuildZoneSelect(deliveryRatesList);
        updateTotal();
      }
    } catch (e) {
      // Fallback gracefully to pre-built defaults
    }
  }

  loadLiveDeliveryRates();

  // ── Step 1 -> Step 2 (Amazon-style accordion collapse) ───────────────────────
  btnGoto2?.addEventListener("click", () => {
    const name = (document.getElementById("cust-name") as HTMLInputElement)?.value.trim();
    const email = (document.getElementById("cust-email") as HTMLInputElement)?.value.trim();
    const phone = (document.getElementById("cust-phone") as HTMLInputElement)?.value.trim();

    if (!name) {
      alert("Please enter your Full Name.");
      document.getElementById("cust-name")?.focus();
      return;
    }
    if (!email || !email.includes("@")) {
      alert("Please enter a valid Email Address.");
      document.getElementById("cust-email")?.focus();
      return;
    }
    if (!phone || phone.length < 8) {
      alert("Please enter your Phone / M-Pesa Number.");
      document.getElementById("cust-phone")?.focus();
      return;
    }

    // Collapse Step 1
    body1?.classList.add("hidden");
    if (summary1) {
      summary1.textContent = `${name} · ${phone} · ${email}`;
      summary1.classList.remove("hidden");
    }
    if (badge1) {
      badge1.innerHTML = "✓";
      badge1.classList.remove("bg-brand");
      badge1.classList.add("bg-emerald-600");
    }
    edit1?.classList.remove("hidden");
    card1?.classList.remove("border-2", "border-brand");
    card1?.classList.add("border", "border-line");

    // Open Step 2
    body2?.classList.remove("hidden");
    card2?.classList.remove("border-line", "opacity-90");
    card2?.classList.add("border-2", "border-brand");
    if (badge2) {
      badge2.classList.remove("bg-sand", "text-ink");
      badge2.classList.add("bg-brand", "text-cream");
    }

    // Scroll to Step 2
    card2?.scrollIntoView({ behavior: "smooth", block: "start" });
  });

  // Edit Step 1
  edit1?.addEventListener("click", () => {
    body1?.classList.remove("hidden");
    summary1?.classList.add("hidden");
    edit1?.classList.add("hidden");
    card1?.classList.add("border-2", "border-brand");
    card1?.classList.remove("border-line");
    if (badge1) {
      badge1.textContent = "1";
      badge1.classList.add("bg-brand");
      badge1.classList.remove("bg-emerald-600");
    }
    card1?.scrollIntoView({ behavior: "smooth", block: "start" });
  });

  // ── Step 2 -> Step 3 (Amazon-style accordion collapse) ───────────────────────
  btnGoto3?.addEventListener("click", () => {
    const delType = (document.querySelector('input[name="delivery_type"]:checked') as HTMLInputElement)?.value;
    let delSummaryText = "";

    if (delType === "pickup") {
      delSummaryText = "Free Studio Pickup (Eldoret) — KES 0";
    } else {
      const cityZone = zoneSelect?.value || "Nairobi";
      const town = (document.getElementById("del-town") as HTMLInputElement)?.value.trim();
      const area = (document.getElementById("del-area") as HTMLInputElement)?.value.trim();
      const address = (document.getElementById("del-address") as HTMLInputElement)?.value.trim();

      if (!town) {
        alert("Please enter your Specific Town or Sub-County.");
        document.getElementById("del-town")?.focus();
        return;
      }
      if (!area) {
        alert("Please enter your Estate or Street.");
        document.getElementById("del-area")?.focus();
        return;
      }
      if (!address) {
        alert("Please enter your Building, Floor, or Apartment details.");
        document.getElementById("del-address")?.focus();
        return;
      }
      const { fee: delFee } = getCurrentDeliveryFee();
      delSummaryText = `${cityZone} (${town}, ${area}) · KES ${delFee.toLocaleString()}`;
    }

    const customText = (document.getElementById("cust-custom") as HTMLInputElement)?.value.trim();
    if (customText) {
      delSummaryText += ` · Note: "${customText}"`;
    }

    // Collapse Step 2
    body2?.classList.add("hidden");
    if (summary2) {
      summary2.textContent = delSummaryText;
      summary2.classList.remove("hidden");
    }
    if (badge2) {
      badge2.innerHTML = "✓";
      badge2.classList.remove("bg-brand");
      badge2.classList.add("bg-emerald-600");
    }
    edit2?.classList.remove("hidden");
    card2?.classList.remove("border-2", "border-brand");
    card2?.classList.add("border", "border-line");

    // Open Step 3
    body3?.classList.remove("hidden");
    card3?.classList.remove("border-line", "opacity-90");
    card3?.classList.add("border-2", "border-brand");
    if (badge3) {
      badge3.classList.remove("bg-sand", "text-ink");
      badge3.classList.add("bg-brand", "text-cream");
    }

    // Scroll to Step 3
    card3?.scrollIntoView({ behavior: "smooth", block: "start" });
  });

  // Edit Step 2
  edit2?.addEventListener("click", () => {
    body2?.classList.remove("hidden");
    summary2?.classList.add("hidden");
    edit2?.classList.add("hidden");
    card2?.classList.add("border-2", "border-brand");
    card2?.classList.remove("border-line");
    if (badge2) {
      badge2.textContent = "2";
      badge2.classList.add("bg-brand");
      badge2.classList.remove("bg-emerald-600");
    }
    card2?.scrollIntoView({ behavior: "smooth", block: "start" });
  });

  // ── Payment Choice Toggles ───────────────────────────────────────────────────
  const payRadios = document.querySelectorAll<HTMLInputElement>('input[name="payment_choice"]');
  const manualBox = document.getElementById("manual-details-box");

  payRadios.forEach((r) => {
    r.addEventListener("change", () => {
      document.querySelectorAll(".payment-card").forEach((c) => {
        c.classList.remove("border-2", "border-brand", "bg-brand/5");
        c.classList.add("border", "border-line", "bg-white");
      });
      const parent = r.closest(".payment-card");
      if (parent) {
        parent.classList.remove("border", "border-line", "bg-white");
        parent.classList.add("border-2", "border-brand", "bg-brand/5");
      }

      if (r.value === "manual") {
        manualBox?.classList.remove("hidden");
      } else {
        manualBox?.classList.add("hidden");
      }
      updateTotal();
    });
  });

  // ── Form Submit & Final Payment ───────────────────────────────────────────────
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (errorBox) { errorBox.classList.add("hidden"); errorBox.textContent = ""; }

    const name = (document.getElementById("cust-name") as HTMLInputElement)?.value.trim();
    const email = (document.getElementById("cust-email") as HTMLInputElement)?.value.trim();
    const phone = (document.getElementById("cust-phone") as HTMLInputElement)?.value.trim();

    if (!name || !email || !phone) {
      edit1?.click();
      showError("Please complete your Contact Information first.");
      return;
    }

    const delType = (document.querySelector('input[name="delivery_type"]:checked') as HTMLInputElement)?.value;
    let fullDeliveryString = "";
    let selectedCity = "";
    const { fee: deliveryFeeKes, city: rateCity } = getCurrentDeliveryFee();

    if (delType === "pickup") {
      selectedCity = "Eldoret Studio";
      fullDeliveryString = "Free Eldoret Studio Pickup";
    } else {
      selectedCity = zoneSelect?.value || rateCity;
      const town = (document.getElementById("del-town") as HTMLInputElement)?.value.trim();
      const area = (document.getElementById("del-area") as HTMLInputElement)?.value.trim();
      const address = (document.getElementById("del-address") as HTMLInputElement)?.value.trim();
      const landmark = (document.getElementById("del-landmark") as HTMLInputElement)?.value.trim();

      if (!town || !area || !address) {
        edit2?.click();
        showError("Please complete your delivery address details.");
        return;
      }
      fullDeliveryString = `${selectedCity} — ${town}, ${area}, ${address}${landmark ? ` (Landmark: ${landmark})` : ""}`;
    }

    const custom = (document.getElementById("cust-custom") as HTMLInputElement)?.value.trim();
    const choice = (document.querySelector('input[name="payment_choice"]:checked') as HTMLInputElement)?.value || "paystack";
    const subtotalKes = unitPrice * currentQty;
    const totalKes = subtotalKes + deliveryFeeKes;
    const orderRef = "PH-ORD-" + Date.now().toString().slice(-5) + "-" + Math.random().toString(36).substr(2, 4).toUpperCase();

    // Flow A: Manual M-Pesa Till / Paybill
    if (choice === "manual") {
      const waText = encodeURIComponent(
        `🛍️ NEW ORDER (M-PESA TILL / PAYBILL) — PrintHub Africa\n\n` +
        `Ref: ${orderRef}\n` +
        `Product: ${productName}\n` +
        `Size: ${paramSize || "Standard"}\n` +
        `Colour: ${paramColour || "Standard"}\n` +
        `Quantity: ${currentQty}\n` +
        `Items Subtotal: KES ${subtotalKes.toLocaleString()}\n` +
        `Delivery Fee: KES ${deliveryFeeKes.toLocaleString()} (${selectedCity})\n` +
        `Total to Pay: KES ${totalKes.toLocaleString()}\n` +
        `Delivery Address: ${fullDeliveryString}\n` +
        (custom ? `Custom: ${custom}\n` : "") +
        `Customer: ${name}\n` +
        `Email: ${email}\n` +
        `Phone: ${phone}\n\n` +
        `I am confirming this order. Here is my M-Pesa confirmation code:\n[PASTE M-PESA SMS CODE HERE]`
      );
      window.open(`https://wa.me/${whatsappNum}?text=${waText}`, "_blank");
      
      const confParams = new URLSearchParams({
        product: productName,
        ref: orderRef,
        name,
        qty: String(currentQty),
        size: paramSize,
        colour: paramColour,
        delivery: fullDeliveryString,
        amount: String(totalKes),
      });
      window.location.href = `/order-confirmed/?${confParams.toString()}`;
      return;
    }

    // Flow B: Paystack Instant STK Push & Card
    if (!paystackKey || !paystackKey.startsWith("pk_")) {
      const waFallback = encodeURIComponent(
        `🛍️ DIRECT ORDER — PrintHub Africa\n\nProduct: ${productName}\nQty: ${currentQty}\nSubtotal: KES ${subtotalKes.toLocaleString()}\nDelivery (${selectedCity}): KES ${deliveryFeeKes.toLocaleString()}\nTotal: KES ${totalKes.toLocaleString()}\nCustomer: ${name} (${phone})\nAddress: ${fullDeliveryString}`
      );
      window.open(`https://wa.me/${whatsappNum}?text=${waFallback}`, "_blank");
      return;
    }

    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.innerHTML = `
        <svg class="animate-spin w-6 h-6 text-white" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
        </svg>
        <span>Connecting to M-Pesa / Paystack...</span>
      `;
    }

    try {
      await loadPaystackScript();
      
      const paystackRef = "PHB-" + Date.now() + "-" + Math.random().toString(36).substr(2, 5).toUpperCase();
      const metadata = {
        orderRef,
        name,
        phone,
        productName,
        productSlug: targetSlug,
        size: paramSize,
        colour: paramColour,
        quantity: String(currentQty),
        custom_note: custom,
        delivery: fullDeliveryString,
        deliveryCity: selectedCity,
        deliveryFeeKes: String(deliveryFeeKes),
        subtotalKes: String(subtotalKes),
        amountKes: String(totalKes),
        custom_fields: [
          { display_name: "Order Ref", variable_name: "orderRef", value: orderRef },
          { display_name: "Product", variable_name: "product", value: productName },
          { display_name: "Quantity", variable_name: "quantity", value: String(currentQty) },
          { display_name: "Delivery City", variable_name: "delivery_city", value: selectedCity },
          { display_name: "Delivery Fee", variable_name: "delivery_fee", value: `KES ${deliveryFeeKes}` },
          { display_name: "Delivery Address", variable_name: "delivery_address", value: fullDeliveryString },
          { display_name: "Phone", variable_name: "phone", value: phone },
        ],
      };

      const handler = (window as any).PaystackPop.setup({
        key: paystackKey,
        email,
        amount: totalKes * 100, // in kobo
        currency: "KES",
        ref: paystackRef,
        firstname: name.split(" ")[0],
        lastname: name.split(" ").slice(1).join(" ") || "",
        phone,
        metadata,
        label: `PrintHub Africa – ${productName}`,
        
        onClose: () => {
          if (submitBtn) {
            submitBtn.disabled = false;
            updateTotal();
          }
          showError("Payment prompt was cancelled. Try again whenever you're ready.");
        },

        callback: (response: any) => {
          // WhatsApp direct maker notification
          const waNotify = encodeURIComponent(
            `🛍️ PAID ORDER RECEIVED — PrintHub Africa\n\n` +
            `Ref: ${orderRef}\n` +
            `Product: ${productName}\n` +
            `Size: ${paramSize || "Standard"}\n` +
            `Colour: ${paramColour || "Standard"}\n` +
            `Qty: ${currentQty}\n` +
            `Subtotal: KES ${subtotalKes.toLocaleString()}\n` +
            `Delivery Fee: KES ${deliveryFeeKes.toLocaleString()} (${selectedCity})\n` +
            `Total Paid: KES ${totalKes.toLocaleString()}\n` +
            `Address: ${fullDeliveryString}\n` +
            (custom ? `Custom: ${custom}\n` : "") +
            `Customer: ${name}\n` +
            `Email: ${email}\n` +
            `Phone: ${phone}\n` +
            `Paystack Ref: ${response.reference}\n` +
            `Status: ✅ PAID (M-Pesa / Card)`
          );
          window.open(`https://wa.me/${whatsappNum}?text=${waNotify}`, "_blank");

          // Route to confirmation screen
          const confParams = new URLSearchParams({
            product: productName,
            ref: orderRef,
            paystackRef: response.reference,
            name,
            qty: String(currentQty),
            size: paramSize,
            colour: paramColour,
            delivery: fullDeliveryString,
            amount: String(totalKes),
          });
          window.location.href = `/order-confirmed/?${confParams.toString()}`;
        },
      });

      handler.openIframe();
    } catch (err: any) {
      if (submitBtn) {
        submitBtn.disabled = false;
        updateTotal();
      }
      showError("Could not initiate payment gateway. Please check your connection or use WhatsApp.");
    }
  });

  function showError(msg: string) {
    if (errorBox) {
      errorBox.textContent = msg;
      errorBox.classList.remove("hidden");
      errorBox.scrollIntoView({ behavior: "smooth", block: "center" });
    }
  }

  // Initial Calculation
  updateTotal();
</script>
