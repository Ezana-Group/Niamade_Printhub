---
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
import { guides } from "../../data/guides";
import { site, wa, waMessages } from "../../data/site";
import { ids, breadcrumbNode } from "../../lib/schema";

const pageTitle = "3D Printing & Materials Guides | PrintHub Africa";
const pageDesc = "Helpful engineering guides on 3D printing materials (PLA vs PETG vs TPU), preparing CAD files for slicing, and measuring broken parts for replication in Kenya.";

const schemaNodes = [
  {
    "@type": "CollectionPage",
    "@id": `${site.url}/guides/#collection`,
    name: "3D Printing & Fabrication Engineering Guides",
    description: pageDesc,
    url: `${site.url}/guides/`,
    publisher: { "@id": ids.business },
    mainEntity: {
      "@type": "ItemList",
      itemListElement: guides.map((g, i) => ({
        "@type": "ListItem",
        position: i + 1,
        url: `${site.url}/guides/${g.slug}/`,
        name: g.title,
      })),
    },
  },
  breadcrumbNode([
    { name: "Home", url: `${site.url}/` },
    { name: "Guides", url: `${site.url}/guides/` },
  ]),
];
---

<Layout title={pageTitle} description={pageDesc} jsonLd={schemaNodes}>
  <section class="wrap pt-10 md:pt-16 pb-12">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="text-sm text-mute">
      <a href="/" class="hover:text-brand">Home</a>
      <span aria-hidden="true" class="mx-1.5">/</span>
      <span class="text-ink font-semibold" aria-current="page">Guides</span>
    </nav>

    <div class="mt-6 max-w-3xl">
      <p class="eyebrow">Knowledge & Engineering</p>
      <h1 class="mt-2 text-4xl md:text-5xl font-display font-semibold">Practical 3D Printing Guides</h1>
      <p class="mt-4 text-lg text-mute leading-relaxed">
        Straightforward, engineering-backed guides to help you choose the right material, prepare files for slicing, and measure parts for replacement right here in Kenya.
      </p>
    </div>

    <!-- Guides List -->
    <div data-reveal-group class="mt-12 grid md:grid-cols-3 gap-6">
      {guides.map((g) => (
        <article class="press lift group panel p-7 flex flex-col justify-between h-full bg-card hover:border-brand/40 transition-colors">
          <div>
            <div class="flex items-center justify-between text-xs font-semibold text-mute uppercase tracking-wider mb-3">
              <span>{g.readTime}</span>
              <time datetime={g.updatedAt}>{new Date(g.updatedAt).toLocaleDateString("en-GB", { year: "numeric", month: "short", day: "numeric" })}</time>
            </div>
            <h2 class="font-display text-2xl font-semibold group-hover:text-brand transition-colors leading-snug">
              <a href={`/guides/${g.slug}/`}>{g.title}</a>
            </h2>
            <p class="mt-3 text-mute text-sm leading-relaxed">{g.summary}</p>
          </div>
          <div class="mt-6 pt-4 border-t border-line/70 flex items-center justify-between text-sm font-bold text-brand">
            <span>Read guide</span>
            <Icon name="arrow" size={16} class="group-hover:translate-x-1 transition-transform" />
          </div>
        </article>
      ))}
    </div>

    <!-- Help Banner -->
    <div class="mt-16 rounded-5xl bg-sand/60 border border-line p-8 md:p-10 flex flex-col sm:flex-row items-center justify-between gap-6">
      <div>
        <h2 class="font-display text-2xl md:text-3xl font-semibold">Have a custom question or CAD file?</h2>
        <p class="mt-2 text-mute">Send your drawing, idea, or questions directly to our engineering desk.</p>
      </div>
      <div class="flex flex-wrap gap-3 shrink-0">
        <a href="/custom/" class="btn btn-soft">Custom Orders <Icon name="arrow" size={16} /></a>
        <a href={wa(waMessages.general)} target="_blank" rel="noopener" class="btn btn-wa"><Icon name="whatsapp" size={18} />WhatsApp Us</a>
      </div>
    </div>
  </section>
</Layout>
