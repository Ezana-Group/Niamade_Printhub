---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import { faqs, wa, waMessages } from "../data/site";
import { fetchPageContentFromSanity } from "../lib/sanity";

const sanityHelp = await fetchPageContentFromSanity("help");
const heroHeading = sanityHelp?.heroHeading || "Questions, answered.";
const heroSubtext = sanityHelp?.heroSubtext || "Ordering, paying, delivery and looking after your print. Can't find it? Message us and we will reply.";

const groups = [...new Set(faqs.map((f) => f.group))];
const id = (g: string) => g.toLowerCase().replace(/[^a-z]+/g, "-");
const ld = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: (f.a || "").replace(/<[^>]+>/g, "").trim() } })) };
---
<Layout title="Help & FAQs" jsonLd={ld} description="Answers about ordering, paying by M-Pesa, delivery across Kenya, materials and caring for your 3D print.">
  <section class="wrap pt-10 md:pt-14">
    <p class="eyebrow rise">Help</p>
    <h1 style="--d:60ms" class="rise mt-2 text-5xl md:text-6xl">{heroHeading}</h1>
    <p style="--d:120ms" class="rise mt-4 text-xl text-mute max-w-2xl">{heroSubtext}</p>
    <nav aria-label="Jump to a topic" class="mt-8 flex flex-wrap gap-2.5">{groups.map((g) => <a href={`#${id(g)}`} class="chip">{g}</a>)}</nav>
    <div class="mt-12 space-y-14">
      {groups.map((g) => (
        <div id={id(g)} class="grid lg:grid-cols-12 gap-6">
          <h2 class="lg:col-span-4 text-3xl md:text-4xl">{g}</h2>
          <div class="lg:col-span-8">
            {faqs.filter((f) => f.group === g).map((f) => (
              <details class="border-b border-line py-5">
                <summary class="flex items-center justify-between gap-6 cursor-pointer font-display text-xl font-semibold">{f.q}<span class="plus text-2xl text-brand shrink-0" aria-hidden="true">+</span></summary>
                <div class="mt-3 text-mute max-w-2xl space-y-2 leading-relaxed" set:html={f.a} />
              </details>))}
          </div>
        </div>))}
    </div>
    <div class="mt-16 rounded-5xl bg-peach p-8 md:p-10 flex flex-wrap items-center justify-between gap-6">
      <div class="max-w-xl"><h2 class="text-3xl md:text-4xl">Still wondering?</h2><p class="mt-2 text-lg text-ink/80">Ask us anything on WhatsApp and we will reply during opening hours.</p></div>
      <a href={wa(waMessages.help)} target="_blank" rel="noopener" class="btn btn-wa"><Icon name="whatsapp" size={20} />Ask on WhatsApp</a>
    </div>

    <!-- INTERLINKING: READY TO TAKE ACTION -->
    <div class="mt-16 border-t border-line pt-12">
      <h2 class="font-display text-2xl font-semibold">Where would you like to go next?</h2>
      <div class="mt-6 grid sm:grid-cols-3 gap-5">
        <a href="/shop/" class="press lift group rounded-3xl bg-card border border-line p-6 flex flex-col justify-between">
          <div>
            <h3 class="font-display text-lg font-semibold">Browse the 3D Print Shop</h3>
            <p class="mt-2 text-sm text-mute">Explore our catalog of gifts, Kenya souvenirs, and home décor with direct M-Pesa checkout.</p>
          </div>
          <span class="mt-4 font-bold text-brand text-sm group-hover:underline">Visit the shop →</span>
        </a>
        <a href="/custom/" class="press lift group rounded-3xl bg-card border border-line p-6 flex flex-col justify-between">
          <div>
            <h3 class="font-display text-lg font-semibold">Start a Custom Order</h3>
            <p class="mt-2 text-sm text-mute">Send an STL, STEP file, broken component, or rough idea for custom CAD modeling and printing.</p>
          </div>
          <span class="mt-4 font-bold text-brand text-sm group-hover:underline">Custom orders →</span>
        </a>
        <a href="/contact/" class="press lift group rounded-3xl bg-card border border-line p-6 flex flex-col justify-between">
          <div>
            <h3 class="font-display text-lg font-semibold">Contact &amp; Studio Hours</h3>
            <p class="mt-2 text-sm text-mute">See our physical address in Eldoret, opening hours, phone contacts, and Google Maps location.</p>
          </div>
          <span class="mt-4 font-bold text-brand text-sm group-hover:underline">Contact us →</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
