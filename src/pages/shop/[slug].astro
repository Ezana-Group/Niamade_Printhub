---
import Layout from "../../layouts/Layout.astro";
import ProductArt from "../../components/ProductArt.astro";
import ProductCard from "../../components/ProductCard.astro";
import Icon from "../../components/Icon.astro";
import CheckoutModal from "../../components/CheckoutModal.astro";
import { products, occasions, site, wa, waMessages, price } from "../../data/site";
import { productSchemaNode, breadcrumbNode } from "../../lib/schema";

export function getStaticPaths() { return products.map((p) => ({ params: { slug: p.slug }, props: { p } })); }
const { p } = Astro.props;
const n = price(p.price);
// "from" prices are variable — disable direct checkout for those
const from = p.price.toLowerCase().startsWith("from");

const primaryOccasion = occasions.find((o) => p.tags && p.tags.includes(o.id)) || occasions[0];

const schemaNodes = [
  productSchemaNode(p),
  breadcrumbNode([
    { name: "Home", url: `${site.url}/` },
    { name: "Shop", url: `${site.url}/shop/` },
    { name: primaryOccasion.label, url: `${site.url}/shop/for/${primaryOccasion.slug}/` },
    { name: p.name, url: `${site.url}/shop/${p.slug}/` },
  ]),
];

// Per-product WA override → global template → hardcoded fallback
const orderMsg = p.waMessage
  ? p.waMessage.replace('{name}', p.name).replace('{price}', p.price).replace('{size}', '___').replace('{colour}', '___')
  : waMessages.general !== "Hi PrintHub, I'd like to ask about a 3D print."
    ? `${waMessages.general} Product: ${p.name} (${p.price})`
    : `Hi PrintHub, I'd like to order: ${p.name} (${p.price}). Size: ___  Colour: ___  Quantity: ___`;
const more = products.filter((o) => o.slug !== p.slug && o.tags.some((t) => p.tags.includes(t))).slice(0, 3);
const tagLabels = p.tags.map((t) => occasions.find((o) => o.id === t)!).filter(Boolean);
const coloursText = (p.colours && p.colours.length) ? p.colours.join(", ") : "Tell us your colour when you order";
const sizesText = (p.sizes && p.sizes.length) ? p.sizes.join(", ") : null;
const specs = [
  ["Material", p.material],
  ["Finish", p.finish],
  ...(sizesText ? [["Sizes", sizesText]] : []),
  ["Colours", coloursText],
  ["Timing", "Confirmed when we send your quote"],
  ["Delivery", "Courier across Kenya, or free collection in Eldoret"],
];
---
<Layout title={`${p.name} · 3D Printed in Kenya`} waMsg={orderMsg} jsonLd={schemaNodes} image={p.photos[0]} description={`${p.name}: ${p.note}. ${p.blurb}`}>
  <section class="wrap pt-8 md:pt-12">
    <nav aria-label="Breadcrumb" class="text-[0.95rem] text-mute">
      <a href="/shop/" class="hover:text-brand">Shop</a>
      <span aria-hidden="true">/</span>
      <a href={`/shop/for/${primaryOccasion.slug}/`} class="hover:text-brand">{primaryOccasion.label}</a>
    </nav>
    <div class="mt-6 grid lg:grid-cols-2 gap-10 lg:gap-14 items-start">
      <div>
        <div class="rounded-5xl overflow-hidden border border-line bg-card">
          {p.photos.length ? (
            <img
              id="main"
              src={p.photos[0]}
              alt={p.name}
              width="1200"
              height="1200"
              fetchpriority="high"
              decoding="async"
              class="w-full aspect-square object-cover"
            />
          ) : (
            <ProductArt slug={p.slug} cat={p.cat} reveal={true} />
          )}
        </div>
        {p.photos.length > 1 && <div class="mt-4 grid grid-cols-4 gap-3">{p.photos.map((im: string, i: number) => <button type="button" aria-label={`Show photo ${i + 1} of ${p.photos.length}`} aria-current={i === 0} data-src={im} class="thumb rounded-2xl overflow-hidden ring-2 ring-transparent aria-[current=true]:ring-brand transition-shadow duration-200"><img src={im} alt="" width="300" height="300" loading="lazy" class="w-full aspect-square object-cover" /></button>)}</div>}
        {!p.photos.length && <p class="mt-3 text-sm text-mute">Illustration of the style. Yours is printed to order.</p>}
      </div>
      <div>
        <p class="eyebrow">{p.cat}</p>
        <h1 class="mt-2 text-4xl md:text-5xl">{p.name}</h1>
        {p.isCollab && p.creatorName && (
          <div class="mt-2.5 flex items-center gap-2 text-sm text-ink/75">
            <span class="rounded-full bg-sand px-2.5 py-0.5 font-bold uppercase text-[0.7rem] text-ink/80 tracking-wider">Creator Collab</span>
            <span>Crafted by PrintHub for {p.creatorUrl ? (
              <a href={p.creatorUrl} target="_blank" rel="noopener" class="font-semibold text-brand hover:underline inline-flex items-center gap-0.5">
                {p.creatorName} <span class="text-xs">↗</span>
              </a>
            ) : (
              <strong class="font-semibold text-ink">{p.creatorName}</strong>
            )}</span>
          </div>
        )}
        <p class="mt-5 flex items-baseline gap-3 flex-wrap">
          <span class="font-display text-4xl font-semibold text-brand">{p.price}</span>
          {p.originalPrice && (
            <span class="text-2xl line-through text-mute/60 font-medium">{p.originalPrice}</span>
          )}
          {(p.discountBadge || p.onSale) && (
            <span class="rounded-full bg-brand/10 text-brand border border-brand/20 px-3.5 py-1 text-xs font-bold uppercase tracking-wider">
              {p.discountBadge || "Discounted"}
            </span>
          )}
          <span class="text-mute">price guide</span>
        </p>
        <div class="mt-5 text-lg text-ink/85 prose space-y-3 leading-relaxed" set:html={p.blurb} />
        
        {p.sizes && p.sizes.length > 0 && (
          <div class="mt-6">
            <p class="text-sm font-bold text-ink">Choose Size</p>
            <div class="mt-2 flex flex-wrap gap-2" id="size-options">
              {p.sizes.map((s: string, i: number) => (
                <button type="button" class="size-chip rounded-full border border-line px-4 py-1.5 text-sm font-semibold transition-all aria-[selected=true]:bg-brand aria-[selected=true]:text-white aria-[selected=true]:border-brand" aria-selected={i === 0 ? "true" : "false"} data-val={s}>
                  {s}
                </button>
              ))}
            </div>
          </div>
        )}

        {p.colours && p.colours.length > 0 && (
          <div class="mt-5">
            <p class="text-sm font-bold text-ink">Choose Colour</p>
            <div class="mt-2 flex flex-wrap gap-2" id="colour-options">
              {p.colours.map((c: string, i: number) => (
                <button type="button" class="colour-chip rounded-full border border-line px-4 py-1.5 text-sm font-semibold transition-all aria-[selected=true]:bg-brand aria-[selected=true]:text-white aria-[selected=true]:border-brand" aria-selected={i === 0 ? "true" : "false"} data-val={c}>
                  {c}
                </button>
              ))}
            </div>
          </div>
        )}

        {p.customizationPrompt && (
          <div class="mt-5">
            <p class="text-sm font-bold text-ink">{p.customizationPrompt}</p>
            <input type="text" id="custom-text" placeholder="e.g. Your name, text or initials" class="mt-2 w-full max-w-md rounded-2xl border border-line bg-card px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand" />
          </div>
        )}

        <div class="mt-6"><p class="text-sm font-bold">Lovely for</p><ul class="mt-2 flex flex-wrap gap-2">{p.uses.map((u: string) => <li class="rounded-full bg-sand px-4 py-1.5 text-[0.95rem] font-semibold">{u}</li>)}</ul></div>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          {p.externalPurchaseUrl && (p.purchaseAction === 'external' || p.purchaseAction === 'both') ? (
            <a href={p.externalPurchaseUrl} target="_blank" rel="noopener" class="btn !bg-ink !text-cream hover:!bg-black flex items-center gap-2 shadow-sm">
              Buy on {p.creatorName || "Creator's Store"} ↗
            </a>
          ) : null}

          {n && !from && site.enableCheckout && (
            <button
              type="button"
              id="pay-direct-btn"
              class="btn !bg-brand !text-cream hover:!bg-brand/90 font-bold flex items-center gap-2 shadow-sm"
              data-name={p.name}
              data-slug={p.slug}
              data-price={n}
              data-has-custom={p.customizationPrompt ? "true" : "false"}
            >
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
              </svg>
              Buy Now
            </button>
          )}

          {(p.purchaseAction === 'whatsapp' || p.purchaseAction === 'both' || !p.externalPurchaseUrl) && (
            <a id="wa-order-btn" href={wa(orderMsg)} target="_blank" rel="noopener" class={`btn ${n && !from && site.enableCheckout ? 'btn-soft !text-ink' : 'btn-wa'}`} data-base-name={p.name} data-base-price={p.price} data-wa-template={p.waMessage || ""}>
              <Icon name="whatsapp" size={20} />
              {p.externalPurchaseUrl && p.purchaseAction === 'both' ? 'Order Batch via WhatsApp' : 'Order on WhatsApp'}
            </a>
          )}

          <a href="/custom/" class="btn btn-soft">Want it changed?</a>
        </div>
        {n && !from && site.enableCheckout && (
          <p class="text-xs text-mute flex items-center gap-2 mt-3">
            <span class="inline-block w-2 h-2 rounded-full bg-emerald-500"></span>
            Instant M-Pesa STK Push or Card payment · Printed to order in Eldoret
          </p>
        )}
        <dl class="mt-9 panel divide-y divide-line">
          {specs.map(([k, v]) => <div class="grid grid-cols-3 gap-4 px-6 py-4"><dt class="font-bold">{k}</dt><dd class="col-span-2 text-mute">{v}</dd></div>)}
        </dl>
        {p.care && (
          <div class="mt-5 rounded-3xl bg-butter px-6 py-4 text-ink/85 prose">
            <p class="font-bold not-prose mb-1">Good to know:</p>
            <div set:html={p.care} />
          </div>
        )}
        {p.isCollab && (
          <div class="mt-5 rounded-3xl bg-sand/60 border border-line p-5 flex flex-wrap items-center justify-between gap-4">
            <div class="max-w-md">
              <p class="font-bold text-sm text-ink">Have a product you want manufactured?</p>
              <p class="text-xs text-mute mt-0.5">We help designers, businesses, and creators produce retail-ready pieces and small-batch runs.</p>
            </div>
            <a href="/for-business/" class="btn btn-soft !py-2 !px-4 text-xs font-bold">Print with us →</a>
          </div>
        )}
      </div>
    </div>
  </section>
  {more.length > 0 && <section class="wrap mt-20">
    <h2 class="text-3xl md:text-4xl">You might also like</h2>
    <div data-reveal-group class="mt-8 grid sm:grid-cols-3 gap-5">{more.map((o) => <ProductCard p={o} />)}</div>
  </section>}

  <CheckoutModal
    paystackKey={site.paystackPublicKey || ""}
    mpesaTill={site.mpesaTillNumber || ""}
    mpesaPaybill={site.mpesaPaybillNumber || ""}
    mpesaAccount={site.mpesaAccountName || ""}
    mpesaBusinessName={site.mpesaBusinessName || "NIAMADE HUB"}
    whatsapp={site.whatsapp || "254792732929"}
  />
</Layout>
<script>
  const main = document.getElementById("main") as HTMLImageElement | null, thumbs = document.querySelectorAll<HTMLButtonElement>(".thumb");
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  let token = 0;
  thumbs.forEach((t) => t.addEventListener("click", async () => {
    if (!main || t.getAttribute("aria-current") === "true") return;
    thumbs.forEach((x) => x.setAttribute("aria-current", String(x === t)));
    const src = t.dataset.src!, me = ++token;
    const pre = new Image(); pre.src = src;
    try { await pre.decode(); } catch {}
    if (me !== token) return;
    main.src = src;
    if (!reduce) { main.getAnimations().forEach((a) => a.cancel()); main.animate([{ opacity: 0.25 }, { opacity: 1 }], { duration: 220, easing: "cubic-bezier(0.23, 1, 0.32, 1)" }); }
  }));

  // Direct Online Checkout Trigger (M-Pesa / Card)
  const payBtn = document.getElementById("pay-direct-btn") as HTMLButtonElement | null;
  if (payBtn) {
    payBtn.addEventListener("click", () => {
      const selSize = document.querySelector<HTMLButtonElement>(".size-chip[aria-selected='true']")?.dataset.val || "";
      const selColour = document.querySelector<HTMLButtonElement>(".colour-chip[aria-selected='true']")?.dataset.val || "";
      const customVal = (document.getElementById("custom-text") as HTMLInputElement | null)?.value?.trim() || "";
      const hasCustom = payBtn.dataset.hasCustom === "true" || !!customVal;
      const api = (window as any).__phbCheckout;
      if (api && api.open) {
        api.open({
          productName: payBtn.dataset.name || "",
          productSlug: payBtn.dataset.slug || "",
          unitPriceKes: parseInt(payBtn.dataset.price || "0", 10),
          size: selSize,
          colour: selColour,
          hasCustom: hasCustom,
        });
        if (customVal) {
          const coCustom = document.getElementById("co-custom") as HTMLInputElement | null;
          if (coCustom) coCustom.value = customVal;
        }
      }
    });
  }

  // Dynamic Size & Colour Selection for WhatsApp Order
  const waBtn = document.getElementById("wa-order-btn") as HTMLAnchorElement | null;
  const sizeChips = document.querySelectorAll<HTMLButtonElement>(".size-chip");
  const colourChips = document.querySelectorAll<HTMLButtonElement>(".colour-chip");
  const customInput = document.getElementById("custom-text") as HTMLInputElement | null;

  function updateWaLink() {
    if (!waBtn) return;
    const baseName = waBtn.dataset.baseName || "";
    const basePrice = waBtn.dataset.basePrice || "";
    const waTemplate = waBtn.dataset.waTemplate || "";
    const selSize = document.querySelector<HTMLButtonElement>(".size-chip[aria-selected='true']")?.dataset.val;
    const selColour = document.querySelector<HTMLButtonElement>(".colour-chip[aria-selected='true']")?.dataset.val;
    const customVal = customInput?.value?.trim();

    let text: string;
    if (waTemplate) {
      text = waTemplate
        .replace('{name}', baseName)
        .replace('{price}', basePrice)
        .replace('{size}', selSize || '___')
        .replace('{colour}', selColour || '___');
      if (customVal) text += ` Custom Text: "${customVal}".`;
    } else {
      text = `Hi PrintHub, I'd like to order: ${baseName} (${basePrice}).`;
      if (selSize) text += ` Size: ${selSize}.`;
      if (selColour) text += ` Colour: ${selColour}.`;
      if (customVal) text += ` Custom Text: "${customVal}".`;
    }

    waBtn.href = `https://wa.me/254792732929?text=${encodeURIComponent(text)}`;
  }

  sizeChips.forEach((btn) => btn.addEventListener("click", () => {
    sizeChips.forEach((b) => b.setAttribute("aria-selected", "false"));
    btn.setAttribute("aria-selected", "true");
    updateWaLink();
  }));

  colourChips.forEach((btn) => btn.addEventListener("click", () => {
    colourChips.forEach((b) => b.setAttribute("aria-selected", "false"));
    btn.setAttribute("aria-selected", "true");
    updateWaLink();
  }));

  if (customInput) {
    customInput.addEventListener("input", updateWaLink);
  }
</script>
