---
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
import { site } from "../../data/site";

const ld = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: "QuoteForge Documentation: Self-Hosting & Cloud Operations Guide",
  description: "Comprehensive installation, Docker deployment, headless slicer setup, farm LAN telemetry, backup automation, and REST API documentation for QuoteForge 3D quotation engine.",
  publisher: {
    "@type": "Organization",
    name: "PrintHub Africa",
    url: site.url
  }
};
---

<Layout
  title="QuoteForge Documentation — Self-Hosting & Cloud Guide | PrintHub Africa"
  description="Step-by-step setup guide for QuoteForge: Docker Run, Docker Compose, headless slicers, Bambu/Klipper telemetry, Caddy/Nginx reverse proxy, automated backups, and REST API."
  jsonLd={ld}
>
  <!-- Documentation Header -->
  <section class="wrap pt-10 md:pt-16 pb-8 border-b border-line">
    <div class="flex items-center gap-2 text-xs text-mute mb-3">
      <a href="/" class="hover:text-brand">Home</a>
      <span>/</span>
      <a href="/quoteforge/" class="hover:text-brand">QuoteForge</a>
      <span>/</span>
      <span class="text-ink font-semibold">Documentation</span>
    </div>

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div>
        <p class="eyebrow">QuoteForge v1.0.0 Manual & Specification</p>
        <h1 class="font-display text-3xl sm:text-5xl font-bold mt-1 text-ink">
          Documentation & Deployment Guides
        </h1>
        <p class="text-mute text-base sm:text-lg mt-2 max-w-2xl">
          Everything required to deploy, configure, secure, and scale QuoteForge on local bare metal, Docker, or connected cloud infrastructure.
        </p>
      </div>

      <div class="flex items-center gap-3">
        <a href="/quoteforge/" class="btn btn-soft text-sm flex items-center gap-2">
          <span>← Back to QuoteForge</span>
        </a>
        <a href="https://github.com/Ezana-Group/QuoteForge_Pro" target="_blank" rel="noopener" class="btn btn-primary text-sm flex items-center gap-2">
          <Icon name="github" size={16} />
          <span>GitHub Repository</span>
        </a>
      </div>
    </div>

    <!-- Quick Navigation Chips -->
    <div class="flex flex-wrap gap-2 pt-6">
      <a href="#quickstart" class="chip">Quickstart (60s)</a>
      <a href="#docker" class="chip">Docker & Compose</a>
      <a href="#node" class="chip">Native Node.js</a>
      <a href="#slicers" class="chip">Headless Slicers</a>
      <a href="#telemetry" class="chip">Printer Telemetry</a>
      <a href="#proxy" class="chip">Reverse Proxy & SSL</a>
      <a href="#backups" class="chip">Data Backups</a>
      <a href="#security" class="chip">Accounts & RBAC</a>
      <a href="#cloud-bridge" class="chip">Cloud Farm Bridge</a>
      <a href="#env-vars" class="chip">Environment Matrix</a>
      <a href="#api" class="chip">REST API Reference</a>
      <a href="#integrations-erp" class="chip">ERP & Accounting</a>
    </div>
  </section>

  <!-- Main Documentation Content -->
  <div class="wrap py-12">
    <div class="grid lg:grid-cols-12 gap-10">
      <!-- Left Sticky Table of Contents -->
      <aside class="hidden lg:block lg:col-span-3">
        <div class="sticky top-28 space-y-6 text-sm">
          <div>
            <p class="text-xs uppercase font-bold text-mute tracking-wider mb-2">Getting Started</p>
            <ul class="space-y-1.5 border-l-2 border-line pl-3 text-ink/80 font-medium">
              <li><a href="#quickstart" class="hover:text-brand transition-colors">60-Second Docker Run</a></li>
              <li><a href="#requirements" class="hover:text-brand transition-colors">System Requirements</a></li>
              <li><a href="#docker" class="hover:text-brand transition-colors">Docker Compose Stack</a></li>
              <li><a href="#node" class="hover:text-brand transition-colors">Native Node.js Install</a></li>
            </ul>
          </div>

          <div>
            <p class="text-xs uppercase font-bold text-mute tracking-wider mb-2">Engine & Hardware</p>
            <ul class="space-y-1.5 border-l-2 border-line pl-3 text-ink/80 font-medium">
              <li><a href="#slicers" class="hover:text-brand transition-colors">Headless Slicer Engines</a></li>
              <li><a href="#telemetry" class="hover:text-brand transition-colors">Bambu & Klipper Telemetry</a></li>
              <li><a href="#proxy" class="hover:text-brand transition-colors">Reverse Proxy (Caddy/Nginx)</a></li>
              <li><a href="#backups" class="hover:text-brand transition-colors">Data Storage & Backups</a></li>
              <li><a href="#security" class="hover:text-brand transition-colors">Multi-User RBAC & Auth</a></li>
            </ul>
          </div>

          <div>
            <p class="text-xs uppercase font-bold text-mute tracking-wider mb-2">Cloud & Developers</p>
            <ul class="space-y-1.5 border-l-2 border-line pl-3 text-ink/80 font-medium">
              <li><a href="#cloud-bridge" class="hover:text-brand transition-colors">Cloud Hardware Bridge</a></li>
              <li><a href="#env-vars" class="hover:text-brand transition-colors">Environment Variables</a></li>
              <li><a href="#api" class="hover:text-brand transition-colors">REST API Reference</a></li>
              <li><a href="#integrations-erp" class="hover:text-brand transition-colors">ERP & Accounting Integrations</a></li>
            </ul>
          </div>
        </div>
      </aside>

      <!-- Main Doc Articles -->
      <main class="lg:col-span-9 space-y-16">
        <!-- Section: Quickstart -->
        <section id="quickstart" class="scroll-mt-28">
          <div class="flex items-center gap-3">
            <span class="w-8 h-8 rounded-xl bg-brand text-white text-sm font-bold flex items-center justify-center">1</span>
            <h2 class="font-display text-2xl sm:text-3xl font-bold">60-Second Docker Quickstart</h2>
          </div>
          <p class="text-mute mt-3 leading-relaxed">
            QuoteForge is packaged as a standalone lightweight container with zero third-party production runtime dependencies. To launch on a workshop PC, server, or Mac:
          </p>

          <div class="mt-4 rounded-2xl bg-[#14161a] border border-white/10 p-5 text-cream font-mono text-xs sm:text-sm overflow-x-auto relative group">
            <button type="button" class="doc-copy-btn absolute top-3 right-3 px-2.5 py-1 rounded bg-white/10 hover:bg-white/20 text-xs font-sans text-cream transition-all">Copy</button>
            <pre class="select-all"><code>docker run -d \
  --name quoteforge \
  -p 8080:8080 \
  -v quoteforge_data:/root/.quoteforge \
  --restart unless-stopped \
  ghcr.io/ezana-group/quoteforge:v1.0.0</code></pre>
          </div>
          <p class="text-xs text-mute mt-2">
            Once started, open <a href="http://localhost:8080" target="_blank" rel="noopener" class="text-brand font-semibold underline">http://localhost:8080</a>. Complete the initial setup wizard to create your master Owner profile.
          </p>
        </section>

        <!-- Section: Requirements -->
        <section id="requirements" class="scroll-mt-28">
          <h2 class="font-display text-2xl sm:text-3xl font-bold">System Requirements</h2>
          <div class="grid sm:grid-cols-3 gap-4 mt-4">
            <div class="panel p-4 rounded-2xl border border-line">
              <p class="font-bold text-ink">Hardware</p>
              <ul class="text-xs text-mute space-y-1 mt-2">
                <li>• CPU: 1 Core (x86_64 or ARM64 / Apple Silicon)</li>
                <li>• RAM: 256MB base (1GB recommended if running local slicers)</li>
                <li>• Disk: 150MB application space + CAD model uploads</li>
              </ul>
            </div>
            <div class="panel p-4 rounded-2xl border border-line">
              <p class="font-bold text-ink">Supported OS</p>
              <ul class="text-xs text-mute space-y-1 mt-2">
                <li>• Ubuntu 20.04+ / Debian 11+</li>
                <li>• macOS 12 Monterey or newer</li>
                <li>• Windows 10/11 (via Docker or Node)</li>
                <li>• Raspberry Pi 4 / 5 (Raspberry Pi OS 64-bit)</li>
              </ul>
            </div>
            <div class="panel p-4 rounded-2xl border border-line">
              <p class="font-bold text-ink">Software Runtime</p>
              <ul class="text-xs text-mute space-y-1 mt-2">
                <li>• Docker 20.10+ (Recommended) OR</li>
                <li>• Node.js v18.0.0+ (Standard Library)</li>
                <li>• Optional: PrusaSlicer CLI or OrcaSlicer CLI</li>
              </ul>
            </div>
          </div>
        </section>

        <!-- Section: Docker Compose -->
        <section id="docker" class="scroll-mt-28">
          <div class="flex items-center gap-3">
            <span class="w-8 h-8 rounded-xl bg-brand text-white text-sm font-bold flex items-center justify-center">2</span>
            <h2 class="font-display text-2xl sm:text-3xl font-bold">Production Docker Compose Stack</h2>
          </div>
          <p class="text-mute mt-3 leading-relaxed">
            For production workshop servers running unattended, save this <code>docker-compose.yml</code> file:
          </p>

          <div class="mt-4 rounded-2xl bg-[#14161a] border border-white/10 p-5 text-cream font-mono text-xs sm:text-sm overflow-x-auto relative group">
            <button type="button" class="doc-copy-btn absolute top-3 right-3 px-2.5 py-1 rounded bg-white/10 hover:bg-white/20 text-xs font-sans text-cream transition-all">Copy</button>
            <pre class="select-all"><code>services:
  quoteforge:
    image: ghcr.io/ezana-group/quoteforge:v1.0.0
    container_name: quoteforge
    restart: unless-stopped
    ports:
      - "8080:8080"
    volumes:
      - ./data:/root/.quoteforge
    environment:
      - PORT=8080
      - HOST=0.0.0.0
      - DATA_DIR=/root/.quoteforge
      - SESSION_SECRET=replace_with_a_64_character_random_string
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8080/healthz"]
      interval: 30s
      timeout: 5s
      retries: 3</code></pre>
          </div>
          <p class="text-xs text-mute mt-2">
            Start the container with <code>docker compose up -d</code>. Quotation records, inventory files, and staff credentials will persist in the local <code>./data</code> directory.
          </p>
        </section>

        <!-- Section: Native Node -->
        <section id="node" class="scroll-mt-28">
          <div class="flex items-center gap-3">
            <span class="w-8 h-8 rounded-xl bg-brand text-white text-sm font-bold flex items-center justify-center">3</span>
            <h2 class="font-display text-2xl sm:text-3xl font-bold">Native Node.js & Systemd Service</h2>
          </div>
          <p class="text-mute mt-3 leading-relaxed">
            If you prefer running on bare metal Linux without Docker:
          </p>

          <div class="mt-4 rounded-2xl bg-[#14161a] border border-white/10 p-5 text-cream font-mono text-xs sm:text-sm overflow-x-auto relative group">
            <button type="button" class="doc-copy-btn absolute top-3 right-3 px-2.5 py-1 rounded bg-white/10 hover:bg-white/20 text-xs font-sans text-cream transition-all">Copy</button>
            <pre class="select-all"><code># 1. Clone repository
git clone https://github.com/Ezana-Group/QuoteForge_Pro.git
cd QuoteForge_Pro

# 2. Run with standard Node.js (v18 or higher)
npm start

# Starts instantly on http://127.0.0.1:8080</code></pre>
          </div>

          <!-- Linux Systemd Unit -->
          <div class="mt-4 panel p-5 rounded-2xl border border-line">
            <p class="font-bold text-ink mb-1">Linux Systemd Service (<code>/etc/systemd/system/quoteforge.service</code>)</p>
            <p class="text-xs text-mute mb-2">Enable automatic startup on Linux boot:</p>
            <pre class="bg-[#14161a] p-3.5 rounded-xl text-cream font-mono text-xs overflow-x-auto select-all"><code>[Unit]
Description=QuoteForge Pro 3D Quoting Service
After=network.target

[Service]
Type=simple
User=workshop
WorkingDirectory=/home/workshop/QuoteForge_Pro
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5
Environment=PORT=8080
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target</code></pre>
            <p class="text-xs text-mute mt-2">Enable and start with: <code>sudo systemctl enable --now quoteforge</code>.</p>
          </div>
        </section>

        <!-- Section: Headless Slicers -->
        <section id="slicers" class="scroll-mt-28">
          <div class="flex items-center gap-3">
            <span class="w-8 h-8 rounded-xl bg-brand text-white text-sm font-bold flex items-center justify-center">4</span>
            <h2 class="font-display text-2xl sm:text-3xl font-bold">Headless Slicing Engine (PrusaSlicer & OrcaSlicer)</h2>
          </div>
          <p class="text-mute mt-3 leading-relaxed">
            QuoteForge can slice 3D models in the background via CLI. When an STL or 3MF is uploaded, QuoteForge invokes the local slicing binary to extract exact filament grams, layer heights, and machine runtimes.
          </p>

          <div class="grid md:grid-cols-2 gap-4 mt-4">
            <div class="panel p-5 rounded-2xl border border-line">
              <p class="font-bold text-ink">PrusaSlicer CLI Integration</p>
              <p class="text-xs text-mute mt-1 mb-2">QuoteForge calls PrusaSlicer in export-gcode headless mode:</p>
              <pre class="bg-[#14161a] p-3.5 rounded-xl text-cream font-mono text-xs overflow-x-auto select-all"><code># Test PrusaSlicer execution
prusa-slicer --export-gcode \
  --load ~/.quoteforge/profiles/mk4.ini \
  --output /tmp/part.gcode \
  part.stl</code></pre>
              <p class="text-xs text-mute mt-2">QuoteForge parses G-code metadata comments (<code>filament used [g]</code>, <code>estimated printing time</code>).</p>
            </div>

            <div class="panel p-5 rounded-2xl border border-line">
              <p class="font-bold text-ink">Headless Linux Dependencies</p>
              <p class="text-xs text-mute mt-1 mb-2">On headless Linux distributions, install virtual framebuffer tools:</p>
              <pre class="bg-[#14161a] p-3.5 rounded-xl text-cream font-mono text-xs overflow-x-auto select-all"><code># Ubuntu / Debian headless packages
sudo apt-get update && sudo apt-get install -y \
  xvfb \
  libglu1-mesa \
  libgtk-3-0 \
  libwebkit2gtk-4.0-37</code></pre>
              <p class="text-xs text-mute mt-2">Run under Xvfb: <code>xvfb-run -a prusa-slicer ...</code>.</p>
            </div>
          </div>
        </section>

        <!-- Section: Printer Telemetry -->
        <section id="telemetry" class="scroll-mt-28">
          <div class="flex items-center gap-3">
            <span class="w-8 h-8 rounded-xl bg-brand text-white text-sm font-bold flex items-center justify-center">5</span>
            <h2 class="font-display text-2xl sm:text-3xl font-bold">Farm LAN Telemetry & Printer Connections</h2>
          </div>
          <p class="text-mute mt-3 leading-relaxed">
            QuoteForge polls printer telemetry over your local network without external cloud dependence:
          </p>

          <div class="space-y-4 mt-4">
            <div class="panel p-5 rounded-2xl border border-line">
              <p class="font-bold text-ink mb-1">Bambu Lab (X1, P1P, P1S, A1, A1 Mini)</p>
              <p class="text-xs text-mute mb-2">Connects directly over local MQTT (Port 8883) with TLS encryption:</p>
              <ul class="text-xs text-mute space-y-1">
                <li>• <strong>IP Address:</strong> Local printer IP (e.g. <code>192.168.1.120</code>)</li>
                <li>• <strong>Access Code:</strong> Found on the printer touchscreen under <em>Settings → WLAN → Access Code</em></li>
                <li>• <strong>Serial Number:</strong> 15-character device serial on device label or touchscreen</li>
              </ul>
            </div>

            <div class="panel p-5 rounded-2xl border border-line">
              <p class="font-bold text-ink mb-1">Klipper / Moonraker & Voron Farms</p>
              <p class="text-xs text-mute mb-2">Connects to Moonraker REST API (Port 7125):</p>
              <ul class="text-xs text-mute space-y-1">
                <li>• <strong>Host:</strong> <code>http://192.168.1.50:7125</code></li>
                <li>• <strong>API Key:</strong> Optional Moonraker API token (if CORS/Trusted Clients is configured)</li>
                <li>• <strong>Metrics:</strong> Live extruder temperature, bed temperature, print speed override, and progress percentage</li>
              </ul>
            </div>
          </div>
        </section>

        <!-- Section: Reverse Proxy & SSL -->
        <section id="proxy" class="scroll-mt-28">
          <div class="flex items-center gap-3">
            <span class="w-8 h-8 rounded-xl bg-brand text-white text-sm font-bold flex items-center justify-center">6</span>
            <h2 class="font-display text-2xl sm:text-3xl font-bold">Reverse Proxy & Automatic HTTPS (SSL)</h2>
          </div>
          <p class="text-mute mt-3 leading-relaxed">
            When exposing QuoteForge across your workshop Wi-Fi or domain, always place an HTTPS reverse proxy in front with WebSocket forwarding enabled:
          </p>

          <div class="grid md:grid-cols-2 gap-4 mt-4">
            <!-- Caddy Config -->
            <div class="panel p-5 rounded-2xl border border-line">
              <div class="flex items-center justify-between mb-2">
                <p class="font-bold text-ink">Caddyfile (Recommended)</p>
                <span class="text-[0.65rem] font-bold px-2 py-0.5 rounded bg-brand/10 text-brand">Auto Let's Encrypt</span>
              </div>
              <pre class="bg-[#14161a] p-3.5 rounded-xl text-cream font-mono text-xs overflow-x-auto select-all"><code>quote.myworkshop.com &#123;
    reverse_proxy localhost:8080
&#125;</code></pre>
              <p class="text-xs text-mute mt-2">Caddy automatically requests and renews Let's Encrypt certificates.</p>
            </div>

            <!-- Nginx Config -->
            <div class="panel p-5 rounded-2xl border border-line">
              <div class="flex items-center justify-between mb-2">
                <p class="font-bold text-ink">Nginx with WebSocket Support</p>
                <span class="text-[0.65rem] font-bold px-2 py-0.5 rounded bg-sand text-ink">Standard Nginx</span>
              </div>
              <pre class="bg-[#14161a] p-3.5 rounded-xl text-cream font-mono text-xs overflow-x-auto select-all"><code>server &#123;
    server_name quote.myworkshop.com;
    listen 80;

    location / &#123;
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    &#125;
&#125;</code></pre>
              <p class="text-xs text-mute mt-2">Run <code>sudo certbot --nginx</code> to attach SSL certificates.</p>
            </div>
          </div>
        </section>

        <!-- Section: Backups & Portability -->
        <section id="backups" class="scroll-mt-28">
          <div class="flex items-center gap-3">
            <span class="w-8 h-8 rounded-xl bg-brand text-white text-sm font-bold flex items-center justify-center">7</span>
            <h2 class="font-display text-2xl sm:text-3xl font-bold">Automated Data Backups & Migration</h2>
          </div>
          <p class="text-mute mt-3 leading-relaxed">
            QuoteForge stores all configuration, materials, printers, and historical quote data in standard human-readable JSON files inside <code>~/.quoteforge/</code> (or your Docker volume).
          </p>

          <div class="space-y-4 mt-4">
            <div class="panel p-5 rounded-2xl border border-line">
              <p class="font-bold text-ink mb-1">Automated Daily Backup via Cron</p>
              <p class="text-xs text-mute mb-2">Add this to your workshop server crontab (<code>crontab -e</code>) to create timestamped backups daily at 2:00 AM:</p>
              <pre class="bg-[#14161a] p-3.5 rounded-xl text-cream font-mono text-xs overflow-x-auto select-all"><code>0 2 * * * cp ~/.quoteforge/app-data.json ~/backups/quoteforge-$(date +\%F).json</code></pre>
            </div>

            <div class="panel p-5 rounded-2xl border border-line">
              <p class="font-bold text-ink mb-1">One-Click UI Export & Import</p>
              <p class="text-xs text-mute">
                In QuoteForge, navigate to <strong>Settings → Data & Backup</strong>. Click <strong>Export All Data (JSON)</strong> to download a complete snapshot. You can import this snapshot on any other QuoteForge instance or migrate seamlessly to QuoteForge Cloud.
              </p>
            </div>
          </div>
        </section>

        <!-- Section: Multi-User Security & RBAC -->
        <section id="security" class="scroll-mt-28">
          <div class="flex items-center gap-3">
            <span class="w-8 h-8 rounded-xl bg-brand text-white text-sm font-bold flex items-center justify-center">8</span>
            <h2 class="font-display text-2xl sm:text-3xl font-bold">Multi-User Accounts & Access Control</h2>
          </div>
          <p class="text-mute mt-3 leading-relaxed">
            QuoteForge includes built-in multi-user security with scrypt password hashing, session tokens, rate limiting, and role-based permissions:
          </p>

          <div class="grid sm:grid-cols-2 gap-4 mt-4">
            <div class="panel p-4 rounded-2xl border border-line">
              <p class="font-bold text-ink flex items-center gap-2">
                <span class="px-2 py-0.5 rounded text-[0.7rem] bg-brand text-white font-bold">Owner</span>
                <span>Administrator Role</span>
              </p>
              <ul class="text-xs text-mute space-y-1.5 mt-2.5">
                <li>• Full access to financial metrics & margins</li>
                <li>• Create, disable, and reset team member accounts</li>
                <li>• Perform system data backups and imports</li>
                <li>• Configure printer telemetry credentials</li>
              </ul>
            </div>

            <div class="panel p-4 rounded-2xl border border-line">
              <p class="font-bold text-ink flex items-center gap-2">
                <span class="px-2 py-0.5 rounded text-[0.7rem] bg-sand text-ink font-bold">Staff</span>
                <span>Estimator & Operator Role</span>
              </p>
              <ul class="text-xs text-mute space-y-1.5 mt-2.5">
                <li>• Generate quotes & print ladders</li>
                <li>• View job queue and mark prints completed</li>
                <li>• Read inventory and material stock levels</li>
                <li>• Hidden from financial overheads & admin tools</li>
              </ul>
            </div>
          </div>
        </section>

        <!-- Section: Cloud Farm Bridge -->
        <section id="cloud-bridge" class="scroll-mt-28">
          <div class="flex items-center gap-3">
            <span class="w-8 h-8 rounded-xl bg-brand text-white text-sm font-bold flex items-center justify-center">9</span>
            <h2 class="font-display text-2xl sm:text-3xl font-bold">QuoteForge Cloud & Hardware Farm Bridge</h2>
          </div>
          <p class="text-mute mt-3 leading-relaxed">
            QuoteForge Cloud pairs with your local workshop printers through the lightweight <code>quoteforge-bridge</code> daemon. This creates an outbound-only encrypted WebSocket tunnel without opening any firewall ports or configuring public router port-forwarding:
          </p>

          <div class="mt-4 rounded-2xl bg-[#14161a] border border-white/10 p-5 text-cream font-mono text-xs sm:text-sm overflow-x-auto relative group">
            <button type="button" class="doc-copy-btn absolute top-3 right-3 px-2.5 py-1 rounded bg-white/10 hover:bg-white/20 text-xs font-sans text-cream transition-all">Copy</button>
            <pre class="select-all"><code># Run on a local workshop machine on the same LAN as your 3D printers
npx @quoteforge/bridge --token=qf_bridge_your_tenant_token</code></pre>
          </div>
          <p class="text-xs text-mute mt-2">
            The bridge continuously streams nozzle temperatures, bed status, layer height progress, and camera feeds securely to your QuoteForge Cloud dashboard.
          </p>
        </section>

        <!-- Section: Environment Variables -->
        <section id="env-vars" class="scroll-mt-28">
          <div class="flex items-center gap-3">
            <span class="w-8 h-8 rounded-xl bg-brand text-white text-sm font-bold flex items-center justify-center">10</span>
            <h2 class="font-display text-2xl sm:text-3xl font-bold">Environment Variables Master Matrix</h2>
          </div>
          <p class="text-mute mt-3 leading-relaxed">
            Configuration options supported by the QuoteForge server runtime:
          </p>

