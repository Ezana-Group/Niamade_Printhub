---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import { site, wa, waMessages } from "../data/site";
const values = [
  { t: "We ask questions first", d: "What is it for? Where will it live? Which axis takes the load? We pick the right polymer before turning on the heaters.", tone: "bg-peach" },
  { t: "No price guesswork", d: "You get an upfront quote in KES before committing. Design work is quoted first, then physical manufacturing.", tone: "bg-sky" },
  { t: "Tolerance matters", d: "Calibrated extruders, tested materials, and hands-on finishing (sanding, smoothing, painting).", tone: "bg-mint" },
  { t: "Direct access", d: "Talk directly to the people operating the machines on WhatsApp. No generic customer service runaround.", tone: "bg-lilac" },
];
const ld = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  name: "About PrintHub Africa & Niamade Hub",
  description: "Learn about PrintHub Africa, an additive manufacturing and digital design studio in Eldoret, Kenya, operated by Niamade Hub.",
  url: `${site.url}/about/`,
  mainEntity: {
    "@type": "Organization",
    name: site.name,
    legalName: site.businessName,
    url: site.url,
    logo: `${site.url}/logo.png`,
    description: "Design and custom 3D fabrication studio in Eldoret, Kenya.",
    address: {
      "@type": "PostalAddress",
      addressLocality: "Eldoret",
      addressRegion: "Uasin Gishu County",
      addressCountry: "KE"
    },
    sameAs: [site.googleBusinessProfile, ...site.socials.map((s) => s.href)]
  }
};
---
<Layout title="About Us" jsonLd={ld} description="PrintHub Africa is a design and custom fabrication studio in Eldoret, Kenya, making ideas tangible with 3D printing and precision engineering.">
  <section class="wrap pt-10 md:pt-14 grid lg:grid-cols-12 gap-10 items-center">
    <div class="lg:col-span-7">
      <p class="eyebrow rise">About us</p>
      <h1 style="--d:60ms" class="rise mt-2 text-5xl md:text-6xl">We turn digital geometry into physical things.</h1>
      <p style="--d:120ms" class="rise mt-5 text-xl text-mute max-w-2xl">PrintHub Africa is a design and custom fabrication studio in Eldoret, operated by Niamade Hub. We solve real-world problems with additive manufacturing, high-strength polymers, and practical engineering.</p>
      <p style="--d:170ms" class="rise mt-4 text-lg text-mute max-w-2xl">From obsolete replacement gears to brand signs that demand attention: we build things that actually last, delivered across Kenya.</p>
      <div style="--d:220ms" class="rise mt-8 flex flex-wrap gap-3"><a href={wa(waMessages.general)} target="_blank" rel="noopener" class="btn btn-wa"><Icon name="whatsapp" size={20} />Say hello on WhatsApp</a><a href="/shop/" class="btn btn-soft">Explore what we do</a></div>
    </div>
    <div class="lg:col-span-5 flex justify-center"><div class="rounded-5xl bg-butter p-10 md:p-14 -rotate-2 shadow-xl border-4 border-white"><img src="/logo-mark.png" alt="PrintHub Africa logo mark - A Niamade Hub Company" width="750" height="903" class="h-56 md:h-72 w-auto" /></div></div>
  </section>

  <!-- NIAMADE HUB & PRINTHUB AFRICA -->
  <section class="wrap mt-20">
    <div class="rounded-5xl bg-sand p-8 md:p-12 border border-line grid lg:grid-cols-2 gap-10">
      <div>
        <p class="eyebrow">Corporate Identity</p>
        <h2 class="mt-2 text-3xl md:text-4xl">About Niamade Hub</h2>
        <p class="mt-4 text-lg text-ink/85 leading-relaxed">
          Niamade Hub is the registered business behind PrintHub Africa.
        </p>
        <p class="mt-3 text-lg text-ink/80 leading-relaxed">
          Through PrintHub Africa, we aim to deliver accessible, innovative and practical solutions across design, printing and related services.
        </p>
        <p class="mt-3 text-lg text-ink/80 leading-relaxed">
          Our focus is on combining creativity, technology and practical execution to deliver products and services that solve real-world problems.
        </p>
      </div>
      <div>
        <p class="eyebrow">Commercial Identity</p>
        <h2 class="mt-2 text-3xl md:text-4xl">Our Brand</h2>
        <p class="mt-4 text-lg text-ink/85 leading-relaxed">
          PrintHub Africa is the customer-facing commercial brand through which Niamade Hub presents its services and engages with customers.
        </p>
        <p class="mt-3 text-lg text-ink/80 leading-relaxed">
          Our approach is built around quality, innovation, reliability and creating solutions that deliver practical value.
        </p>
        <div class="mt-6 inline-flex items-center gap-2 rounded-full bg-card border border-line px-4 py-2 text-sm font-semibold text-mute">
          <span class="text-ink">PrintHub Africa</span>
          <span class="text-line">•</span>
          <span>A Niamade Hub Company</span>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap mt-24">
    <div class="max-w-2xl"><p class="eyebrow">How we work</p><h2 class="mt-2 text-4xl md:text-5xl">Four things we stick to.</h2></div>
    <div data-reveal-group class="mt-10 grid sm:grid-cols-2 gap-5">
      {values.map((v) => <div class:list={["rounded-4xl p-8", v.tone]}><h3 class="font-display text-3xl">{v.t}</h3><p class="mt-3 text-lg text-ink/80">{v.d}</p></div>)}
    </div>
  </section>

  <section class="wrap mt-24 grid md:grid-cols-2 gap-5">
    <div class="panel p-8">
      <h2 class="font-display text-3xl">Visit us</h2>
      <ul class="mt-5 space-y-4 text-lg">
        <li class="flex gap-3"><Icon name="pin" size={22} class="text-brand shrink-0 mt-1" /><span>{site.city}<br /><span class="text-mute text-base">Collection is free and by appointment. Please message first.</span></span></li>
        <li class="flex gap-3"><Icon name="clock" size={22} class="text-brand shrink-0 mt-1" /><span>{site.hours[0]}<br />{site.hours[1]}</span></li>
      </ul>
    </div>
    <div class="panel p-8">
      <h2 class="font-display text-3xl">Follow our work</h2>
      <ul class="mt-5 space-y-3">
        {site.socials.map((s) => <li><a href={s.href} target="_blank" rel="noopener" class="flex items-center gap-3 rounded-2xl bg-sand px-4 py-3 font-semibold min-w-0 transition-colors duration-150 hover:bg-peach"><Icon name={s.id} size={22} class="text-brand" /><span>{s.label}</span><span class="ml-auto text-mute font-medium text-right break-all">{s.handle}</span></a></li>)}
      </ul>
    </div>
  </section>
</Layout>
