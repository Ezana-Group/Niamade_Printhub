---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import { site, wa, waMessages, materials, printServices, designServices } from "../data/site";
import { fetchPageContentFromSanity } from "../lib/sanity";

const sanityCustom = await fetchPageContentFromSanity("custom");
const heroHeading = sanityCustom?.heroHeading || "Bring a file. Or just an obsession.";
const heroSubtext = sanityCustom?.heroSubtext || "Got a clean CAD export? Great. Got a broken gear and a sketch on a napkin? Also great. Pick the route that matches your situation.";
const tone: Record<string, string> = { peach: "bg-peach", sky: "bg-sky", mint: "bg-mint", lilac: "bg-lilac" };

const ld = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Custom 3D Printing & CAD Design Services",
  provider: {
    "@type": "LocalBusiness",
    name: site.name,
    legalName: site.businessName,
    url: site.url
  },
  areaServed: { "@type": "Country", name: "Kenya" },
  description: "Custom additive manufacturing in PLA, PETG and TPU, CAD modeling from sketches or broken parts, and rapid prototyping in Eldoret, Kenya.",
  serviceType: "Custom 3D Printing and Engineering Design"
};
---
<Layout title="Custom Orders" waMsg="Hi PrintHub, I'd like a custom 3D print." jsonLd={ld} description="Bring your 3D file or just an idea. PrintHub Africa prints and designs custom 3D pieces in PLA, PETG and TPU in Eldoret, Kenya. Quote first, pay by M-Pesa.">
  <section class="wrap pt-10 md:pt-14">
    <p class="eyebrow rise">Custom 3D Printing & CAD Design · Kenya</p>
    <h1 style="--d:60ms" class="rise mt-2 text-5xl md:text-6xl max-w-3xl">{heroHeading}</h1>
    <p style="--d:120ms" class="rise mt-4 text-xl text-mute max-w-2xl">{heroSubtext}</p>
    <div style="--d:180ms" class="rise mt-8 flex flex-wrap gap-3"><a href="#print" class="btn btn-soft">I have a 3D file</a><a href="#design" class="btn btn-soft">I only have an idea</a></div>
  </section>

  <section id="print" class="wrap mt-16">
    <div class="rounded-5xl bg-sky p-8 md:p-12">
      <p class="eyebrow">Route 1</p><h2 class="mt-2 text-4xl md:text-5xl">I have a 3D file</h2>
      <p class="mt-4 text-lg text-ink/80 max-w-2xl">Send the geometry. We run slicing analysis, inspect overhangs, suggest the optimal polymer and layer height, then quote upfront in KES.</p>
      <p class="mt-5"><span class="sticker">Files we accept</span> <span class="ml-2 font-semibold">STL · OBJ · STEP · 3MF</span></p>
      <div data-reveal-group class="mt-9 grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {printServices.map((s) => <div class="press lift rounded-3xl bg-card p-6"><h3 class="font-display text-xl">{s.title}</h3><p class="text-mute mt-1.5">{s.text}</p></div>)}
      </div>
      <a href={wa(waMessages.customFile)} target="_blank" rel="noopener" class="btn btn-wa mt-9"><Icon name="whatsapp" size={20} />Send my file</a>
    </div>
  </section>

  <section id="design" class="wrap mt-8">
    <div class="rounded-5xl bg-lilac p-8 md:p-12">
      <p class="eyebrow">Route 2</p><h2 class="mt-2 text-4xl md:text-5xl">I only have an idea</h2>
      <p class="mt-4 text-lg text-ink/80 max-w-2xl">No CAD experience? That is what we are here for. Show us photos, calipers measurements or the broken original. We model it to exact engineering tolerance.</p>
      <div data-reveal-group class="mt-9 grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {designServices.map((s) => <div class="press lift rounded-3xl bg-card p-6"><h3 class="font-display text-xl">{s.title}</h3><p class="text-mute mt-1.5">{s.text}</p></div>)}
      </div>
      <p class="mt-8 rounded-3xl bg-white/70 px-6 py-4 max-w-2xl"><span class="font-bold">Transparent billing: </span>design work is quoted and approved first. Once your 3D model is finalised and approved, we quote the physical printing. No surprise invoices.</p>
      <a href={wa(waMessages.customIdea)} target="_blank" rel="noopener" class="btn btn-wa mt-8"><Icon name="whatsapp" size={20} />Tell us your idea</a>
    </div>
  </section>

  <section class="wrap mt-24">
    <div class="max-w-2xl"><p class="eyebrow">Materials</p><h2 class="mt-2 text-4xl md:text-5xl">We help you pick.</h2><p class="mt-4 text-lg text-mute">Not sure which to choose? Tell us what it is for and where it will live, and we will suggest one.</p></div>
    <div data-reveal-group class="mt-10 grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {materials.map((m) => <div class:list={["press lift rounded-4xl p-6", tone[m.tone]]}><h3 class="font-display text-3xl">{m.name}</h3><p class="font-bold mt-1">{m.for}</p><p class="mt-3 text-ink/80">{m.note}</p></div>)}
    </div>
  </section>

  <!-- INTERLINKING: EXPLORE OTHER PATHWAYS -->
  <section class="wrap mt-24">
    <div class="rounded-5xl bg-sand p-8 md:p-12 border border-line">
      <div class="max-w-2xl">
        <p class="eyebrow">Other ways we help</p>
        <h2 class="mt-2 text-3xl md:text-4xl">Not sure custom design is what you need?</h2>
      </div>
      <div class="mt-8 grid sm:grid-cols-3 gap-5">
        <a href="/shop/" class="press lift group rounded-3xl bg-card p-6 flex flex-col justify-between">
          <div>
            <h3 class="font-display text-xl font-semibold">3D Print Shop</h3>
            <p class="mt-2 text-sm text-mute">Browse ready-modeled gifts, Kenyan souvenirs, and home décor with instant M-Pesa checkout.</p>
          </div>
          <span class="mt-5 inline-flex items-center gap-1.5 font-bold text-brand text-sm group-hover:underline">Explore the shop →</span>
        </a>
        <a href="/for-business/" class="press lift group rounded-3xl bg-card p-6 flex flex-col justify-between">
          <div>
            <h3 class="font-display text-xl font-semibold">For Business</h3>
            <p class="mt-2 text-sm text-mute">Dimensional reception logos, precision desk nameplates, and volume batch discounts for teams.</p>
          </div>
          <span class="mt-5 inline-flex items-center gap-1.5 font-bold text-brand text-sm group-hover:underline">Business solutions →</span>
        </a>
        <a href="/help/" class="press lift group rounded-3xl bg-card p-6 flex flex-col justify-between">
          <div>
            <h3 class="font-display text-xl font-semibold">Help &amp; FAQs</h3>
            <p class="mt-2 text-sm text-mute">Answers about acceptable CAD files, design billing, delivery across Kenya, and care guidelines.</p>
          </div>
          <span class="mt-5 inline-flex items-center gap-1.5 font-bold text-brand text-sm group-hover:underline">Read the FAQs →</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
