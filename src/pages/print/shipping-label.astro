---
// Printable 4x6 / A6 Shipping Label for PrintHub Africa orders
import { site } from "../../data/site";
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Shipping Label | PrintHub Africa</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" href="/favicon.svg" />
  <style>
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background: #f4ede4;
      color: #111;
      padding: 24px;
      display: flex;
      flex-direction: column;
      align-items: center;
      min-height: 100vh;
    }
    
    /* Top floating action bar (hidden during print) */
    .action-bar {
      width: 100%;
      max-width: 440px;
      margin-bottom: 16px;
      display: flex;
      gap: 12px;
      justify-content: space-between;
    }
    .btn-print {
      flex: 1;
      background: #A6360A;
      color: #fff;
      border: none;
      border-radius: 10px;
      padding: 12px 20px;
      font-size: 15px;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      box-shadow: 0 2px 8px rgba(166, 54, 10, 0.25);
    }
    .btn-print:hover { background: #872b07; }
    .btn-close {
      background: #fff;
      color: #333;
      border: 1px solid #ccc;
      border-radius: 10px;
      padding: 12px 16px;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
    }
    .btn-close:hover { background: #eee; }

    /* Label Container (4in x 6in aspect ratio) */
    .shipping-label {
      width: 100%;
      max-width: 440px;
      background: #fff;
      border: 2px solid #000;
      border-radius: 6px;
      padding: 18px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
      position: relative;
    }

    /* Sender Section */
    .header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      border-bottom: 2px solid #000;
      padding-bottom: 12px;
    }
    .sender-title {
      font-size: 18px;
      font-weight: 900;
      letter-spacing: -0.5px;
      color: #000;
      text-transform: uppercase;
    }
    .sender-sub {
      font-size: 11px;
      color: #333;
      margin-top: 2px;
      line-height: 1.35;
    }
    .courier-badge {
      border: 2px solid #000;
      padding: 4px 8px;
      font-weight: 900;
      font-size: 13px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      text-align: center;
    }

    /* Destination (Large & Bold for Rider/Courier) */
    .ship-to-box {
      border-bottom: 2px solid #000;
      padding: 14px 0;
    }
    .ship-to-label {
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: #444;
      margin-bottom: 4px;
    }
    .recipient-name {
      font-size: 22px;
      font-weight: 900;
      color: #000;
      letter-spacing: -0.3px;
    }
    .recipient-phone {
      font-size: 19px;
      font-weight: 800;
      color: #000;
      margin: 4px 0 8px 0;
      display: inline-block;
      background: #eee;
      padding: 2px 8px;
      border-radius: 4px;
    }
    .recipient-city {
      font-size: 17px;
      font-weight: 800;
      text-transform: uppercase;
      color: #000;
      margin-bottom: 4px;
    }
    .recipient-address {
      font-size: 14px;
      font-weight: 600;
      color: #222;
      line-height: 1.4;
    }
    .recipient-landmark {
      font-size: 12px;
      color: #444;
      margin-top: 4px;
      font-style: italic;
    }

    /* Item Details */
    .item-box {
      border-bottom: 2px solid #000;
      padding: 12px 0;
    }
    .item-row {
      display: flex;
      justify-content: space-between;
      font-size: 13px;
      font-weight: 600;
      margin-bottom: 4px;
    }
    .item-specs {
      font-size: 12px;
      color: #444;
    }
    .item-note {
      font-size: 12px;
      background: #fdf3e7;
      border: 1px dashed #d97736;
      padding: 6px 8px;
      border-radius: 4px;
      margin-top: 6px;
      color: #8c3905;
      font-weight: 600;
    }

    /* Barcode & Reference Section */
    .barcode-section {
      padding: 14px 0 10px 0;
      text-align: center;
      border-bottom: 2px solid #000;
    }
    .barcode-visual {
      font-family: monospace;
      letter-spacing: 4px;
      font-size: 32px;
      font-weight: 900;
      line-height: 1;
      transform: scaleY(1.3);
      display: inline-block;
      margin-bottom: 4px;
    }
    .ref-code {
      font-family: monospace;
      font-size: 15px;
      font-weight: 800;
      letter-spacing: 1px;
    }

    /* Fragile / Handling Warning */
    .fragile-strip {
      padding-top: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      text-align: center;
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.5px;
      text-transform: uppercase;
    }
    .fragile-strip span {
      background: #000;
      color: #fff;
      padding: 2px 6px;
      border-radius: 3px;
    }

    /* Print Styles */
    @media print {
      body {
        background: #fff;
        padding: 0;
        margin: 0;
      }
      .action-bar {
        display: none !important;
      }
      .shipping-label {
        border: 2px solid #000;
        box-shadow: none;
        max-width: 100%;
        width: 100%;
        margin: 0;
        page-break-inside: avoid;
      }
      @page {
        size: 4in 6in;
        margin: 0.15in;
      }
    }
  </style>
</head>
<body>

  <!-- Floating Action Bar -->
  <div class="action-bar">
    <button class="btn-print" onclick="window.print()">
      <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4H7v4a2 2 0 002 2zM9 9h6m-6 4h6m-7-8h8a2 2 0 012 2v2H7V7a2 2 0 012-2z"/></svg>
      Print Label / Save PDF
    </button>
    <button class="btn-close" onclick="window.close()">Close</button>
  </div>

  <!-- Shipping Label Card -->
  <div class="shipping-label" id="label-container">
    
    <!-- 1. Sender Header -->
    <div class="header">
      <div>
        <h1 class="sender-title">PrintHub Africa</h1>
        <p class="sender-sub">
          <strong>Niamade Hub</strong> · Eldoret Studio<br />
          Uasin Gishu County, Kenya<br />
          Tel / WhatsApp: +254 792 732 929
        </p>
      </div>
      <div class="courier-badge" id="badge-delivery-type">
        KENYA COURIER
      </div>
    </div>

    <!-- 2. Ship To Destination -->
    <div class="ship-to-box">
      <div class="ship-to-label">DELIVER TO:</div>
      <div class="recipient-name" id="lbl-name">Customer Name</div>
      <div class="recipient-phone" id="lbl-phone">+254 700 000 000</div>
      <div class="recipient-city" id="lbl-city">NAIROBI</div>
      <div class="recipient-address" id="lbl-address">
        Street address, Estate, Building, Floor
      </div>
      <div class="recipient-landmark" id="lbl-landmark"></div>
    </div>

    <!-- 3. Package & Order Details -->
    <div class="item-box">
      <div class="item-row">
        <span id="lbl-product">3D Printed Piece</span>
        <span id="lbl-qty">QTY: 1</span>
      </div>
      <div class="item-specs" id="lbl-specs">Specs: Standard</div>
      <div class="item-note" id="lbl-custom" style="display: none;"></div>
    </div>

    <!-- 4. Barcode Simulation & Reference -->
    <div class="barcode-section">
      <div class="barcode-visual">||| | |||| || | ||||| ||| | |||</div>
      <div class="ref-code" id="lbl-ref">PH-ORD-00000</div>
    </div>

    <!-- 5. Handling Safety Instructions -->
    <div class="fragile-strip">
      <span>FRAGILE</span>
      <span>3D PRINTED</span>
      <span>KEEP DRY</span>
      <span>DO NOT CRUSH</span>
    </div>

  </div>

  <script>
    // Read parameters from URL or Sanity
    const p = new URLSearchParams(window.location.search);
    const ref = p.get("ref") || "";
    const id = p.get("id") || "";

    // Prefill from URL params if passed directly
    if (p.get("name")) document.getElementById("lbl-name")!.textContent = p.get("name")!;
    if (p.get("phone")) document.getElementById("lbl-phone")!.textContent = p.get("phone")!;
    if (p.get("city")) document.getElementById("lbl-city")!.textContent = p.get("city")!.toUpperCase();
    if (p.get("address")) document.getElementById("lbl-address")!.textContent = p.get("address")!;
    if (p.get("product")) document.getElementById("lbl-product")!.textContent = p.get("product")!;
    if (p.get("qty")) document.getElementById("lbl-qty")!.textContent = `QTY: ${p.get("qty")!}`;
    if (p.get("ref")) document.getElementById("lbl-ref")!.textContent = p.get("ref")!;

    // Fetch order doc from Sanity if ID or REF is given
    async function loadOrderFromSanity() {
      if (!ref && !id) return;
      try {
        const query = encodeURIComponent(`*[_type == "order" && (orderRef == "${ref}" || _id == "${id}" || _id == "order-${id}")][0]`);
        const res = await fetch(`https://m7x6icn3.api.sanity.io/v2023-08-01/data/query/production?query=${query}`);
        if (!res.ok) return;
        const { result } = await res.json();
        if (!result) return;

        if (result.customerName) document.getElementById("lbl-name")!.textContent = result.customerName;
        if (result.customerPhone) document.getElementById("lbl-phone")!.textContent = result.customerPhone;
        if (result.deliveryCity) document.getElementById("lbl-city")!.textContent = result.deliveryCity.toUpperCase();
        if (result.delivery) document.getElementById("lbl-address")!.textContent = result.delivery;
        if (result.productName) document.getElementById("lbl-product")!.textContent = result.productName;
        if (result.quantity) document.getElementById("lbl-qty")!.textContent = `QTY: ${result.quantity}`;
        if (result.orderRef) document.getElementById("lbl-ref")!.textContent = result.orderRef;

        const specs = [
          result.size ? `Size: ${result.size}` : "",
          result.colour ? `Colour: ${result.colour}` : "",
        ].filter(Boolean).join(" · ");
        if (specs) document.getElementById("lbl-specs")!.textContent = `Specs: ${specs}`;

        if (result.customNote) {
          const c = document.getElementById("lbl-custom")!;
          c.textContent = `Customisation Note: "${result.customNote}"`;
          c.style.display = "block";
        }

        if (result.deliveryCity && result.deliveryCity.toLowerCase().includes("pickup")) {
          document.getElementById("badge-delivery-type")!.textContent = "STUDIO PICKUP";
        }
      } catch (err) {
        console.error("Sanity load error:", err);
      }
    }

    loadOrderFromSanity();
  </script>
</body>
</html>
