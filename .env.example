# Sanity Configuration
SANITY_PROJECT_ID=m7x6icn3
SANITY_DATASET=production
SANITY_API_TOKEN=

# Analytics & Monitoring
PUBLIC_CLARITY_PROJECT_ID=ziney1t17t

# Paystack Payment Gateway Configuration
# 1. Public Key (Frontend checkout - starts with pk_live_ or pk_test_)
PUBLIC_PAYSTACK_KEY=pk_live_your_public_key_here

# 2. Secret Key (Backend webhook verification - starts with sk_live_ or sk_test_)
# In Cloudflare Pages, also add this in Pages Dashboard -> Settings -> Environment Variables
PAYSTACK_SECRET_KEY=sk_live_your_secret_key_here

# Email Notifications (Optional - via Resend)
RESEND_API_KEY=
ORDER_NOTIFICATION_EMAIL=booking@printhub.africa
ORDER_FROM_EMAIL="PrintHub Africa <booking@printhub.africa>"
